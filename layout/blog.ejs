<%
const blogPosts = page.posts && page.posts.data ? page.posts.data : [];
const featured = blogPosts[0];
const archivePosts = blogPosts.slice(1);
const articleExcerpt = featured ? strip_html(featured.excerpt || featured.content).replace(/\s+/g, ' ').trim() : '';
const articleTags = featured && featured.tags ? featured.tags.data : [];
%>
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#090312">
  <meta name="description" content="Textos de Sérgio Santos sobre engenharia de software, arquitetura backend e carreira técnica.">
  <title>Blog — Sérgio Santos</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/arcade.css">
</head>
<body class="arcade-page arcade-blog">
  <div class="blog-shell">
    <div class="blog-frame" aria-hidden="true"></div>
    <div class="blog-content">
      <a class="skip-link" href="#main-content">Pular para o conteúdo</a>
      <header class="blog-header">
        <a class="blog-brand" href="/" aria-label="Sérgio Santos — início"><span class="blog-brand-mark" aria-hidden="true"></span><span>Sérgio Santos</span></a>
        <nav class="blog-nav" aria-label="Navegação principal">
          <a href="/">Bio</a><a href="/portfolio/">Currículo</a><a href="/blog/" aria-current="page">Blog</a><a href="/brag/">Brag</a>
        </nav>
      </header>

      <main id="main-content">
        <section class="blog-heading" aria-labelledby="blog-title">
          <h1 id="blog-title">Blog</h1>
          <p>Engenharia de software, arquitetura back-end e carreira técnica — escrito por quem ainda abre o terminal todo dia.</p>
        </section>

        <% if (featured) { %>
        <article class="blog-featured" aria-labelledby="featured-title">
          <div class="blog-article-copy">
            <p class="blog-date"><time datetime="<%= date_xml(featured.date) %>"><%= date(featured.date, 'DD/MM/YYYY') %></time></p>
            <h2 class="blog-article-title" id="featured-title"><%= featured.title %></h2>
            <p class="blog-excerpt"><%= articleExcerpt %></p>
            <% if (articleTags.length) { %>
            <div class="blog-tags" aria-label="Temas do artigo">
              <% articleTags.forEach(function(tag) { %><span><%= tag.name %></span><% }); %>
            </div>
            <% } %>
            <div class="blog-actions"><a class="blog-read-link" href="<%= url_for(featured.path) %>">Ler o artigo <span aria-hidden="true">↗</span></a></div>
          </div>
          <figure class="blog-visual">
            <div class="blog-portrait"><img src="/img/arcade/journal-pose.jpg" alt="Sérgio escrevendo em um diário sob um arco gótico violeta" fetchpriority="high" loading="eager" decoding="async"></div>
            <figcaption><span>Sérgio Santos</span><span>Autor</span></figcaption>
          </figure>
        </article>

        <section class="blog-notes" aria-label="Temas deste blog">
          <div><span>ARQUITETURA</span><strong>Sistemas distribuídos</strong><small>Decisões em produção</small></div>
          <div><span>BACK-END</span><strong>Node.js · Golang</strong><small>Prática e experiência</small></div>
          <div><span>CLOUD</span><strong>AWS</strong><small>Escala com intenção</small></div>
          <div><span>CARREIRA</span><strong>Engenharia técnica</strong><small>Aprender escrevendo</small></div>
        </section>
        <% } else { %>
        <section class="blog-empty"><h2>Ainda não há publicações</h2><p>Novos artigos aparecerão aqui.</p></section>
        <% } %>

        <% if (archivePosts.length) { %>
        <section class="blog-archive" aria-labelledby="archive-title">
          <h2 class="blog-section-title" id="archive-title">Outros artigos</h2>
          <div class="blog-archive-list">
            <% archivePosts.forEach(function(post) { %>
            <article class="blog-archive-item">
              <p class="blog-date"><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'DD/MM/YYYY') %></time></p>
              <div><h3><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3><p><%= strip_html(post.excerpt || post.content).replace(/\s+/g, ' ').trim() %></p></div>
              <% const categories = post.categories && post.categories.data ? post.categories.data : []; if (categories.length) { %><span class="blog-category"><%= categories[0].name %></span><% } %>
            </article>
            <% }); %>
          </div>
        </section>
        <% } %>

        <% if (page.total > 1) { %>
        <nav class="blog-pagination" aria-label="Paginação do blog">
          <%- paginator({ prev_text: '← Recentes', next_text: 'Mais antigos →', escape: false }) %>
        </nav>
        <% } %>

        <section class="blog-about" aria-labelledby="about-blog-title">
          <h2 id="about-blog-title">Sobre este blog</h2>
          <p>Escrevo para documentar o que aprendo construindo sistemas e para manter um registro público do meu progresso. Os textos partem de problemas reais, decisões técnicas e dos <em>trade-offs</em> que fazem parte do trabalho.</p>
        </section>
      </main>

      <footer class="blog-footer"><span>© Sérgio Santos · Brasil</span><nav aria-label="Navegação do rodapé"><a href="/portfolio/">Currículo</a><a href="/blog/" aria-current="page">Blog</a><a href="/brag/">Brag</a></nav></footer>
    </div>
  </div>
  <script>
    const blogHeroImage = document.querySelector('.blog-portrait img');
    if (blogHeroImage && blogHeroImage.dataset.lazySrc) {
      blogHeroImage.src = blogHeroImage.dataset.lazySrc;
      delete blogHeroImage.dataset.lazySrc;
    }
  </script>
</body>
</html>
