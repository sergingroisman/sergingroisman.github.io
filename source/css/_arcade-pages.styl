/* Shared design layer: all page rules are class-scoped to avoid Butterfly leakage. */
.arcade-page *,
.arcade-page *::before,
.arcade-page *::after
  box-sizing: border-box

body.arcade-page
  margin: 0
  position: relative
  isolation: isolate
  min-height: 100vh
  overflow-x: hidden
  background: radial-gradient(ellipse at 76% 8%, rgba(125, 59, 218, .28), transparent 34%), radial-gradient(ellipse at 10% 40%, rgba(243, 52, 116, .11), transparent 38%), linear-gradient(150deg, $void 0%, #140a29 58%, #08040f 100%)
  color: $paper
  font-family: $body
  line-height: 1.65

body.arcade-page::before
  position: fixed
  z-index: -1
  inset: 0
  content: ''
  pointer-events: none
  opacity: .17
  background-image: radial-gradient(rgba(210, 157, 255, .42) .65px, transparent .65px)
  background-size: 4px 4px
  mask-image: linear-gradient(180deg, #000 0, #000 25%, transparent 56%)

.arcade-page .container
  width: unquote('calc(100% - 72px)')
  max-width: $contentMax
  margin-inline: auto
  padding-inline: 0

.arcade-page a
  color: $lavender
  text-decoration-color: rgba(179, 138, 255, .62)
  text-underline-offset: 4px

.arcade-page a:hover
  color: $paper

.arcade-page .topbar
  position: relative
  z-index: 5
  display: flex
  align-items: center
  height: 74px
  width: 100%
  background: rgba(9, 3, 18, .88)
  border-bottom: 1px solid rgba(168, 121, 220, .35)
  backdrop-filter: blur(16px)

.arcade-page .topbar-inner
  display: flex
  align-items: center
  justify-content: space-between
  width: unquote('calc(100% - 72px)')
  max-width: $contentMax
  margin-inline: auto
  padding-inline: 0

.arcade-page .topbar nav
  display: flex
  align-items: center

.arcade-page .topbar-nav
  display: flex
  align-items: center
  gap: 14px
  margin: 0
  padding: 0
  list-style: none

.arcade-page .topbar-nav li
  margin: 0
  padding: 0
  list-style: none

.arcade-page .topbar-nav a
  padding: 9px 8px
  border: 1px solid transparent
  color: $muted
  font-family: $display
  font-size: 15px
  text-decoration: none

.arcade-page .topbar-nav a:hover,
.arcade-page .topbar-nav a:focus-visible
  border-color: $line
  color: $paper
  background: rgba(129, 82, 223, .14)

.arcade-page .topbar-nav a.active
  color: $gold

.arcade-page .topbar-logo
  color: $paper
  font-family: $display
  font-size: 18px
  text-decoration: none

.arcade-page :focus-visible
  outline: 2px solid $gold
  outline-offset: 3px

.skip-link
  position: absolute
  z-index: 20
  top: 8px
  left: 8px
  padding: 8px 12px
  transform: translateY(-150%)
  background: $gold
  color: $ink !important
  font: 600 13px/1.4 $mono

.skip-link:focus
  transform: translateY(0)

.hub-shell,
.blog-shell
  width: 100%
  max-width: 1440px
  min-height: 100vh
  margin: 0 auto
  position: relative
  overflow: clip

.hub-frame,
.blog-frame
  position: absolute
  z-index: 4
  inset: 12px
  border: 1px solid rgba(255, 209, 91, .25)
  pointer-events: none
  clip-path: polygon(0 6px, 6px 6px, 6px 0, calc(100% - 6px) 0, calc(100% - 6px) 6px, 100% 6px, 100% calc(100% - 6px), calc(100% - 6px) calc(100% - 6px), calc(100% - 6px) 100%, 6px 100%, 6px calc(100% - 6px), 0 calc(100% - 6px))

.hub-content,
.blog-content
  width: unquote('calc(100% - 72px)')
  max-width: $contentMax
  margin: 0 auto
  position: relative
  z-index: 1

.hub-header,
.blog-header
  min-height: 76px
  display: flex
  align-items: center
  justify-content: space-between
  gap: 18px
  border-bottom: 1px solid rgba(168, 121, 220, .35)

.hub-brand,
.blog-brand
  display: inline-flex
  align-items: center
  gap: 12px
  color: $paper !important
  font: 600 20px/1.1 $display
  text-decoration: none
  white-space: nowrap

.hub-brand-mark,
.blog-brand-mark
  width: 18px
  height: 18px
  background: $magenta
  clip-path: polygon(0 0, 70% 0, 70% 30%, 100% 30%, 100% 100%, 30% 100%, 30% 70%, 0 70%)

.hub-nav,
.blog-nav
  display: flex
  align-items: center
  gap: 8px

.hub-nav a,
.blog-nav a
  padding: 10px 13px
  border: 1px solid transparent
  color: $muted !important
  font: 600 16px/1.1 $display
  text-decoration: none

.hub-nav a:hover,
.hub-nav a:focus-visible,
.blog-nav a:hover,
.blog-nav a:focus-visible
  border-color: $line
  background: rgba(129, 82, 223, .16)
  color: $paper !important

.hub-nav a[aria-current="page"],
.blog-nav a[aria-current="page"]
  color: $gold !important

.hub-hero
  display: grid
  grid-template-columns: minmax(330px, .82fr) minmax(550px, 1.18fr)
  align-items: center
  gap: 54px
  padding: 54px 0 62px
  border-bottom: 1px solid rgba(168, 121, 220, .32)

.hub-intro
  min-width: 0

.hub-eyebrow
  margin: 0 0 10px
  color: $magenta
  font: 500 13px/1.5 $mono
  letter-spacing: .04em

.hub-intro h1,
.blog-heading h1
  margin: 0 0 15px
  color: $paper
  font: 700 clamp(54px, 7vw, 82px)/.96 $display
  letter-spacing: -.025em

.hub-role
  margin: 0
  color: #e3d5e9
  font-size: clamp(18px, 2.2vw, 22px)
  line-height: 1.45

.hub-role strong
  color: $gold

.hub-employer
  display: flex
  align-items: center
  gap: 10px
  margin: 18px 0 0
  color: $muted
  font: 500 13px/1.5 $mono

.hub-employer span
  width: 8px
  height: 8px
  background: $gold
  box-shadow: 0 0 0 3px rgba(255, 209, 91, .16)

.hub-proof
  max-width: 520px
  margin: 22px 0 0
  padding-top: 18px
  border-top: 1px solid rgba(168, 121, 220, .3)
  color: $muted
  font-size: 14px
  line-height: 1.8

.hub-proof strong
  color: $paper

.hub-facts
  display: grid
  grid-template-columns: repeat(3, minmax(0, 1fr))
  gap: 10px
  margin-top: 20px

.hub-facts p
  margin: 0
  color: $muted
  font: 400 11px/1.6 $mono

.hub-facts strong
  display: block
  margin-bottom: 2px
  color: $gold
  font: 600 15px/1.2 $display

.hub-map
  min-height: 390px
  position: relative
  isolation: isolate
  border: 1px solid rgba(255, 209, 91, .48)
  background: radial-gradient(ellipse at 50% 46%, rgba(112, 52, 198, .22), transparent 62%), linear-gradient(145deg, rgba(30, 13, 56, .96), rgba(10, 5, 20, .98))
  box-shadow: inset 0 0 0 5px rgba(8, 3, 17, .88)

.hub-map::before
  position: absolute
  z-index: -1
  inset: 7px
  content: ''
  pointer-events: none
  opacity: .15
  background: repeating-linear-gradient(0deg, rgba(255, 240, 207, .4) 0 1px, transparent 1px 4px)

.hub-map-grid
  position: absolute
  inset: 25px
  opacity: .5
  background-image: linear-gradient(rgba(150, 104, 209, .2) 1px, transparent 1px), linear-gradient(90deg, rgba(150, 104, 209, .2) 1px, transparent 1px)
  background-size: 24px 24px
  mask-image: radial-gradient(ellipse at center, #000 16%, transparent 85%)

.hub-map-stamp
  position: absolute
  z-index: 2
  top: 16px
  left: 20px
  margin: 0
  color: $muted
  font: 500 11px/1.4 $mono
  letter-spacing: .06em

.hub-map-stamp span
  color: $gold

.hub-routes
  position: absolute
  z-index: 0
  inset: 0
  width: 100%
  height: 100%
  overflow: visible
  pointer-events: none

.hub-routes path
  fill: none
  stroke: #a77be7
  stroke-width: 3
  stroke-linecap: square
  vector-effect: non-scaling-stroke

.hub-routes .route-cv
  stroke: $gold

.hub-routes .route-blog
  stroke: $lavender

.hub-routes .route-brag
  stroke: $magenta

.hub-routes rect
  stroke-width: 0

.route-marker-cv
  fill: $gold

.route-marker-blog
  fill: $lavender

.route-marker-brag
  fill: $magenta

.route-card
  position: absolute
  z-index: 2
  display: block
  width: 204px
  min-height: 82px
  padding: 12px 62px 11px 16px
  border: 1px solid $line
  background: #180d2c
  color: $paper !important
  text-decoration: none
  clip-path: polygon(0 0, calc(100% - 7px) 0, 100% 7px, 100% 100%, 7px 100%, 0 calc(100% - 7px))
  transition: transform 130ms steps(2, end), border-color 130ms steps(2, end), background 130ms steps(2, end)

.route-card::before
  position: absolute
  inset: 0 auto 0 0
  width: 4px
  content: ''
  background: var(--route-color)

.route-card:hover,
.route-card:focus-visible
  transform: translateY(-2px)
  border-color: var(--route-color)
  background: #2a1248
  outline: 2px solid $gold
  outline-offset: 2px

.route-card-cv
  --route-color: $gold
  top: 64px
  left: 36px

.route-card-blog
  --route-color: $lavender
  top: 70px
  right: 26px

.route-card-brag
  --route-color: $magenta
  right: 14px
  bottom: 24px
  width: 200px

.route-title
  display: block
  color: $paper
  font: 600 21px/1.15 $display

.route-description
  display: block
  margin-top: 6px
  color: #e5d7ef
  font-size: 11px
  line-height: 1.4

.route-arrow
  position: absolute
  z-index: 2
  top: 12px
  right: 12px
  color: var(--route-color)
  font: 500 12px/1 $mono

.route-portrait
  position: absolute
  right: 8px
  bottom: 8px
  width: 42px
  height: 52px
  overflow: hidden
  border: 1px solid $gold
  background: $ink
  box-shadow: 0 0 0 2px rgba(243, 52, 116, .24)

.route-portrait img
  width: 100%
  height: 100%
  display: block
  object-fit: cover
  object-position: center 20%
  image-rendering: pixelated

.hub-avatar
  position: absolute
  z-index: 2
  top: 50%
  left: 50%
  width: 188px
  height: 220px
  margin: 0
  padding: 7px
  transform: translate(-50%, -45%)
  border: 2px solid $gold
  background: #11071e
  box-shadow: 8px 8px 0 rgba(0, 0, 0, .5), 0 0 0 5px rgba(243, 52, 116, .3)
  clip-path: polygon(0 8px, 8px 8px, 8px 0, calc(100% - 8px) 0, calc(100% - 8px) 8px, 100% 8px, 100% calc(100% - 8px), calc(100% - 8px) calc(100% - 8px), calc(100% - 8px) 100%, 8px 100%, 8px calc(100% - 8px), 0 calc(100% - 8px))

.hub-avatar::after
  position: absolute
  inset: 7px
  content: ''
  pointer-events: none
  background: repeating-linear-gradient(0deg, rgba(9, 3, 18, .25) 0 1px, transparent 1px 4px)

.hub-avatar img
  display: block
  width: 100%
  height: 100%
  object-fit: cover
  object-position: 48% 30%
  image-rendering: pixelated

.hub-avatar figcaption
  position: absolute
  z-index: 1
  bottom: 10px
  left: 50%
  width: max-content
  padding: 5px 8px
  transform: translateX(-50%)
  border: 1px solid rgba(255, 209, 91, .72)
  background: #160a27
  color: $gold
  font: 500 10px/1.3 $mono

.hub-star
  position: absolute
  z-index: 1
  width: 8px
  height: 8px
  background: $gold
  box-shadow: 0 0 8px rgba(255, 209, 91, .38)

.hub-star-a
  top: 22%
  left: 50%

.hub-star-b
  top: 54%
  right: 24%
  width: 5px
  height: 5px
  background: $magenta

.hub-map-legend
  position: absolute
  right: 14px
  bottom: 9px
  color: $muted
  font: 400 9px/1.4 $mono

.hub-content-section
  padding: 50px 0 30px

.hub-below-grid
  display: grid
  grid-template-columns: minmax(0, 1.1fr) minmax(290px, .9fr)
  gap: 68px
  align-items: start

.hub-section-title
  display: flex
  align-items: baseline
  gap: 14px
  margin: 0 0 22px
  color: $paper
  font: 600 25px/1.2 $display

.hub-section-title span
  height: 1px
  flex: 1
  background: linear-gradient(90deg, $line, transparent)

.hub-bio
  max-width: 660px
  color: $muted
  font-size: 15px
  line-height: 1.8

.hub-bio p
  margin: 0 0 14px

.hub-bio strong
  color: $paper

.hub-stack-title
  margin: 23px 0 10px
  color: $muted
  font: 500 12px/1.4 $mono
  letter-spacing: .05em
  text-transform: uppercase

.hub-stack
  display: flex
  flex-wrap: wrap
  gap: 7px

.hub-stack span,
.hub-post-tags span
  padding: 5px 8px
  border: 1px solid $line
  background: rgba(27, 16, 48, .72)
  color: $paper
  font: 500 11px/1.4 $mono

.hub-stack span:nth-child(-n+4)
  border-color: rgba(255, 209, 91, .5)
  color: $gold

.hub-contact-links
  display: flex
  flex-wrap: wrap
  gap: 10px 18px
  margin-top: 19px

.hub-contact-links a
  color: $lavender
  font-size: 13px
  text-decoration: underline
  text-underline-offset: 4px

.hub-latest
  padding-left: 26px
  border-left: 1px solid rgba(168, 121, 220, .34)

.hub-latest-kicker
  margin: 0
  color: $lavender
  font: 500 11px/1.5 $mono
  letter-spacing: .05em

.hub-post-title
  display: block
  margin-top: 8px
  color: $paper !important
  font: 600 20px/1.3 $display
  text-decoration: none

.hub-post-title:hover
  color: $gold !important

.hub-post-meta
  display: flex
  align-items: center
  gap: 9px
  margin: 9px 0 0
  color: $muted
  font: 400 11px/1.4 $mono

.hub-post-meta > span:first-child
  width: 6px
  height: 6px
  transform: rotate(45deg)
  background: $magenta

.hub-post-excerpt
  margin: 12px 0
  color: $muted
  font-size: 13px
  line-height: 1.7

.hub-post-tags
  display: flex
  flex-wrap: wrap
  gap: 6px

.hub-post-tags span
  padding: 4px 7px
  color: #ddcaff
  font-size: 10px

.hub-more-link
  display: inline-block
  margin-top: 16px
  padding-bottom: 4px
  border-bottom: 1px solid rgba(255, 209, 91, .65)
  color: $gold !important
  font: 600 12px/1.4 $mono
  text-decoration: none

.hub-contact-band
  display: flex
  align-items: center
  justify-content: space-between
  gap: 22px
  margin-top: 38px
  padding: 20px 0
  border-top: 1px solid rgba(168, 121, 220, .3)
  border-bottom: 1px solid rgba(168, 121, 220, .3)

.hub-contact-band p
  margin: 0
  color: $muted
  font-size: 13px
  line-height: 1.65

.hub-contact-band strong
  color: $paper

.hub-contact-band .hub-contact-links
  margin-top: 0

.hub-footer,
.blog-footer
  display: flex
  justify-content: space-between
  align-items: center
  gap: 18px
  padding: 23px 0 30px
  color: $muted
  font: 400 11px/1.5 $mono

.hub-footer nav,
.blog-footer nav
  display: flex
  gap: 10px
  align-items: center

.hub-footer a,
.blog-footer a
  color: $gold
  text-decoration: none

.blog-heading
  display: grid
  grid-template-columns: .8fr 1.2fr
  gap: 48px
  align-items: end
  padding: 50px 0 36px
  border-bottom: 1px solid rgba(168, 121, 220, .34)

.blog-heading h1
  margin-bottom: 0

.blog-heading p
  max-width: 620px
  margin: 0 0 3px
  color: #e3d5e9
  font-size: 18px
  line-height: 1.6

.blog-heading strong
  color: $paper

.blog-featured
  display: grid
  grid-template-columns: minmax(0, 1.45fr) minmax(250px, .55fr)
  align-items: center
  gap: 56px
  padding: 46px 0 50px
  border-bottom: 1px solid rgba(168, 121, 220, .34)

.blog-article-copy
  max-width: 780px

.blog-date
  display: flex
  align-items: center
  gap: 10px
  margin: 0 0 14px
  color: $muted
  font: 500 12px/1.4 $mono

.blog-date::before
  width: 7px
  height: 7px
  transform: rotate(45deg)
  background: $magenta
  content: ''

.blog-article-title
  margin: 0
  color: $paper
  font: 700 clamp(34px, 5vw, 56px)/1.04 $display
  letter-spacing: -.025em

.blog-excerpt
  margin: 17px 0 0
  color: #e5d7ef
  font-size: 16px
  line-height: 1.8

.blog-tags
  display: flex
  flex-wrap: wrap
  gap: 8px
  margin-top: 18px

.blog-tags span
  padding: 5px 8px
  border: 1px solid rgba(179, 138, 255, .42)
  background: $surface
  color: #e3ceff
  font: 500 11px/1.35 $mono

.blog-actions
  margin-top: 23px

.blog-read-link
  display: inline-flex
  align-items: center
  gap: 10px
  padding: 11px 14px
  background: $gold
  color: $ink !important
  font: 600 13px/1.4 $mono
  text-decoration: none
  clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 6px 100%, 0 calc(100% - 6px))

.blog-read-link:hover,
.blog-read-link:focus-visible
  background: $paper
  outline: 2px solid $magenta
  outline-offset: 3px

.blog-read-link span
  font-size: 17px

.blog-visual
  justify-self: end
  width: 100%
  max-width: 310px
  margin: 0

.blog-portrait
  position: relative
  aspect-ratio: 3 / 4
  padding: 7px
  border: 2px solid $gold
  background: #120920
  box-shadow: 8px 8px 0 rgba(148, 24, 91, .42), 0 0 0 5px rgba(81, 39, 127, .35)
  clip-path: polygon(0 8px, 8px 8px, 8px 0, calc(100% - 8px) 0, calc(100% - 8px) 8px, 100% 8px, 100% calc(100% - 8px), calc(100% - 8px) calc(100% - 8px), calc(100% - 8px) 100%, 8px 100%, 8px calc(100% - 8px), 0 calc(100% - 8px))

.blog-portrait img
  display: block
  width: 100%
  height: 100%
  object-fit: cover
  object-position: center 24%
  image-rendering: pixelated

.blog-portrait::after
  position: absolute
  inset: 7px
  content: ''
  pointer-events: none
  background: repeating-linear-gradient(0deg, rgba(9, 3, 18, .28) 0 1px, transparent 1px 4px)

.blog-visual figcaption
  display: flex
  justify-content: space-between
  gap: 12px
  margin-top: 12px
  color: $muted
  font: 500 10px/1.4 $mono

.blog-visual figcaption span:last-child
  color: $gold

.blog-notes
  display: grid
  grid-template-columns: repeat(4, 1fr)
  padding: 20px 0 23px
  border-bottom: 1px solid rgba(168, 121, 220, .34)

.blog-notes > div
  min-height: 65px
  padding: 0 16px
  border-left: 1px solid rgba(168, 121, 220, .32)

.blog-notes > div:first-child
  padding-left: 0
  border-left: 0

.blog-notes span,
.blog-notes small
  display: block
  color: $muted
  font: 500 10px/1.4 $mono

.blog-notes strong
  display: block
  margin: 5px 0 3px
  color: $paper
  font-size: 13px

.blog-notes small
  color: $gold
  font-size: 9px

.blog-archive
  padding: 38px 0 42px
  border-bottom: 1px solid rgba(168, 121, 220, .32)

.blog-section-title
  margin: 0 0 18px
  color: $paper
  font: 600 23px/1.2 $display

.blog-archive-list
  border-top: 1px solid rgba(168, 121, 220, .32)

.blog-archive-item
  display: grid
  grid-template-columns: 120px minmax(0, 1fr) auto
  align-items: baseline
  gap: 18px
  padding: 18px 0
  border-bottom: 1px solid rgba(168, 121, 220, .24)

.blog-archive-item .blog-date
  margin: 0
  font-size: 10px

.blog-archive-item h3
  margin: 0
  color: $paper
  font: 600 17px/1.4 $display

.blog-archive-item h3 a
  color: inherit
  text-decoration: none

.blog-archive-item h3 a:hover
  color: $gold

.blog-archive-item p
  margin: 6px 0 0
  color: $muted
  font-size: 12px
  line-height: 1.65

.blog-category
  color: $lavender
  font: 500 10px/1.4 $mono

.blog-empty
  padding: 34px 0
  color: $muted

.blog-pagination
  display: flex
  justify-content: center
  gap: 8px
  padding: 24px 0
  font: 500 12px/1.4 $mono

.blog-pagination .page-number,
.blog-pagination .extend,
.blog-pagination .space
  padding: 7px 10px
  border: 1px solid $line
  background: $surface
  color: $paper
  text-decoration: none

.blog-pagination .current
  border-color: $gold
  background: $gold
  color: $ink

.blog-about
  display: grid
  grid-template-columns: .65fr 1.35fr
  gap: 40px
  align-items: start
  padding: 38px 0 42px
  border-bottom: 1px solid rgba(168, 121, 220, .32)

.blog-about h2
  margin: 0
  color: $paper
  font: 600 24px/1.25 $display

.blog-about p
  max-width: 760px
  margin: 0
  color: $muted
  font-size: 14px
  line-height: 1.8

.blog-about em
  color: $paper

/* CV page refinements */
.arcade-cv .hero-name
  font-size: clamp(3rem, 5vw, 4rem)
  text-transform: none
  white-space: nowrap

.arcade-cv .container
  width: unquote('calc(100% - 72px)')
  max-width: 1160px

.arcade-cv #hero
  min-height: 0
  padding-top: 90px
  padding-bottom: 36px

.arcade-cv .hero-scroll
  display: none

.arcade-cv .timeline-item
  grid-template-columns: 125px minmax(0, 1fr)
  gap: 0 36px

.arcade-cv .tl-year
  color: $gold
  font-size: 11px

.arcade-cv .tl-desc
  max-width: 720px
  color: $muted
  font-size: 13px

.arcade-cv .tl-tag
