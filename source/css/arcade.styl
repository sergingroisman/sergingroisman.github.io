@import url('https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap')

$void = #090312
$ink = #120920
$inkRaised = #241040
$surface = #1b1030
$line = #654394
$paper = #fff0cf
$muted = #d0bedb
$purple = #8152df
$lavender = #b38aff
$magenta = #f33474
$gold = #ffd15b
$display = 'Pixelify Sans', monospace
$body = Inter, Arial, sans-serif
$mono = 'IBM Plex Mono', monospace
$contentMax = 1240px
$frameInset = 12px
$ease = 160ms ease

:root
  --arcade-void: $void
  --arcade-ink: $ink
  --arcade-ink-raised: $inkRaised
  --arcade-surface: $surface
  --arcade-line: $line
  --arcade-paper: $paper
  --arcade-muted: $muted
  --arcade-purple: $purple
  --arcade-lavender: $lavender
  --arcade-magenta: $magenta
  --arcade-gold: $gold
  --arcade-display: $display
  --arcade-body: $body
  --arcade-mono: $mono
  --arcade-content-max: $contentMax
  --arcade-frame-inset: $frameInset
  --bg: $void
  --bg-up: $ink
  --surface: $surface
  --surface-2: $inkRaised
  --border: $line
  --border-soft: rgba(168, 121, 220, .27)
  --text: $paper
  --text-2: #e5d7ef
  --meta: $muted
  --accent: $gold
  --accent-dim: rgba(129, 82, 223, .17)
  --accent-glow: 0 0 22px rgba(129, 82, 223, .28)
  --font-d: $display
  --font-mono: $mono
  --font-body: $body
  --ease: $ease
  --max-w: $contentMax
  --global-bg: $void
  --font-color: $paper
  --card-bg: $surface

[data-theme='dark']
  --global-bg: $void
  --font-color: $paper
  --card-bg: $surface
  --sidebar-bg: $surface
  --sidebar-menu-bg: $ink
  --search-bg: $ink
  --search-input-color: $paper
  --search-a-color: $paper
  --preloader-bg: $void
  --preloader-color: $paper
  --tab-border-color: $line
  --tab-button-bg: $surface
  --tab-button-color: $muted
  --tab-button-hover-bg: $inkRaised
  --tab-button-active-bg: $ink
  --btn-hover-color: $paper
  --btn-color: $paper
  --btn-bg: $inkRaised
  --text-bg-hover: rgba(129, 82, 223, .17)
  --light-grey: $muted
  --dark-grey: #9f86b4
  --white: $paper
  --text-highlight-color: $paper
  --blockquote-color: $muted
  --blockquote-bg: rgba(129, 82, 223, .14)
  --toc-link-color: $muted
  --scrollbar-color: $purple
  --timeline-bg: $surface
  --zoom-bg: $void
  --hr-border: $line
  --hr-before-color: $gold
  --mark-bg: rgba(243, 52, 116, .2)

html
  scroll-behavior: smooth
  scrollbar-color: $purple $void

:focus-visible
  outline: 2px solid $gold
  outline-offset: 3px

/* Butterfly-only visual overrides; the standalone pages live in _arcade-pages.styl. */
#body-wrap,
#body-wrap #page-header,
#body-wrap #content-inner.layout,
#body-wrap #footer
  background-color: $void
  color: $paper

#body-wrap #page-header
  background-image: radial-gradient(ellipse at 72% 15%, rgba(129, 82, 223, .24), transparent 40%)
  border-bottom: 1px solid rgba(168, 121, 220, .34)

#body-wrap #nav
  background: rgba(9, 3, 18, .92)
  box-shadow: none
  border-bottom: 1px solid rgba(168, 121, 220, .35)
  backdrop-filter: blur(16px)

#body-wrap #nav .site-name,
#body-wrap #nav .site-page,
#body-wrap #page-header .site-title,
#body-wrap #page-header .title-seo
  color: $paper
  font-family: $display

#body-wrap #nav .menus_item a:hover,
#body-wrap #nav .site-page:hover,
#body-wrap #aside-content a:hover
  color: $gold

#body-wrap .layout > div:first-child,
#body-wrap #page,
#body-wrap .page,
#body-wrap .recent-post-item,
#body-wrap #aside-content .card-widget
  border-color: rgba(168, 121, 220, .32)
  background: $surface
  box-shadow: none

#body-wrap .recent-post-item:hover,
#body-wrap #aside-content .card-widget:hover
  border-color: $gold
  box-shadow: 0 0 20px rgba(129, 82, 223, .2)

#body-wrap .article-title,
#body-wrap .article-title a,
#body-wrap #article-container h1,
#body-wrap #article-container h2,
#body-wrap #article-container h3
  color: $paper
  font-family: $display

#body-wrap .article-title a:hover,
#body-wrap .article-meta a:hover,
#body-wrap #article-container a:hover
  color: $gold

#body-wrap .article-meta,
#body-wrap .article-meta time,
#body-wrap .article-meta-wrap,
#body-wrap #aside-content .card-widget,
#body-wrap #footer
  color: $muted
  font-family: $mono

#body-wrap #article-container p,
#body-wrap #article-container li,
#body-wrap .article-entry .content
  color: $paper
  font-family: $body
  line-height: 1.8

#body-wrap #article-container h2
  border-left-color: $magenta

#body-wrap pre,
#body-wrap figure.highlight,
#body-wrap .highlight
  border: 1px solid $line
  background: $ink

#body-wrap code
  border-color: $line
  background: rgba(129, 82, 223, .13)
  color: $gold
  font-family: $mono

#body-wrap #footer
  border-top: 1px solid rgba(168, 121, 220, .3)

#body-wrap #pagination .page-number,
#body-wrap #pagination .extend
  border: 1px solid $line
  background: $surface
  color: $paper

#body-wrap #pagination .current
  border-color: $gold
  background: $gold
  color: $ink

/* Base canvas must also be present in the main Hexo stylesheet. */
body.arcade-page
  margin: 0
  position: relative
  isolation: isolate
  min-height: 100vh
  overflow-x: hidden
  background: radial-gradient(ellipse at 76% 8%, rgba(125, 59, 218, .28), transparent 34%), radial-gradient(ellipse at 10% 40%, rgba(243, 52, 116, .11), transparent 38%), linear-gradient(150deg, $void 0%, #140a29 58%, #08040f 100%)
  color: $paper
  font-family: $body
  line-height: 1.65

body.arcade-page::before
  position: fixed
  z-index: -1
  inset: 0
  content: ''
  pointer-events: none
  opacity: .17
  background-image: radial-gradient(rgba(210, 157, 255, .42) .65px, transparent .65px)
  background-size: 4px 4px
  mask-image: linear-gradient(180deg, #000 0, #000 25%, transparent 56%)

.arcade-page .container
  width: unquote('calc(100% - 72px)')
  max-width: $contentMax
  margin-inline: auto
  padding-inline: 0

.arcade-page .topbar
  position: relative
  z-index: 5
  display: flex
  align-items: center
  height: 74px
  width: 100%
  background: rgba(9, 3, 18, .88)
  border-bottom: 1px solid rgba(168, 121, 220, .35)
  backdrop-filter: blur(16px)

.arcade-page .topbar-inner
  display: flex
  align-items: center
  justify-content: space-between
  width: unquote('calc(100% - 72px)')
  max-width: $contentMax
  margin-inline: auto
  padding-inline: 0

.arcade-page .topbar nav
  display: flex
  align-items: center

.arcade-page .topbar-nav
  display: flex
  align-items: center
  gap: 14px
  margin: 0
  padding: 0
  list-style: none

.arcade-page .topbar-nav li
  margin: 0
  padding: 0
  list-style: none

.arcade-page .topbar-nav a
  padding: 9px 8px
  border: 1px solid transparent
  color: $muted
  font-family: $display
  font-size: 15px
  text-decoration: none

.arcade-page .topbar-nav a:hover,
.arcade-page .topbar-nav a:focus-visible
  border-color: $line
  color: $paper
  background: rgba(129, 82, 223, .14)

.arcade-page .topbar-nav a.active
  color: $gold

.arcade-page .topbar-logo
  flex-shrink: 0
  color: $paper
  font-family: $display
  font-size: 18px
  text-decoration: none
  white-space: nowrap

.arcade-page .section
  border-color: rgba(168, 121, 220, .3)

.print-action
  display: inline-flex
  align-items: center
  min-height: 40px
  margin-top: 22px
  padding: 9px 13px
  border: 1px solid $gold
  background: rgba(129, 82, 223, .14)
  color: $gold
  font: 500 12px/1.3 $mono
  cursor: pointer

.print-action:hover,
.print-action:focus-visible
  background: $gold
  color: $ink

.arcade-brag .impact-table
  min-width: 680px

.arcade-brag .impact-table-scroll
  width: 100%
  max-width: 100%
  overflow-x: auto
  overscroll-behavior-inline: contain

.arcade-brag .hero-title
  margin-bottom: 1rem

.hero-portrait
  position: absolute
  top: 12px
  right: 0
  width: 150px
  height: 168px
  margin: 0
  padding: 6px
  border: 2px solid $gold
  background: $ink
  box-shadow: 6px 6px 0 rgba(148, 24, 91, .42), 0 0 0 4px rgba(81, 39, 127, .3)
  clip-path: polygon(0 7px, 7px 7px, 7px 0, calc(100% - 7px) 0, calc(100% - 7px) 7px, 100% 7px, 100% calc(100% - 7px), calc(100% - 7px) calc(100% - 7px), calc(100% - 7px) 100%, 7px 100%, 7px calc(100% - 7px), 0 calc(100% - 7px))

.hero-portrait img
  display: block
  width: 100%
  height: 100%
  object-fit: cover
  object-position: center 20%
  image-rendering: pixelated

.arcade-cv #hero .hero-inner,
.arcade-brag #hero .hero-inner
  position: relative

.arcade-cv #hero .hero-inner
  padding-right: 190px

.arcade-brag #hero .hero-inner
  padding-right: 138px

.arcade-brag .hero-portrait
  top: 10px
  width: 104px
  height: 116px

@media (max-width: 700px)
  .arcade-cv #hero .hero-inner
    padding-right: 96px
  .arcade-cv .hero-portrait
    top: 0
    width: 82px
    height: 96px
  .arcade-brag #hero .hero-inner
    padding-right: 82px
  .arcade-brag .hero-portrait
    top: 8px
    width: 68px
    height: 82px

@media print
  .arcade-cv .hero-portrait,
  .arcade-brag .hero-portrait
    display: none !important

@media (max-width: 700px)
  .arcade-page .container,
  .arcade-page .topbar-inner
    width: unquote('calc(100% - 36px)')
  .arcade-page .topbar
    height: 66px
  .arcade-page .topbar-nav
    gap: 3px
  .arcade-page .topbar-nav a
    padding: 7px 5px
    font-size: 12px
    white-space: nowrap
  .arcade-brag .impact-table-scroll
    width: 100%
    max-width: 100%
    overflow-x: auto
  .arcade-brag .mentor-card
    grid-template-columns: 1fr

@media (max-width: 420px)
  .arcade-page .topbar-logo
    font-size: 15px
  .arcade-page .topbar-nav
    gap: 0
  .arcade-page .topbar-nav a
    padding-inline: 4px
    font-size: 11px

@import '_arcade-pages'

/* Standalone page overrides must follow shared component rules. */
@media (max-width: 700px)
  .arcade-page .container,
  .arcade-page .topbar-inner
    width: unquote('calc(100% - 36px)')
  .arcade-page .topbar
    height: 66px
  .arcade-page .topbar-nav
    gap: 3px
  .arcade-page .topbar-nav a
    padding: 7px 5px
    font-size: 12px
    white-space: nowrap

@media (max-width: 420px)
  .arcade-page .topbar-logo
    font-size: 15px
  .arcade-page .topbar-nav
    gap: 0
  .arcade-page .topbar-nav a
    padding-inline: 4px
    font-size: 11px
