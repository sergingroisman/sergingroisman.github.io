        "w": 1440,
        "h": 2872
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');\n:root{--void:#000;--ink:#0d2030;--ink2:#211640;--surface:#151515;--line:#415d66;--paper:#ffe9c5;--cream:#e2d7b5;--muted:#71a6a1;--blue:#1880f8;--berry:#cf3c71;--mint:#25e2cd;--pixel:'Pixelify Sans',monospace;--sans:Inter,Arial,sans-serif;--mono:'IBM Plex Mono',monospace}\n.cv-screen{min-height:100vh;margin:0;background:radial-gradient(ellipse at 82% 7%,rgba(2,74,202,.13),transparent 34%),var(--void);color:var(--paper);font:16px/1.65 var(--sans);position:relative;overflow:clip;padding:0 40px}\n.cv-screen:before{content:\"\";position:absolute;inset:0;pointer-events:none;opacity:.12;background-image:radial-gradient(rgba(113,166,161,.4) .6px,transparent .6px);background-size:4px 4px;mask-image:linear-gradient(180deg,#000 0,#000 23%,transparent 52%)}\n.cv-frame{position:absolute;inset:12px;pointer-events:none;border:1px solid rgba(65,93,102,.5);z-index:5;clip-path:polygon(0 6px,6px 6px,6px 0,calc(100% - 6px) 0,calc(100% - 6px) 6px,100% 6px,100% calc(100% - 6px),calc(100% - 6px) calc(100% - 6px),calc(100% - 6px) 100%,6px 100%,6px calc(100% - 6px),0 calc(100% - 6px))}\n.cv-wrap{max-width:1160px;width:100%;margin:0 auto;position:relative;z-index:1}\n.cv-header{height:74px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(65,93,102,.45)}\n.cv-brand{display:flex;align-items:center;gap:13px;color:var(--paper);font:600 20px/1.1 var(--pixel);text-decoration:none}\n.cv-mark{width:19px;height:19px;background:var(--berry);clip-path:polygon(0 0,70% 0,70% 30%,100% 30%,100% 100%,30% 100%,30% 70%,0 70%)}\n.cv-nav{display:flex;gap:8px;align-items:center}.cv-nav a{padding:9px 14px;color:#71a6a1;text-decoration:none;font:600 16px/1.1 var(--pixel);border:1px solid transparent}.cv-nav a[aria-current=page]{color:var(--cream)}.cv-nav a:hover,.cv-nav a:focus-visible{color:var(--paper);border-color:var(--line);background:rgba(24,128,248,.12);outline:2px solid var(--cream);outline-offset:2px}\n.cv-hero{display:grid;grid-template-columns:minmax(0,1fr) 170px;gap:56px;align-items:center;padding:55px 0 26px;border-bottom:1px solid rgba(65,93,102,.45)}\n.cv-kicker{margin:0 0 12px;color:var(--berry);font:500 13px/1.5 var(--mono);letter-spacing:.05em;text-transform:uppercase}\n.cv-title{margin:0;color:var(--paper);font:700 clamp(48px,6vw,70px)/.98 var(--pixel);letter-spacing:-.03em}\n.cv-role{margin:15px 0 0;color:var(--cream);font-size:20px}.cv-role strong{color:var(--paper)}\n.cv-location{margin:7px 0 0;color:var(--muted);font:500 14px/1.5 var(--mono)}\n.cv-portrait-frame{position:relative;width:150px;height:168px;padding:6px;background:#000;border:2px solid var(--line);box-shadow:6px 6px 0 rgba(0,0,0,.65),0 0 0 4px rgba(13,32,48,.85);clip-path:polygon(0 7px,7px 7px,7px 0,calc(100% - 7px) 0,calc(100% - 7px) 7px,100% 7px,100% calc(100% - 7px),calc(100% - 7px) calc(100% - 7px),calc(100% - 7px) 100%,7px 100%,7px calc(100% - 7px),0 calc(100% - 7px))}\n.cv-portrait-frame img{width:100%;height:100%;object-fit:cover;object-position:center 15%;image-rendering:pixelated;display:block}.cv-portrait-frame:after{content:\"\";position:absolute;inset:6px;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,.28) 0 1px,transparent 1px 4px)}\n.cv-facts{display:flex;align-items:baseline;gap:0;flex-wrap:wrap;margin:27px 0 0;padding:18px 0 17px;border-top:1px solid rgba(65,93,102,.5)}\n.cv-fact{padding:0 22px;border-right:1px solid rgba(65,93,102,.55);font:500 13px/1.5 var(--mono);color:var(--muted)}.cv-fact:first-child{padding-left:0}.cv-fact:last-child{border-right:0}.cv-fact strong{color:var(--cream);font:600 22px/1.2 var(--pixel);display:block}\n.cv-contact{display:flex;align-items:center;flex-wrap:wrap;gap:8px 22px;padding:15px 0 19px;border-bottom:1px solid rgba(65,93,102,.4);font:500 13px/1.5 var(--mono);color:var(--muted)}.cv-contact a{color:#5ba8ff;text-decoration:underline;text-decoration-color:rgba(91,168,255,.5);text-underline-offset:4px}.cv-contact a:hover{color:var(--paper)}.cv-contact .lang{color:var(--cream)}\n.cv-section{padding:43px 0;border-bottom:1px solid rgba(65,93,102,.4)}.cv-section-head{display:flex;align-items:baseline;gap:20px;margin:0 0 20px}.cv-section-title{margin:0;white-space:nowrap;color:var(--paper);font:600 27px/1.2 var(--pixel)}.cv-rule{height:1px;flex:1;background:linear-gradient(90deg,var(--line),transparent)}\n.cv-summary{display:grid;grid-template-columns:180px 1fr;gap:30px;align-items:start}.cv-summary-label{color:var(--muted);font:500 13px/1.5 var(--mono);text-transform:uppercase;letter-spacing:.04em}.cv-summary p{margin:0;max-width:870px;color:#d5d6ce;font-size:16px;line-height:1.8}.cv-summary strong{color:var(--paper);font-weight:600}\n.cv-timeline{position:relative}.cv-entry{display:grid;grid-template-columns:175px minmax(0,1fr);gap:26px;padding:24px 0 28px;border-top:1px solid rgba(65,93,102,.4)}.cv-entry:first-child{border-top:0;padding-top:4px}.cv-date{color:var(--muted);font:500 13px/1.6 var(--mono)}.cv-date span{display:block;color:var(--cream);font-size:14px}.cv-entry-body{position:relative;padding-left:22px}.cv-entry-body:before{content:\"\";position:absolute;left:0;top:8px;width:7px;height:7px;background:var(--route,var(--blue));box-shadow:0 0 0 4px rgba(24,128,248,.12)}.cv-company{margin:0;color:var(--paper);font:600 25px/1.2 var(--pixel)}.cv-position{margin:5px 0 13px;color:var(--cream);font-size:15px}.cv-client{color:var(--muted)}.cv-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 28px;margin:0;padding:0;list-style:none}.cv-results li{position:relative;padding-left:16px;color:#c5d0ce;font-size:14px;line-height:1.65}.cv-results li:before{content:\"›\";position:absolute;left:0;color:var(--berry);font:700 19px/1 var(--pixel)}.cv-results strong{color:var(--paper);font-weight:600}\n.cv-skills{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 52px}.cv-skill-group{padding:17px 0 18px;border-top:1px solid rgba(65,93,102,.35)}.cv-skill-group h3{margin:0 0 10px;color:var(--cream);font:500 14px/1.5 var(--mono)}.cv-tags{display:flex;flex-wrap:wrap;gap:7px}.cv-tags span{padding:5px 9px;border:1px solid #415d66;background:rgba(13,32,48,.7);color:#d7dfd7;font:500 12px/1.35 var(--mono)}.cv-tags span:nth-child(3n){border-color:rgba(129,22,70,.6);color:#e2d7b5}\n.cv-lower{display:grid;grid-template-columns:1.35fr .65fr;gap:56px}.cv-cert-list{margin:0;padding:0;list-style:none}.cv-cert-list li{padding:10px 0;border-top:1px solid rgba(65,93,102,.35);color:#c5d0ce;font-size:14px;line-height:1.6}.cv-cert-list li:first-child{border-top:0}.cv-cert-list strong{color:var(--paper);font-weight:600}.cv-language{display:grid;gap:16px}.cv-language-item{padding:0 0 14px;border-bottom:1px solid rgba(65,93,102,.35)}.cv-language-item strong{display:block;color:var(--paper);font:600 18px/1.3 var(--pixel)}.cv-language-item span{color:var(--muted);font:500 13px/1.6 var(--mono)}\n.cv-footer{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:25px 0 34px;color:var(--muted);font:400 12px/1.5 var(--mono)}.cv-footer a{color:var(--cream);text-decoration:none}.cv-footer a:hover{color:var(--paper)}\n@media(max-width:900px){.cv-screen{padding:0 28px}.cv-hero{gap:28px}.cv-entry{grid-template-columns:135px minmax(0,1fr)}.cv-results{grid-template-columns:1fr}.cv-skills{gap:0 30px}}\n@media(max-width:620px){.cv-screen{padding:0 18px}.cv-frame{inset:5px}.cv-header{height:auto;min-height:68px;gap:8px}.cv-brand{font-size:17px;gap:9px}.cv-mark{width:15px;height:15px}.cv-nav{gap:0}.cv-nav a{padding:8px 6px;font-size:13px}.cv-hero{grid-template-columns:1fr;gap:20px;padding:38px 0 18px}.cv-portrait-frame{grid-row:1;width:94px;height:112px;justify-self:start}.cv-title{font-size:48px}.cv-role{font-size:17px}.cv-facts{gap:12px 0;margin-top:20px;padding:14px 0}.cv-fact{padding:0 12px;font-size:11px}.cv-fact:first-child{padding-left:0}.cv-fact strong{font-size:18px}.cv-contact{gap:10px 16px;font-size:12px}.cv-section{padding:31px 0}.cv-section-head{gap:10px;margin-bottom:16px}.cv-section-title{font-size:22px}.cv-summary{grid-template-columns:1fr;gap:8px}.cv-summary p{font-size:15px}.cv-entry{grid-template-columns:1fr;gap:6px;padding:19px 0 22px}.cv-date{order:0;font-size:12px}.cv-entry-body{padding-left:16px}.cv-company{font-size:23px}.cv-results{gap:7px}.cv-results li{font-size:13px}.cv-skills{grid-template-columns:1fr;gap:0}.cv-lower{grid-template-columns:1fr;gap:28px}.cv-footer{align-items:flex-start;flex-direction:column}.cv-footer nav{line-height:1.8}}\n</style>\n<style>\n    :root{--void:#090312;--ink:#120920;--ink2:#241040;--surface:#1b1030;--line:#654394;--paper:#fff0cf;--cream:#ffd15b;--muted:#d0bedb;--blue:#8152df;--berry:#f33474;--mint:#ffd15b}\n.cv-screen{background:radial-gradient(ellipse at 77% 8%,rgba(125,59,218,.34),transparent 35%),radial-gradient(ellipse at 13% 38%,rgba(231,27,104,.12),transparent 35%),linear-gradient(150deg,#090312 0%,#140a29 58%,#08040f 100%)}.cv-screen:before{opacity:.15;background-image:radial-gradient(rgba(210,157,255,.5) .65px,transparent .65px)}.cv-frame{border-color:rgba(255,209,91,.32)}.cv-header,.cv-hero,.cv-section,.cv-entry,.cv-contact,.cv-facts{border-color:rgba(168,121,220,.35)}\n.cv-mark{background:#f33474}.cv-portrait-frame{border-color:#ffd15b;background:#160a28;box-shadow:6px 6px 0 rgba(158,25,91,.8),0 0 0 4px rgba(75,32,119,.58)}.cv-portrait-frame:after{background:repeating-linear-gradient(0deg,rgba(9,3,18,.34) 0 1px,transparent 1px 4px)}\n.cv-results li,.cv-cert-list li,.cv-tags span{color:#eadcf2}.cv-results li:before{color:#f33474}.cv-tags span{border-color:#654394;background:#1b1030}.cv-tags span:nth-child(3n){border-color:rgba(243,52,116,.62);color:#ffd15b}.cv-contact a{color:#c09aff}.cv-entry-body:before{box-shadow:0 0 0 4px rgba(163,101,221,.22)}\n</style>\n<div class=\"cv-screen\" data-kid=\"1\" data-name=\"page layout container\">\n    <div aria-hidden=\"true\" class=\"cv-frame\" data-kid=\"1-1\" data-name=\"decorative frame\">\n    </div>\n    <div class=\"cv-wrap\" data-kid=\"1-2\" data-name=\"page content wrapper\">\n        <header class=\"cv-header\" data-kid=\"1-2-1\" data-name=\"header container\">\n            <a aria-label=\"Sérgio Santos — home\" class=\"cv-brand\" data-kid=\"1-2-1-1\" data-name=\"brand logo and name link\" href=\"https://sergingroisman.github.io/\">\n                <span aria-hidden=\"true\" class=\"cv-mark\" data-kid=\"1-2-1-1-1\" data-name=\"brand mark icon\">\n                </span>\n                <span data-kid=\"1-2-1-1-2\" data-name=\"brand name text\">\n                    Sérgio Santos\n                </span>\n            </a>\n            <nav aria-label=\"Main navigation\" class=\"cv-nav\" data-kid=\"1-2-1-2\" data-name=\"main navigation bar\">\n                <a aria-current=\"page\" data-kid=\"1-2-1-2-1\" data-name=\"navigation link for curriculum\" href=\"https://sergingroisman.github.io/cv/\">\n                    Currículo\n                </a>\n                <a data-kid=\"1-2-1-2-2\" data-name=\"navigation link for blog\" href=\"https://sergingroisman.github.io/blog/\">\n                    Blog\n                </a>\n                <a data-kid=\"1-2-1-2-3\" data-name=\"navigation link for brag\" href=\"https://sergingroisman.github.io/brag/\">\n                    Brag\n                </a>\n            </nav>\n        </header>\n        <main data-kid=\"1-2-2\" data-name=\"main content area\">\n            <section aria-labelledby=\"cv-name\" class=\"cv-hero\" data-kid=\"1-2-2-1\" data-name=\"hero section\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"hero details container\">\n                    <p class=\"cv-kicker\" data-kid=\"1-2-2-1-1-1\" data-name=\"location kicker text\">\n                        Curriculum Vitae · Recife/PE, Brazil\n                    </p>\n                    <h1 class=\"cv-title\" data-kid=\"1-2-2-1-1-2\" data-name=\"main headline\" id=\"cv-name\">\n                        Sérgio Santos\n                    </h1>\n                    <p class=\"cv-role\" data-kid=\"1-2-2-1-1-3\" data-name=\"professional role text\">\n                        <strong data-kid=\"1-2-2-1-1-3-1\" data-name=\"professional role emphasis\">\n                            Senior Back-End Engineer\n                        </strong>\n                        · Avanade\n                    </p>\n                    <p class=\"cv-location\" data-kid=\"1-2-2-1-1-4\" data-name=\"technical focus text\">\n                        Distributed systems · Event-driven architecture · AWS\n                    </p>\n                    <div aria-label=\"Experience highlights\" class=\"cv-facts\" data-kid=\"1-2-2-1-1-5\" data-name=\"experience highlights container\">\n                        <div class=\"cv-fact\" data-kid=\"1-2-2-1-1-5-1\" data-name=\"years of experience stat\">\n                            <strong data-kid=\"1-2-2-1-1-5-1-1\" data-name=\"years of experience value\">\n                                11+ years\n                            </strong>\n                            experience\n                        </div>\n                        <div class=\"cv-fact\" data-kid=\"1-2-2-1-1-5-2\" data-name=\"nodejs years stat\">\n                            <strong data-kid=\"1-2-2-1-1-5-2-1\" data-name=\"nodejs years value\">\n                                10 years\n                            </strong>\n                            Node.js\n                        </div>\n                        <div class=\"cv-fact\" data-kid=\"1-2-2-1-1-5-3\" data-name=\"nestjs years stat\">\n                            <strong data-kid=\"1-2-2-1-1-5-3-1\" data-name=\"nestjs years value\">\n                                7 years\n                            </strong>\n                            NestJS / TypeScript\n                        </div>\n                    </div>\n                </div>\n                <figure class=\"cv-portrait-frame\" data-kid=\"1-2-2-1-2\" data-name=\"portrait image container\">\n                    <img alt=\"Sérgio com óculos transparentes e cavanhaque curto, consultando um fólio dourado sobre um penhasco violeta\" data-kid=\"1-2-2-1-2-1\" data-name=\"portrait image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/47f52d6f-9fa8-4279-9b10-47ca078387b4/7525c1bade9549569a0decd96117fd8b.jpg\"/>\n                </figure>\n            </section>\n            <div aria-label=\"Contact links\" class=\"cv-contact\" data-kid=\"1-2-2-2\" data-name=\"contact information container\">\n                <a data-kid=\"1-2-2-2-1\" data-name=\"email address link\" href=\"mailto:serjota@proton.me\">\n                    serjota@proton.me\n                </a>\n                <span data-kid=\"1-2-2-2-2\" data-name=\"phone number text\">\n                    +55 81 98488-9347\n                </span>\n                <a data-kid=\"1-2-2-2-3\" data-name=\"linkedin link\" href=\"https://linkedin.com/in/sergingroisman\">\n                    LinkedIn\n                </a>\n                <a data-kid=\"1-2-2-2-4\" data-name=\"github link\" href=\"https://github.com/sergingroisman\">\n                    GitHub\n                </a>\n                <span class=\"lang\" data-kid=\"1-2-2-2-5\" data-name=\"language proficiency text\">\n                    English · B2, working toward C1\n                </span>\n            </div>\n            <section aria-labelledby=\"summary-title\" class=\"cv-section cv-summary\" data-kid=\"1-2-2-3\" data-name=\"professional summary section\">\n                <div class=\"cv-summary-label\" data-kid=\"1-2-2-3-1\" data-name=\"summary section label\">\n                    Professional Summary\n                </div>\n                <div data-kid=\"1-2-2-3-2\" data-name=\"summary content container\">\n                    <h2 class=\"cv-section-title\" data-kid=\"1-2-2-3-2-1\" data-name=\"summary section title\" id=\"summary-title\">\n                        Back-end systems built to last\n                    </h2>\n                    <p data-kid=\"1-2-2-3-2-2\" data-name=\"summary description text\">\n                        Senior Back-End Engineer with\n                        <strong data-kid=\"1-2-2-3-2-2-1\" data-name=\"experience emphasis 1\">\n                            11+ years of experience\n                        </strong>\n                        , including\n                        <strong data-kid=\"1-2-2-3-2-2-2\" data-name=\"experience emphasis 2\">\n                            10 years with Node.js/JavaScript\n                        </strong>\n                        and\n                        <strong data-kid=\"1-2-2-3-2-2-3\" data-name=\"experience emphasis 3\">\n                            7 years with NestJS/TypeScript\n                        </strong>\n                        . Specialist in distributed and event-driven architectures on AWS, with a track record of leading zero-downtime migrations, mentoring engineers and delivering high-impact work across EdTech, HealthTech and AdTech.\n                    </p>\n                </div>\n            </section>\n            <section aria-labelledby=\"experience-title\" class=\"cv-section\" data-kid=\"1-2-2-4\" data-name=\"experience section\">\n                <div class=\"cv-section-head\" data-kid=\"1-2-2-4-1\" data-name=\"experience section head\">\n                    <h2 class=\"cv-section-title\" data-kid=\"1-2-2-4-1-1\" data-name=\"experience section title\" id=\"experience-title\">\n                        Experience\n                    </h2>\n                    <span aria-hidden=\"true\" class=\"cv-rule\" data-kid=\"1-2-2-4-1-2\" data-name=\"decorative section rule\">\n                    </span>\n                </div>\n                <div class=\"cv-timeline\" data-kid=\"1-2-2-4-2\" data-name=\"timeline container\">\n                    <article class=\"cv-entry\" data-kid=\"1-2-2-4-2-1\" data-name=\"experience entry\">\n                        <div class=\"cv-date\" data-kid=\"1-2-2-4-2-1-1\" data-name=\"date range and company\">\n                            <span data-kid=\"1-2-2-4-2-1-1-1\" data-name=\"date range text\">\n                                Mar 2021 — Present\n                            </span>\n                            Avanade\n                        </div>\n                        <div class=\"cv-entry-body\" data-kid=\"1-2-2-4-2-1-2\" data-name=\"job details body\" style=\"--route:#1880f8\">\n                            <h3 class=\"cv-company\" data-kid=\"1-2-2-4-2-1-2-1\" data-name=\"company name title\">\n                                Avanade\n                            </h3>\n                            <p class=\"cv-position\" data-kid=\"1-2-2-4-2-1-2-2\" data-name=\"job position title\">\n                                Senior Software Engineer\n                                <span class=\"cv-client\" data-kid=\"1-2-2-4-2-1-2-2-1\" data-name=\"client names text\">\n                                    · Afya · YDUQS\n                                </span>\n                            </p>\n                            <ul class=\"cv-results\" data-kid=\"1-2-2-4-2-1-2-3\" data-name=\"job results list\">\n                                <li data-kid=\"1-2-2-4-2-1-2-3-1\" data-name=\"result item\">\n                                    Led the move from Serverless Framework to\n                                    <strong data-kid=\"1-2-2-4-2-1-2-3-1-1\" data-name=\"result highlight 1\">\n                                        NestJS (Hexagonal + DDD)\n                                    </strong>\n                                    , solving a scalability bottleneck with zero downtime while mentoring the team.\n                                </li>\n                                <li data-kid=\"1-2-2-4-2-1-2-3-2\" data-name=\"result item\">\n                                    Coordinated ElasticBeanstalk →\n                                    <strong data-kid=\"1-2-2-4-2-1-2-3-2-1\" data-name=\"result highlight 2\">\n                                        Kubernetes with ArgoCD and Grafana\n                                    </strong>\n                                    alongside the client’s SRE team.\n                                </li>\n                                <li data-kid=\"1-2-2-4-2-1-2-3-3\" data-name=\"result item\">\n                                    Built the\n                                    <strong data-kid=\"1-2-2-4-2-1-2-3-3-1\" data-name=\"result highlight 3\">\n                                        Keycloak JWT/OAuth2/OIDC\n                                    </strong>\n                                    authentication layer with granular permissions; delivered event-driven messaging with SNS/SQS and RabbitMQ.\n                                </li>\n                                <li data-kid=\"1-2-2-4-2-1-2-3-4\" data-name=\"result item\">\n                                    Created a shared GAM NPM package with\n                                    <strong data-kid=\"1-2-2-4-2-1-2-3-4-1\" data-name=\"result highlight 4\">\n                                        CloudEvents 1.0\n                                    </strong>\n                                    schemas; set up GitHub Actions CI with\n                                    <strong data-kid=\"1-2-2-4-2-1-2-3-4-2\" data-name=\"result highlight 5\">\n                                        1,000+ Jest tests\n                                    </strong>\n                                    .\n                                </li>\n                                <li data-kid=\"1-2-2-4-2-1-2-3-5\" data-name=\"result item\">\n                                    Designed a GPT + LangChain + RAG proof of concept, delivered\n                                    <strong data-kid=\"1-2-2-4-2-1-2-3-5-1\" data-name=\"result highlight 6\">\n                                        one week ahead of schedule\n                                    </strong>\n                                    ; served as interim tech lead for eight months across two workstreams.\n                                </li>\n                            </ul>\n                        </div>\n                    </article>\n                    <article class=\"cv-entry\" data-kid=\"1-2-2-4-2-2\" data-name=\"experience entry\">\n                        <div class=\"cv-date\" data-kid=\"1-2-2-4-2-2-1\" data-name=\"date range and company\">\n                            <span data-kid=\"1-2-2-4-2-2-1-1\" data-name=\"date range text\">\n                                Aug 2019 — Mar 2021\n                            </span>\n                            Avanade\n                        </div>\n                        <div class=\"cv-entry-body\" data-kid=\"1-2-2-4-2-2-2\" data-name=\"job details body\" style=\"--route:#71a6a1\">\n                            <h3 class=\"cv-company\" data-kid=\"1-2-2-4-2-2-2-1\" data-name=\"company name title\">\n                                Avanade\n                            </h3>\n                            <p class=\"cv-position\" data-kid=\"1-2-2-4-2-2-2-2\" data-name=\"job position title\">\n                                Software Engineer\n                                <span class=\"cv-client\" data-kid=\"1-2-2-4-2-2-2-2-1\" data-name=\"client name text\">\n                                    · Afya\n                                </span>\n                            </p>\n                            <ul class=\"cv-results\" data-kid=\"1-2-2-4-2-2-2-3\" data-name=\"job results list\">\n                                <li data-kid=\"1-2-2-4-2-2-2-3-1\" data-name=\"result item\">\n                                    Unblocked the\n                                    <strong data-kid=\"1-2-2-4-2-2-2-3-1-1\" data-name=\"result highlight 1\">\n                                        OneSignal + Next.js\n                                    </strong>\n                                    integration after resolving a server/client WebSocket conflict.\n                                </li>\n                                <li data-kid=\"1-2-2-4-2-2-2-3-2\" data-name=\"result item\">\n                                    Implemented asynchronous messaging with\n                                    <strong data-kid=\"1-2-2-4-2-2-2-3-2-1\" data-name=\"result highlight 2\">\n                                        RabbitMQ + Go\n                                    </strong>\n                                    and built Node.js/TypeScript REST APIs backed by PostgreSQL and MongoDB.\n                                </li>\n                            </ul>\n                        </div>\n                    </article>\n                    <article class=\"cv-entry\" data-kid=\"1-2-2-4-2-3\" data-name=\"experience entry\">\n                        <div class=\"cv-date\" data-kid=\"1-2-2-4-2-3-1\" data-name=\"date range and company\">\n                            <span data-kid=\"1-2-2-4-2-3-1-1\" data-name=\"date range text\">\n                                Jan 2019 — Jul 2019\n                            </span>\n                            Agile Solutions\n                        </div>\n                        <div class=\"cv-entry-body\" data-kid=\"1-2-2-4-2-3-2\" data-name=\"job details body\" style=\"--route:#e2d7b5\">\n                            <h3 class=\"cv-company\" data-kid=\"1-2-2-4-2-3-2-1\" data-name=\"company name title\">\n                                Agile Solutions\n                            </h3>\n                            <p class=\"cv-position\" data-kid=\"1-2-2-4-2-3-2-2\" data-name=\"job position title\">\n                                Junior Software Engineer\n                            </p>\n                            <ul class=\"cv-results\" data-kid=\"1-2-2-4-2-3-2-3\" data-name=\"job results list\">\n                                <li data-kid=\"1-2-2-4-2-3-2-3-1\" data-name=\"result item\">\n                                    Developed enterprise front ends with\n                                    <strong data-kid=\"1-2-2-4-2-3-2-3-1-1\" data-name=\"result highlight 1\">\n                                        Vue.js and SAP UI5\n                                    </strong>\n                                    , using SAP HANA for ERP systems.\n                                </li>\n                            </ul>\n                        </div>\n                    </article>\n                    <article class=\"cv-entry\" data-kid=\"1-2-2-4-2-4\" data-name=\"experience entry\">\n                        <div class=\"cv-date\" data-kid=\"1-2-2-4-2-4-1\" data-name=\"date range and company\">\n                            <span data-kid=\"1-2-2-4-2-4-1-1\" data-name=\"date range text\">\n                                Sep 2016 — Feb 2019\n                            </span>\n                            SENAI ISI\n                        </div>\n                        <div class=\"cv-entry-body\" data-kid=\"1-2-2-4-2-4-2\" data-name=\"job details body\" style=\"--route:#cf3c71\">\n                            <h3 class=\"cv-company\" data-kid=\"1-2-2-4-2-4-2-1\" data-name=\"company name title\">\n                                SENAI ISI\n                            </h3>\n                            <p class=\"cv-position\" data-kid=\"1-2-2-4-2-4-2-2\" data-name=\"job position title\">\n                                Software Engineer\n                            </p>\n                            <ul class=\"cv-results\" data-kid=\"1-2-2-4-2-4-2-3\" data-name=\"job results list\">\n                                <li data-kid=\"1-2-2-4-2-4-2-3-1\" data-name=\"result item\">\n                                    Refactored a GM logistics system in Node.js,\n                                    <strong data-kid=\"1-2-2-4-2-4-2-3-1-1\" data-name=\"result highlight 1\">\n                                        eliminating millions in losses\n                                    </strong>\n                                    .\n                                </li>\n                                <li data-kid=\"1-2-2-4-2-4-2-3-2\" data-name=\"result item\">\n                                    Built an Oculus Rift + Unity3D safety application and delivered six projects across Rails, Node.js, Angular and Java Spring.\n                                </li>\n                            </ul>\n                        </div>\n                    </article>\n                    <article class=\"cv-entry\" data-kid=\"1-2-2-4-2-5\" data-name=\"experience entry\">\n                        <div class=\"cv-date\" data-kid=\"1-2-2-4-2-5-1\" data-name=\"date range and company\">\n                            <span data-kid=\"1-2-2-4-2-5-1-1\" data-name=\"date range text\">\n                                Aug 2015 — May 2016\n                            </span>\n                            ClapMe\n                        </div>\n                        <div class=\"cv-entry-body\" data-kid=\"1-2-2-4-2-5-2\" data-name=\"job details body\" style=\"--route:#823c3d\">\n                            <h3 class=\"cv-company\" data-kid=\"1-2-2-4-2-5-2-1\" data-name=\"company name title\">\n                                ClapMe\n                            </h3>\n                            <p class=\"cv-position\" data-kid=\"1-2-2-4-2-5-2-2\" data-name=\"job position title\">\n                                Back-end Developer\n                            </p>\n                            <ul class=\"cv-results\" data-kid=\"1-2-2-4-2-5-2-3\" data-name=\"job results list\">\n                                <li data-kid=\"1-2-2-4-2-5-2-3-1\" data-name=\"result item\">\n                                    Built the admin back end for a live-streaming platform with\n                                    <strong data-kid=\"1-2-2-4-2-5-2-3-1-1\" data-name=\"result highlight 1\">\n                                        Ruby on Rails, PostgreSQL and IUGU recurring payments\n                                    </strong>\n                                    .\n                                </li>\n                            </ul>\n                        </div>\n                    </article>\n                </div>\n            </section>\n            <section aria-labelledby=\"skills-title\" class=\"cv-section\" data-kid=\"1-2-2-5\" data-name=\"technical skills section\">\n                <div class=\"cv-section-head\" data-kid=\"1-2-2-5-1\" data-name=\"skills section head\">\n                    <h2 class=\"cv-section-title\" data-kid=\"1-2-2-5-1-1\" data-name=\"skills section title\" id=\"skills-title\">\n                        Technical Skills\n                    </h2>\n                    <span aria-hidden=\"true\" class=\"cv-rule\" data-kid=\"1-2-2-5-1-2\" data-name=\"decorative section rule\">\n                    </span>\n                </div>\n                <div class=\"cv-skills\" data-kid=\"1-2-2-5-2\" data-name=\"skills container\">\n                    <div class=\"cv-skill-group\" data-kid=\"1-2-2-5-2-1\" data-name=\"backend skills group\">\n                        <h3 data-kid=\"1-2-2-5-2-1-1\" data-name=\"backend skills title\">\n                            Backend & Data\n                        </h3>\n                        <div class=\"cv-tags\" data-kid=\"1-2-2-5-2-1-2\" data-name=\"backend skills tags container\">\n                            <span data-kid=\"1-2-2-5-2-1-2-1\" data-name=\"tag item\">\n                                Node.js\n                            </span>\n                            <span data-kid=\"1-2-2-5-2-1-2-2\" data-name=\"tag item\">\n                                NestJS\n                            </span>\n                            <span data-kid=\"1-2-2-5-2-1-2-3\" data-name=\"tag item\">\n                                TypeScript\n     