      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');\n:root{--void:#080c1a;--ink:#10172b;--ink-2:#151f37;--surface:#1a2541;--line:#334668;--paper:#f3eddf;--muted:#a7b3c4;--blue:#4778f5;--blue-hi:#76a1ff;--coral:#ff725e;--gold:#ffd166;--mint:#a0efc4;--pixel:'Pixelify Sans',monospace;--sans:Inter,Arial,sans-serif;--mono:'IBM Plex Mono',monospace;--page:1240px}\n*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--void);color:var(--paper);font-family:var(--sans);font-size:16px;line-height:1.65}a{color:inherit}img{display:block;max-width:100%}.frame{position:relative;max-width:1440px;margin:0 auto;min-height:100vh;overflow:clip;background:radial-gradient(ellipse at 70% 12%,rgba(38,76,154,.13),transparent 42%),var(--void)}.frame:before{position:absolute;inset:0;pointer-events:none;content:\"\";opacity:.12;background-image:radial-gradient(rgba(119,148,255,.42) .7px,transparent .7px);background-size:4px 4px;mask-image:linear-gradient(180deg,#000 0,#000 26%,transparent 56%)}.crt-edge{position:absolute;inset:12px;pointer-events:none;border:1px solid rgba(105,146,236,.15);z-index:3;clip-path:polygon(0 6px,6px 6px,6px 0,calc(100% - 6px) 0,calc(100% - 6px) 6px,100% 6px,100% calc(100% - 6px),calc(100% - 6px) calc(100% - 6px),calc(100% - 6px) 100%,6px 100%,6px calc(100% - 6px),0 calc(100% - 6px))}.page{width:min(var(--page),calc(100% - 72px));margin-inline:auto;position:relative;z-index:1}.header{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(122,149,192,.25)}.brand{display:flex;align-items:center;gap:13px;text-decoration:none;color:var(--paper)}.brand-mark{width:20px;height:20px;background:var(--coral);clip-path:polygon(0 0,70% 0,70% 30%,100% 30%,100% 100%,30% 100%,30% 70%,0 70%)}.brand-name{font:600 20px/1.1 var(--pixel);letter-spacing:.015em}.topnav{display:flex;gap:8px;align-items:center}.topnav a{padding:10px 15px;color:var(--muted);text-decoration:none;font:600 16px/1.1 var(--pixel);border:1px solid transparent}.topnav a:hover,.topnav a:focus-visible{color:var(--paper);border-color:var(--line);background:rgba(71,120,245,.12);outline:2px solid var(--gold);outline-offset:2px}.topnav a.is-current{color:var(--gold)}.hero{display:grid;grid-template-columns:minmax(350px,.83fr) minmax(570px,1.17fr);align-items:center;gap:70px;padding:66px 0 74px;border-bottom:1px solid rgba(122,149,192,.23)}.hero-copy{padding-left:8px}.eyebrow{font:500 13px/1.5 var(--mono);letter-spacing:.05em;color:var(--coral)}h1{margin:13px 0 14px;font:700 clamp(54px,7vw,82px)/.95 var(--pixel);letter-spacing:-.03em;color:var(--paper)}.role{max-width:460px;margin:0;font-size:21px;line-height:1.45;color:#d8dfeb}.role strong{color:var(--gold);font-weight:700}.employer{display:flex;align-items:center;gap:10px;margin-top:22px;color:var(--muted);font:500 14px/1.5 var(--mono)}.employer-dot{width:8px;height:8px;background:var(--mint);box-shadow:0 0 0 3px rgba(160,239,196,.12)}.proofline{max-width:470px;margin:26px 0 0;padding-top:20px;border-top:1px solid rgba(122,149,192,.25);font-size:15px;line-height:1.7;color:var(--muted)}.proofline b{color:var(--paper);font-weight:600}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:22px}.fact{font:500 13px/1.55 var(--mono);color:var(--muted)}.fact b{display:block;margin-bottom:2px;color:var(--gold);font:600 16px/1.2 var(--pixel)}.route-map{position:relative;min-height:390px;border:1px solid rgba(111,147,218,.34);background:linear-gradient(145deg,rgba(21,34,62,.92),rgba(12,19,38,.92));box-shadow:inset 0 0 0 5px rgba(8,12,26,.65);isolation:isolate}.route-map:before{content:\"\";position:absolute;inset:7px;pointer-events:none;opacity:.1;background:repeating-linear-gradient(0deg,rgba(238,245,255,.5) 0 1px,transparent 1px 4px);z-index:-1}.route-map:after{position:absolute;content:\"\";inset:0;pointer-events:none;background:linear-gradient(90deg,transparent 0%,rgba(7,12,24,.1) 50%,transparent 100%);z-index:-1}.map-grid{position:absolute;inset:24px 27px 28px;opacity:.45;background-image:linear-gradient(rgba(87,119,181,.18) 1px,transparent 1px),linear-gradient(90deg,rgba(87,119,181,.18) 1px,transparent 1px);background-size:24px 24px;mask-image:radial-gradient(ellipse at center,#000 16%,transparent 85%)}.map-stamp{position:absolute;top:18px;left:22px;color:var(--muted);font:500 12px/1.4 var(--mono);letter-spacing:.07em}.map-stamp span{color:var(--mint)}.routes-svg{position:absolute;inset:0;width:100%;height:100%;z-index:0;overflow:visible}.routes-svg path{fill:none;stroke:#6f91ce;stroke-width:3;stroke-linecap:square;stroke-linejoin:miter;stroke-dasharray:3 0;vector-effect:non-scaling-stroke}.routes-svg .route-cv{stroke:var(--gold)}.routes-svg .route-blog{stroke:var(--blue-hi)}.routes-svg .route-brag{stroke:var(--coral)}.routes-svg rect{stroke-width:0}.route-node{position:absolute;z-index:2;width:200px;min-height:84px;padding:13px 15px 12px 18px;border:1px solid var(--line);background:#121a30;text-decoration:none;clip-path:polygon(0 0,calc(100% - 7px) 0,100% 7px,100% 100%,7px 100%,0 calc(100% - 7px));transition:transform .12s steps(2,end),border-color .12s steps(2,end),background .12s steps(2,end)}.route-node:before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--route)}.route-node:hover,.route-node:focus-visible{transform:translateY(-2px);background:#1a2849;border-color:var(--route);outline:2px solid var(--gold);outline-offset:2px}.route-node--cv{--route:var(--gold);top:65px;left:39px;width:212px}.route-node--blog{--route:var(--blue-hi);top:74px;right:28px;width:205px}.route-node--brag{--route:var(--coral);right:46px;bottom:28px;width:224px}.route-title{display:block;color:var(--paper);font:600 21px/1.1 var(--pixel)}.route-desc{display:block;margin-top:6px;color:#b9c5d6;font-size:12px;line-height:1.4}.route-arrow{position:absolute;top:15px;right:13px;font:500 12px/1 var(--mono);color:var(--route)}.avatar-wrap{position:absolute;z-index:2;left:50%;top:50%;width:190px;height:218px;transform:translate(-50%,-45%);padding:7px;background:#0b1122;border:2px solid #5978b7;box-shadow:8px 8px 0 rgba(0,0,0,.35),0 0 0 5px rgba(7,12,26,.86);clip-path:polygon(0 8px,8px 8px,8px 0,calc(100% - 8px) 0,calc(100% - 8px) 8px,100% 8px,100% calc(100% - 8px),calc(100% - 8px) calc(100% - 8px),calc(100% - 8px) 100%,8px 100%,8px calc(100% - 8px),0 calc(100% - 8px))}.avatar-wrap img{width:100%;height:100%;object-fit:cover;object-position:50% 32%;image-rendering:pixelated}.avatar-caption{position:absolute;bottom:11px;left:50%;transform:translateX(-50%);width:max-content;padding:5px 9px;background:#0a1123;color:var(--mint);font:500 11px/1.2 var(--mono);border:1px solid rgba(160,239,196,.42)}.map-legend{position:absolute;right:15px;bottom:10px;color:#8494b1;font:400 10px/1.4 var(--mono)}.pixel-star{position:absolute;width:9px;height:9px;background:var(--gold);box-shadow:0 0 9px rgba(255,209,102,.45);z-index:1}.star-a{left:50%;top:23%;}.star-b{right:24%;top:53%;width:5px;height:5px;background:var(--coral)}.content{padding:55px 0 70px}.section-title{display:flex;align-items:baseline;gap:15px;margin:0 0 24px;font:600 26px/1.2 var(--pixel);color:var(--paper)}.section-title .line{height:1px;flex:1;background:linear-gradient(90deg,var(--line),transparent)}.below-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(300px,.9fr);gap:74px;align-items:start}.bio{max-width:650px;color:#c2cad8;font-size:16px;line-height:1.8}.bio p{margin:0 0 16px}.bio strong{color:var(--paper);font-weight:600}.stack-title{margin:26px 0 12px;color:var(--muted);font:500 13px/1.4 var(--mono);text-transform:uppercase;letter-spacing:.04em}.stack-list{display:flex;gap:8px;flex-wrap:wrap}.stack-list span{padding:6px 10px;border:1px solid #344461;background:rgba(24,36,65,.62);color:#d7e1f0;font:500 12px/1.3 var(--mono)}.stack-list span:first-child,.stack-list span:nth-child(2),.stack-list span:nth-child(3){border-color:rgba(255,209,102,.58);color:var(--gold)}.contact-list{display:flex;flex-wrap:wrap;gap:10px 18px;margin-top:22px}.contact-list a{color:var(--blue-hi);font-size:14px;text-decoration:underline;text-decoration-color:rgba(118,161,255,.55);text-underline-offset:4px}.contact-list a:hover{color:var(--paper)}.read-panel{padding:0 0 0 28px;border-left:1px solid rgba(122,149,192,.3)}.read-kicker{color:var(--blue-hi);font:500 12px/1.5 var(--mono);letter-spacing:.04em}.post-link{display:block;margin-top:10px;color:var(--paper);font:600 22px/1.3 var(--pixel);text-decoration:none}.post-link:hover{color:var(--gold)}.post-meta{display:flex;align-items:center;gap:9px;margin-top:10px;color:var(--muted);font:400 12px/1.4 var(--mono)}.post-meta .diamond{width:6px;height:6px;background:var(--coral);transform:rotate(45deg)}.post-excerpt{margin:12px 0 14px;color:#bdc8d7;font-size:14px;line-height:1.75}.tag-row{display:flex;gap:7px;flex-wrap:wrap}.tag{padding:4px 8px;border:1px solid rgba(118,161,255,.3);color:#a8c3fa;font:500 11px/1.3 var(--mono)}.more-link{display:inline-flex;margin-top:18px;color:var(--gold);font:600 13px/1.3 var(--mono);text-decoration:none;border-bottom:1px solid rgba(255,209,102,.65);padding-bottom:4px}.more-link:hover{color:#fff0bc}.contact-band{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:22px 0;border-top:1px solid rgba(122,149,192,.24);border-bottom:1px solid rgba(122,149,192,.24);margin-top:50px}.contact-band p{margin:0;color:var(--muted);font-size:14px}.contact-band strong{color:var(--paper)}.contact-email{padding:10px 14px;color:#10172b;background:var(--gold);font:600 15px/1.3 var(--mono);text-decoration:none;clip-path:polygon(0 0,calc(100% - 5px) 0,100% 5px,100% 100%,5px 100%,0 calc(100% - 5px))}.contact-email:hover{background:#ffe19a}.footer{padding:26px 0 34px;display:flex;justify-content:space-between;gap:20px;color:#8594ac;font:400 12px/1.5 var(--mono)}.footer a{color:#a9bce0;text-decoration:none}.footer a:hover{color:var(--paper)}:focus-visible{outline:2px solid var(--gold);outline-offset:3px}@media(max-width:1000px){.hero{grid-template-columns:1fr;gap:40px}.hero-copy{max-width:740px}.route-map{max-width:750px;width:100%;justify-self:center}.below-grid{gap:45px}.route-map{min-height:380px}}@media(max-width:700px){.page{width:calc(100% - 36px)}.header{height:auto;min-height:68px}.brand-name{font-size:18px}.topnav{gap:0}.topnav a{padding:9px 8px;font-size:14px}.hero{padding:42px 0 44px;gap:31px}.hero-copy{padding-left:0}h1{font-size:56px}.role{font-size:18px}.proofline{font-size:14px}.facts{gap:9px}.fact{font-size:11px}.fact b{font-size:14px}.route-map{min-height:0;display:flex;flex-direction:column;gap:9px;padding:62px 14px 16px;background:linear-gradient(145deg,#121d36,#0d152a);box-shadow:inset 0 0 0 4px rgba(8,12,26,.65)}.map-grid,.routes-svg,.pixel-star{display:none}.map-stamp{top:16px;left:18px}.avatar-wrap{position:relative;inset:auto;width:106px;height:124px;transform:none;align-self:center;margin-bottom:3px;padding:4px}.avatar-caption{bottom:7px;font-size:9px}.route-node,.route-node--cv,.route-node--blog,.route-node--brag{position:relative;top:auto;left:auto;right:auto;bottom:auto;width:100%;min-height:66px;padding:10px 13px 10px 16px;display:block}.route-title{font-size:19px}.route-desc{margin-top:3px;max-width:42ch;font-size:12px}.below-grid{grid-template-columns:1fr;gap:34px}.read-panel{padding:24px 0 0;border-left:0;border-top:1px solid rgba(122,149,192,.3)}.content{padding:38px 0 48px}.section-title{font-size:22px}.contact-band{align-items:flex-start;flex-direction:column;margin-top:34px}.footer{flex-direction:column}.crt-edge{inset:5px}.route-map:before{background:repeating-linear-gradient(0deg,rgba(238,245,255,.38) 0 1px,transparent 1px 5px)}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.route-node,.contact-email{transition:none}}\n</style>\n<style>\n    :root{--void:#000000;--