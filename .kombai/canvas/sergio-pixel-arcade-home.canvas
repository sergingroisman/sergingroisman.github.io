      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n:root{--ink:#090e21;--panel:#111a35;--panel-2:#162449;--line:#354b77;--paper:#f7f1e7;--muted:#bbc5db;--blue:#648bff;--coral:#ff775f;--gold:#ffc766;--violet:#a78bfa;--green:#9ee6c5;--pixel:'Pixelify Sans',monospace;--body:'IBM Plex Sans',sans-serif;--mono:'IBM Plex Mono',monospace}\n.arcade-page{background:radial-gradient(ellipse at 85% 8%,#172955 0%,var(--ink) 38%,#080d1a 100%);color:var(--paper);font-family:var(--body);min-height:100vh}\n.arcade-shell{max-width:1216px;margin:auto;padding:0 34px}\n.pixel-font{font-family:var(--pixel)}\n.screen-frame{position:relative;isolation:isolate}\n.screen-frame:after{content:\"\";position:absolute;inset:0;pointer-events:none;z-index:2;background:repeating-linear-gradient(to bottom,rgba(6,10,24,.16) 0,rgba(6,10,24,.16) 1px,transparent 1px,transparent 4px);mix-blend-mode:multiply;opacity:.46}\n.pixel-edge{clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,12px 100%,0 calc(100% - 12px))}\n.console-dots{background-image:radial-gradient(rgba(100,139,255,.15) 1px,transparent 1px);background-size:10px 10px}\n.pixel-focus:focus-visible{outline:3px solid var(--gold);outline-offset:4px}\n@media(max-width:760px){.arcade-shell{padding:0 18px}}\n</style>\n<style>\n    :root{--ink:#090312;--panel:#170d2d;--panel-2:#251044;--line:#65439a;--paper:#fff0cf;--muted:#d5c5df;--blue:#8152df;--coral:#f33474;--gold:#ffd15b;--violet:#a444f1;--green:#ffd15b}\n.arcade-page{position:relative;isolation:isolate;background:radial-gradient(ellipse at 70% 14%,rgba(117,54,218,.36),transparent 36%),radial-gradient(ellipse at 15% 44%,rgba(231,27,104,.13),transparent 36%),linear-gradient(145deg,#090312 0%,#130925 54%,#08040f 100%);color:var(--paper)}\n.arcade-page:before{content:\"\";position:absolute;inset:0;pointer-events:none;z-index:0;opacity:.56;background-image:radial-gradient(rgba(255,209,91,.5) 1px,transparent 1px),radial-gradient(rgba(237,40,119,.32) 1px,transparent 1px);background-size:71px 71px,103px 103px;background-position:14px 27px,46px 9px}\n.arcade-page>*{position:relative;z-index:1}.arcade-page header{background:rgba(9,3,18,.92)!important;border-color:rgba(255,209,91,.28)!important}.arcade-page footer{background:#090312!important;border-color:rgba(157,83,218,.42)!important}\n.arcade-page .screen-frame{background-color:#241044!important}.arcade-page .screen-frame:after{opacity:.48;background:repeating-linear-gradient(to bottom,rgba(13,4,29,.26) 0,rgba(13,4,29,.26) 1px,transparent 1px,transparent 4px)}\n.arcade-page .console-dots{background-image:radial-gradient(rgba(192,132,255,.24) 1px,transparent 1px)}\n.arcade-page [class*=border-\\[\\#354b77\\]]{border-color:var(--line)!important}.arcade-page [class*=bg-\\[\\#0c1530\\]],.arcade-page [class*=bg-\\[\\#0c142a\\]],.arcade-page [class*=bg-\\[\\#111a35\\]]{background-color:var(--panel)!important}\n.arcade-page nav a:hover,.arcade-page a:hover{color:var(--gold)}\n</style>\n<div class=\"arcade-page\" data-kid=\"1\" data-name=\"arcade theme page\">\n    <header class=\"border-b border-[#354b77]/70 bg-[#090e21]/90\" data-kid=\"1-1\" data-name=\"header navigation container\">\n        <div class=\"arcade-shell flex min-h-[68px] items-center justify-between gap-5\" data-kid=\"1-1-1\" data-name=\"header shell layout container\">\n            <a class=\"pixel-font pixel-focus text-[19px] font-bold tracking-wide text-[#f7f1e7] no-underline\" data-kid=\"1-1-1-1\" data-name=\"site logo link\" href=\"/\">\n                SÉRGIO\n                <span class=\"text-[#ff775f]\" data-kid=\"1-1-1-1-1\" data-name=\"logo decoration dot\">\n                    .\n                </span>\n            </a>\n            <nav aria-label=\"Navegação principal\" class=\"flex flex-wrap items-center justify-end gap-x-7 gap-y-2 text-sm font-medium text-[#bbc5db]\" data-kid=\"1-1-1-2\" data-name=\"primary navigation links list\">\n                <a class=\"pixel-font pixel-focus text-[#ffc766] no-underline\" data-kid=\"1-1-1-2-1\" data-name=\"cv page navigation link\" href=\"/cv/\">\n                    Currículo\n                </a>\n                <a class=\"pixel-font pixel-focus hover:text-white no-underline\" data-kid=\"1-1-1-2-2\" data-name=\"blog page navigation link\" href=\"/blog/\">\n                    Blog\n                </a>\n                <a class=\"pixel-font pixel-focus hover:text-white no-underline\" data-kid=\"1-1-1-2-3\" data-name=\"brag page navigation link\" href=\"/brag/\">\n                    Brag\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"hero-name\" class=\"arcade-shell pt-8 md:pt-12\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"relative overflow-hidden border border-[#354b77] bg-[#0c1530] shadow-[0_22px_80px_rgba(0,0,0,.35)]\" data-kid=\"1-2-1-1\" data-name=\"hero content card\">\n                <div class=\"pointer-events-none absolute inset-0 console-dots opacity-40\" data-kid=\"1-2-1-1-1\" data-name=\"decorative background dots\">\n                </div>\n                <div class=\"relative grid md:grid-cols-[minmax(250px,350px)_1fr]\" data-kid=\"1-2-1-1-2\" data-name=\"hero card layout grid\">\n                    <figure class=\"screen-frame relative min-h-[290px] border-b border-[#354b77] bg-[#102758] md:min-h-[402px] md:border-b-0 md:border-r\" data-kid=\"1-2-1-1-2-1\" data-name=\"character portrait frame\">\n                        <div class=\"absolute inset-0 console-dots opacity-50\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"portrait frame decorative dots\">\n                        </div>\n                        <div class=\"absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-[#090e21]/75 to-transparent\" data-kid=\"1-2-1-1-2-1-2\" data-name=\"portrait bottom shadow gradient\">\n                        </div>\n                        <img alt=\"Retrato 16-bit de Sérgio com óculos transparentes, bigode e cavanhaque curto, bochechas sem barba, diante de ruínas violetas\" class=\"absolute inset-0 h-full w-full object-cover object-top [image-rendering:pixelated]\" data-kid=\"1-2-1-1-2-1-3\" data-name=\"character portrait image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/47f52d6f-9fa8-4279-9b10-47ca078387b4/964f021b32a44269afe370e2c6843ab9.jpg\"/>\n                        <span class=\"pixel-font absolute bottom-4 left-5 z-[3] bg-[#090e21]/85 px-3 py-2 text-sm text-[#ffc766]\" data-kid=\"1-2-1-1-2-1-4\" data-name=\"portrait label\">\n                            PERSONAGEM · SÉRGIO\n                        </span>\n                        <span class=\"absolute left-3 top-3 z-[3] h-3 w-3 border-l-2 border-t-2 border-[#ff775f]\" data-kid=\"1-2-1-1-2-1-5\" data-name=\"top-left border corner\">\n                        </span>\n                        <span class=\"absolute right-3 top-3 z-[3] h-3 w-3 border-r-2 border-t-2 border-[#ff775f]\" data-kid=\"1-2-1-1-2-1-6\" data-name=\"top-right border corner\">\n                        </span>\n                        <span class=\"absolute bottom-3 right-3 z-[3] h-3 w-3 border-b-2 border-r-2 border-[#ff775f]\" data-kid=\"1-2-1-1-2-1-7\" data-name=\"bottom-right border corner\">\n                        </span>\n                    </figure>\n                    <div class=\"relative z-[1] flex flex-col justify-center p-6 md:p-10 lg:p-12\" data-kid=\"1-2-1-1-2-2\" data-name=\"hero profile information block\">\n                        <p class=\"mb-2 font-mono text-[13px] font-medium tracking-[.12em] text-[#8ca8ff]\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"location tag text\">\n                            RECIFE / PE · BRASIL\n                        </p>\n                        <h1 class=\"pixel-font mb-3 text-[42px] font-bold leading-[1.02] tracking-tight text-[#f7f1e7] sm:text-[54px] lg:text-[66px]\" data-kid=\"1-2-1-1-2-2-2\" data-name=\"hero headline name\" id=\"hero-name\">\n                            Sérgio\n                            <br class=\"hidden sm:block\" data-kid=\"1-2-1-1-2-2-2-1\" data-name=\"hero name line break\"/>\n                            Santos\n                        </h1>\n                        <p class=\"mb-5 text-lg font-semibold leading-relaxed text-[#e9edfa]\" data-kid=\"1-2-1-1-2-2-3\" data-name=\"hero job role text\">\n                            Senior Analyst · Back-End Development\n                            <span class=\"text-[#ff775f]\" data-kid=\"1-2-1-1-2-2-3-1\" data-name=\"employer highlight tag\">\n                                @ Avanade\n                            </span>\n                        </p>\n                        <p class=\"max-w-[62ch] text-[16px] leading-7 text-[#d4dcee]\" data-kid=\"1-2-1-1-2-2-4\" data-name=\"professional summary paragraph\">\n                            11+ anos construindo sistemas distribuídos e event-driven na AWS.\n                            <strong class=\"font-semibold text-white\" data-kid=\"1-2-1-1-2-2-4-1\" data-name=\"bold summary highlight node-js\">\n                                10 anos de Node.js\n                            </strong>\n                            e\n                            <strong class=\"font-semibold text-white\" data-kid=\"1-2-1-1-2-2-4-2\" data-name=\"bold summary highlight nest-js\">\n                                7 anos de NestJS/TypeScript.\n                            </strong>\n                        </p>\n                        <div class=\"mt-6 flex flex-wrap gap-x-7 gap-y-3 border-t border-[#354b77] pt-4 font-mono text-[13px] text-[#bbc5db]\" data-kid=\"1-2-1-1-2-2-5\" data-name=\"hero contact and language info\">\n                            <span data-kid=\"1-2-1-1-2-2-5-1\" data-name=\"language level indicator\">\n                                <span class=\"text-[#8ca8ff]\" data-kid=\"1-2-1-1-2-2-5-1-1\" data-name=\"language name label\">\n                                    INGLÊS\n                                </span>\n                                B2 · estudando C1\n                            </span>\n                            <a class=\"pixel-focus text-[#ffc766] underline decoration-[#ffc766]/50 underline-offset-4\" data-kid=\"1-2-1-1-2-2-5-2\" data-name=\"email link\" href=\"mailto:serjota@proton.me\">\n                                serjota@proton.me\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <section aria-labelledby=\"destinations-title\" class=\"mt-5 grid gap-0 border border-[#354b77] bg-[#0c142a] md:grid-cols-[210px_1fr]\" data-kid=\"1-2-1-2\" data-name=\"destinations section\">\n                <div class=\"flex items-center border-b border-[#354b77] px-5 py-4 md:border-b-0 md:border-r\" data-kid=\"1-2-1-2-1\" data-name=\"destinations section header\">\n                    <h2 class=\"pixel-font text-[17px] font-bold text-[#f7f1e7]\" data-kid=\"1-2-1-2-1-1\" data-name=\"destinations header title\" id=\"destinations-title\">\n                        DESTINO\n                    </h2>\n                </div>\n                <div class=\"grid sm:grid-cols-3\" data-kid=\"1-2-1-2-2\" data-name=\"destinations links grid\">\n                    <a class=\"pixel-focus group border-b border-[#354b77] bg-[#172752] px-5 py-4 text-[#fff] no-underline transition-colors hover:bg-[#20396d] sm:border-b-0 sm:border-r\" data-kid=\"1-2-1-2-2-1\" data-name=\"cv navigation card link\" href=\"/cv/\">\n                        <span class=\"pixel-font block text-[20px] font-bold text-[#ffc766]\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"cv link title\">\n                            Currículo\n                            <span class=\"text-[#ff775f]\" data-kid=\"1-2-1-2-2-1-1-1\" data-name=\"cv link icon\">\n                                ↗\n                            </span>\n                        </span>\n                        <span class=\"mt-1 block text-[14px] leading-5 text-[#c8d2e8]\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"cv link description\">\n                            Experiência, stack e resultados mensuráveis.\n                        </span>\n                    </a>\n                    <a class=\"pixel-focus group border-b border-[#354b77] px-5 py-4 text-[#fff] no-underline transition-colors hover:bg-[#162449] sm:border-b-0 sm:border-r\" data-kid=\"1-2-1-2-2-2\" data-name=\"blog navigation card link\" href=\"/blog/\">\n                        <span class=\"pixel-font block text-[20px] font-bold text-[#8ca8ff]\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"blog link title\">\n                            Blog\n                            <span class=\"text-[#ff775f]\" data-kid=\"1-2-1-2-2-2-1-1\" data-name=\"blog link icon\">\n                                ↗\n                            </span>\n                        </span>\n                        <span class=\"mt-1 block text-[14px] leading-5 text-[#bbc5db]\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"blog link description\">\n                            Artigos técnicos e aprendizados de produção.\n                        </span>\n                    </a>\n                    <a class=\"pixel-focus group px-5 py-4 text-[#fff] no-underline transition-colors hover:bg-[#162449]\" data-kid=\"1-2-1-2-2-3\" data-name=\"brag navigation card link\" href=\"/brag/\">\n                        <span class=\"pixel-font block text-[20px] font-bold text-[#c2a6ff]\" data-kid=\"1-2-1-2-2-3-1\" data-name=\"brag link title\">\n                            Brag\n                            <span class=\"text-[#ff775f]\" data-kid=\"1-2-1-2-2-3-1-1\" data-name=\"brag link icon\">\n                                ↗\n                            </span>\n                        </span>\n                        <span class=\"mt-1 block text-[14px] leading-5 text-[#bbc5db]\" data-kid=\"1-2-1-2-2-3-2\" data-name=\"brag link description\">\n                            Projetos entregues e impacto documentado.\n                        </span>\n                    </a>\n                </div>\n            </section>\n            <div class=\"grid gap-12 py-14 lg:grid-cols-[1.05fr_.95fr] lg:gap-20\" data-kid=\"1-2-1-3\" data-name=\"details section container\">\n                <section aria-labelledby=\"sobre-title\" data-kid=\"1-2-1-3-1\" data-name=\"about section\">\n                    <h2 class=\"pixel-font mb-4 text-[30px] font-bold text-[#f7f1e7]\" data-kid=\"1-2-1-3-1-1\" data-name=\"about section title\" id=\"sobre-title\">\n                        Sobre\n                    </h2>\n                    <p class=\"max-w-[66ch] text-[16px] leading-7 text-[#d4dcee]\" data-kid=\"1-2-1-3-1-2\" data-name=\"about paragraph one\">\n                        Desenvolvimento back-end em sistemas de escala real: arquitetura distribuída, processamento orientado a eventos e entregas em AWS. Atualmente, atuo em Back-End Development na Avanade, em Recife.\n                    </p>\n                    <p class=\"mt-4 text-[15px] leading-7 text-[#bbc5db]\" data-kid=\"1-2-1-3-1-3\" data-name=\"about paragraph two\">\n                        Experiência que atravessa produto, migrações e infraestrutura; com foco em resolver gargalos e manter sistemas confiáveis em produção.\n                    </p>\n                    <div class=\"mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[13px] text-[#bbc5db]\" data-kid=\"1-2-1-3-1-4\" data-name=\"about metadata footer\">\n                        <span class=\"text-[#ffc766]\" data-kid=\"1-2-1-3-1-4-1\" data-name=\"about location label\">\n                            RECIFE/PE\n                        </span>\n                        <span aria-hidden=\"true\" class=\"text-[#54668b]\" data-kid=\"1-2-1-3-1-4-2\" data-name=\"metadata separator one\">\n                            /\n                        </span>\n                        <span data-kid=\"1-2-1-3-1-4-3\" data-name=\"about company label\">\n                            Avanade\n                        </span>\n                        <span aria-hidden=\"true\" class=\"text-[#54668b]\" data-kid=\"1-2-1-3-1-4-4\" data-name=\"metadata separator two\">\n                            /\n                        </span>\n                        <span data-kid=\"1-2-1-3-1-4-5\" data-name=\"about language level\">\n                            B2 → C1\n                        </span>\n                    </div>\n                </section>\n                <section aria-labelledby=\"stack-title\" data-kid=\"1-2-1-3-2\" data-name=\"stack section\">\n                    <h2 class=\"pixel-font mb-5 text-[30px] font-bold text-[#f7f1e7]\" data-kid=\"1-2-1-3-2-1\" data-name=\"stack section title\" id=\"stack-title\">\n                        Stack principal\n                    </h2>\n                    <div class=\"flex flex-wrap gap-x-5 gap-y-4\" data-kid=\"1-2-1-3-2-2\" data-name=\"stack skill list\">\n                        <span class=\"border-b-2 border-[#648bff] pb-1 text-lg font-semibold text-white\" data-kid=\"1-2-1-3-2-2-1\" data-name=\"node skill tag\">\n                            Node.js\n                        </span>\n                        <span class=\"border-b-2 border-[#ff775f] pb-1 text-lg font-semibold text-white\" data-kid=\"1-2-1-3-2-2-2\" data-name=\"nest skill tag\">\n                            NestJS\n                        </span>\n                        <span class=\"border-b-2 border-[#ffc766] pb-1 text-lg font-semibold text-white\" data-kid=\"1-2-1-3-2-2-3\" data-name=\"typescript skill tag\">\n                            TypeScript\n                        </span>\n                        <span class=\"border-b-2 border-[#a78bfa] pb-1 text-lg font-semibold text-white\" data-kid=\"1-2-1-3-2-2-4\" data-name=\"aws skill tag\">\n                            AWS\n                        </span>\n                        <span class=\"border-b-2 border-[#648bff] pb-1 text-lg font-semibold text-white\" data-kid=\"1-2-1-3-2-2-5\" data-name=\"event-driven skill tag\">\n                            Event-driven\n                        </span>\n                    </div>\n                    <p class=\"mt-5 font-mono text-[13px] leading-6 text-[#bbc5db]\" data-kid=\"1-2-1-3-2-3\" data-name=\"stack experience summary\">\n                        10 anos Node.js · 7 anos NestJS/TypeScript · mais de 11 anos em sistemas distribuídos e AWS\n                    </p>\n                </section>\n            </div>\n            <section aria-labelledby=\"latest-title\" class=\"border-t border-[#354b77] py-9\" data-kid=\"1-2-1-4\" data-name=\"blog teaser section\">\n                <div class=\"flex flex-wrap items-end justify-between gap-4\" data-kid=\"1-2-1-4-1\" data-name=\"blog teaser header\">\n                    <h2 class=\"pixel-font text-[28px] font-bold text-[#f7f1e7]\" data-kid=\"1-2-1-4-1-1\" data-name=\"blog teaser title\" id=\"latest-title\">\n                        Do blog\n                    </h2>\n                    <a class=\"pixel-font pixel-focus text-[15px] text-[#8ca8ff] underline underline-offset-4\" data-kid=\"1-2-1-4-1-2\" data-name=\"view all blog posts link\" href=\"/blog/\">\n                        Todos os artigos ↗\n                    </a>\n                </div>\n                <article class=\"mt-5 border-l-4 border-[#ff775f] bg-[#111a35] px-5 py-4\" data-kid=\"1-2-1-4-2\" data-name=\"blog post article card\">\n                    <div class=\"mb-2 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[13px] text-[#bbc5db]\" data-kid=\"1-2-1-4-2-1\" data-name=\"article metadata\">\n                        <time data-kid=\"1-2-1-4-2-1-1\" data-name=\"article date\" datetime=\"2026-03-28\">\n                            28/03/2026\n                        </time>\n                        <span class=\"text-[#ffc766]\" data-kid=\"1-2-1-4-2-1-2\" data-name=\"article category\">\n                            Carreira\n                        </span>\n                    </div>\n                    <h3 class=\"pixel-font text-[22px] font-semibold leading-snug text-white\" data-kid=\"1-2-1-4-2-2\" data-name=\"article post title\">\n                        <a class=\"pixel-focus text-white no-underline hover:text-[#ffc766]\" data-kid=\"1-2-1-4-2-2-1\" data-name=\"article link\" href=\"/blog/por-que-todo-dev-senior-deveria-ter-um-blog-tecnico/\">\n                            Por que todo dev sênior deveria ter um blog técnico\n                        </a>\n                    </h3>\n                    <p class=\"mt-2 max-w-[72ch] text-[15px] leading-6 text-[#c9d2e4]\" data-kid=\"1-2-1-4-2-3\" data-name=\"article snippet text\">\n                        Depois de quase 7 anos na Avanade construindo sistemas distribuídos, cheguei em uma conclusão: escrever sobre o que você faz é tão importante quanto fazer bem feito.\n                    </p>\n                </article>\n            </section>\n            <section aria-labelledby=\"contact-title\" class=\"grid gap-8 border-t border-[#354b77] py-10 sm:grid-cols-[1fr_auto] sm:items-center\" data-kid=\"1-2-1-5\" data-name=\"contact section\">\n                <div data-kid=\"1-2-1-5-1\" data-name=\"contact header\">\n                    <h2 class=\"pixel-font text-[28px] font-bold text-[#f7f1e7]\" data-kid=\"1-2-1-5-1-1\" data-name=\"contact title\" id=\"contact-title\">\n                        Contato\n                    </h2>\n                    <p class=\"mt-2 text-[15px] text-[#bbc5db]\" data-kid=\"1-2-1-5-1-2\" data-name=\"contact description\">\n                        Inglês B2 · estudando C1  ·  Recife/PE, Brasil\n                    </p>\n                </div>\n                <div class=\"flex flex-wrap gap-4 text-[15px] font-semibold\" data-kid=\"1-2-1-5-2\" data-name=\"social contact links list\">\n                    <a class=\"pixel-focus border border-[#ff775f] px-4 py-3 text-[#ffc766] no-underline hover:bg-[#351f35]\" data-kid=\"1-2-1-5-2-1\" data-name=\"email link button\" href=\"mailto:serjota@proton.me\">\n                        Enviar e-mail ↗\n                    </a>\n                    <a class=\"pixel-focus border border-[#354b77] px-4 py-3 text-[#d9e1f2] no-underline hover:bg-[#162449]\" data-kid=\"1-2-1-5-2-2\" data-name=\"linkedin link button\" href=\"https://linkedin.com/in/sergingroisman\">\n                        LinkedIn ↗\n                    </a>\n                    <a class=\"pixel-focus border border-[#354b77] px-4 py-3 text-[#d9e1f2] no-underline hover:bg-[#162449]\" data-kid=\"1-2-1-5-2-3\" data-name=\"github link button\" href=\"https://github.com/sergingroisman\">\n                        GitHub ↗\n                    </a>\n                </div>\n            </section>\n        </section>\n    </main>\n    <footer class=\"border-t border-[#354b77] bg-[#080c18] py-5\" data-kid=\"1-3\" data-name=\"footer section\">\n        <div class=\"arcade-shell flex flex-wrap items-center justify-between gap-3 font-mono text-[12px] text-[#aab5cc]\" data-kid=\"1-3-1\" data-name=\"footer wrapper\">\n            <span data-kid=\"1-3-1-1\" data-name=\"footer identity text\">\n                Sérgio Santos · Recife/PE, Brasil\n            </span>\n            <span data-kid=\"1-3-1-2\" data-name=\"footer description text\">\n                Uma identidade visual para Bio, Blog, Currículo e Brag\n            </span>\n        </div>\n    </footer>\n</div>\n",
      "comments": [],
