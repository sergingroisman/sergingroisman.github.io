-portrait img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 16%;image-rendering:pixelated}\n.route-portrait:after{position:absolute;inset:0;content:\"\";pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,.34) 0 1px,transparent 1px 3px)}\n.avatar-wrap{background:#000000;border-color:#415d66}\n.avatar-wrap:after{position:absolute;inset:7px;content:\"\";pointer-events:none;z-index:1;background:repeating-linear-gradient(0deg,rgba(0,0,0,.25) 0 1px,transparent 1px 4px)}\n.avatar-caption{z-index:2;background:#000000;color:#25e2cd;border-color:rgba(113,166,161,.6)}\n.route-arrow{color:var(--route)}\n.stack-list span{border-color:#415d66;background:#0d2030;color:#e2d7b5}\n.contact-list a,.tag{color:#1880f8}\n.tag{border-color:rgba(113,166,161,.4)}\n.contact-email{color:#0d2030;background:#e2d7b5}.contact-email:hover{background:#ffe9c5}\n.more-link{color:#ffe9c5;border-color:rgba(226,215,181,.65)}\n@media(max-width:700px){.route-node,.route-node--cv,.route-node--blog,.route-node--brag{min-height:76px;padding-right:62px}.route-portrait{right:8px;bottom:9px;width:38px;height:50px}.avatar-wrap:after{inset:4px}}\n</style>\n<style>\n    :root{--void:#090312;--ink:#120920;--ink-2:#21103d;--surface:#1b1030;--line:#62418e;--paper:#fff0cf;--muted:#cbb9dc;--blue:#8152df;--blue-hi:#b38aff;--coral:#f33474;--gold:#ffd15b;--mint:#ffd15b}\n.frame{background:radial-gradient(ellipse at 68% 11%,rgba(125,61,217,.37),transparent 38%),radial-gradient(ellipse at 13% 42%,rgba(232,27,106,.15),transparent 37%),linear-gradient(145deg,#090312 0%,#150a29 57%,#08040f 100%)}\n.frame:before{opacity:.19;background-image:radial-gradient(rgba(204,150,255,.56) .7px,transparent .7px)}.crt-edge{border-color:rgba(255,209,91,.31)}\n.header,.hero,.proofline,.read-panel,.contact-band{border-color:rgba(173,130,224,.35)}.route-map{border-color:rgba(255,209,91,.52);background:radial-gradient(ellipse at 50% 46%,rgba(112,52,198,.22),transparent 62%),linear-gradient(145deg,rgba(30,13,56,.96),rgba(10,5,20,.97));box-shadow:inset 0 0 0 5px rgba(8,3,17,.9)}\n.map-grid{background-image:linear-gradient(rgba(150,104,209,.21) 1px,transparent 1px),linear-gradient(90deg,rgba(150,104,209,.21) 1px,transparent 1px)}.routes-svg path{stroke:#a77be7}.routes-svg .route-cv{stroke:#ffd15b}.routes-svg .route-blog{stroke:#a975ff}.routes-svg .route-brag{stroke:#f33474}\n.route-node{background:#180d2c;border-color:#684696}.route-node:hover,.route-node:focus-visible{background:#2a1248;border-color:var(--route)}.route-desc{color:#f0e2ce}.route-portrait,.avatar-wrap{border-color:#ffd15b;background:#11071e;box-shadow:0 0 0 2px rgba(243,52,116,.36),0 8px 22px rgba(0,0,0,.6)}.route-portrait:after,.avatar-wrap:after{background:repeating-linear-gradient(0deg,rgba(9,3,18,.34) 0 1px,transparent 1px 4px)}\n.avatar-caption{background:#160a27;color:#ffd15b;border-color:rgba(255,209,91,.72)}.stack-list span{border-color:#62418e;background:#1a0e31;color:#fff0cf}.stack-list span:first-child,.stack-list span:nth-child(2),.stack-list span:nth-child(3){border-color:rgba(255,209,91,.66);color:#ffd15b}\n.contact-email{color:#160b25;background:#ffd15b}.contact-email:hover{background:#fff0cf}.tag{color:#d4bcff;border-color:rgba(179,138,255,.5)}.contact-list a{color:#c5a4ff}.read-kicker{color:#cf9cff}.employer-dot{background:#ffd15b;box-shadow:0 0 0 3px rgba(255,209,91,.18)}\n</style>\n<div class=\"frame\" data-kid=\"1\" data-name=\"page layout container\">\n    <div aria-hidden=\"true\" class=\"crt-edge\" data-kid=\"1-1\" data-name=\"decorative CRT screen edge\">\n    </div>\n    <div class=\"page\" data-kid=\"1-2\" data-name=\"centered page container\">\n        <header class=\"header\" data-kid=\"1-2-1\" data-name=\"header section\">\n            <a aria-label=\"Sérgio Santos — início\" class=\"brand\" data-kid=\"1-2-1-1\" data-name=\"brand logo link\" href=\"https://sergingroisman.github.io/\">\n                <span aria-hidden=\"true\" class=\"brand-mark\" data-kid=\"1-2-1-1-1\" data-name=\"brand mark icon\">\n                </span>\n                <span class=\"brand-name\" data-kid=\"1-2-1-1-2\" data-name=\"brand name text\">\n                    Sérgio Santos\n                </span>\n            </a>\n            <nav aria-label=\"Navegação principal\" class=\"topnav\" data-kid=\"1-2-1-2\" data-name=\"top navigation menu\">\n                <a class=\"is-current\" data-kid=\"1-2-1-2-1\" data-name=\"currículo link\" href=\"https://sergingroisman.github.io/cv/\">\n                    Currículo\n                </a>\n                <a data-kid=\"1-2-1-2-2\" data-name=\"blog link\" href=\"https://sergingroisman.github.io/blog/\">\n                    Blog\n                </a>\n                <a data-kid=\"1-2-1-2-3\" data-name=\"brag link\" href=\"https://sergingroisman.github.io/brag/\">\n                    Brag\n                </a>\n            </nav>\n        </header>\n        <main data-kid=\"1-2-2\" data-name=\"main content area\">\n            <section aria-labelledby=\"profile-title\" class=\"hero\" data-kid=\"1-2-2-1\" data-name=\"hero section\">\n                <div class=\"hero-copy\" data-kid=\"1-2-2-1-1\" data-name=\"hero copy container\">\n                    <p class=\"eyebrow\" data-kid=\"1-2-2-1-1-1\" data-name=\"hero eyebrow text\">\n                        Senior Analyst · Recife/PE, Brasil\n                    </p>\n                    <h1 data-kid=\"1-2-2-1-1-2\" data-name=\"hero headline text\" id=\"profile-title\">\n                        Sérgio\n                        <br data-kid=\"1-2-2-1-1-2-1\" data-name=\"line break\"/>\n                        Santos\n                    </h1>\n                    <p class=\"role\" data-kid=\"1-2-2-1-1-3\" data-name=\"hero role description\">\n                        Back-End Development\n                        <br data-kid=\"1-2-2-1-1-3-1\" data-name=\"line break\"/>\n                        <strong data-kid=\"1-2-2-1-1-3-2\" data-name=\"employer company name\">\n                            Avanade\n                        </strong>\n                    </p>\n                    <div class=\"employer\" data-kid=\"1-2-2-1-1-4\" data-name=\"employer tag container\">\n                        <span aria-hidden=\"true\" class=\"employer-dot\" data-kid=\"1-2-2-1-1-4-1\" data-name=\"employer status dot\">\n                        </span>\n                        <span data-kid=\"1-2-2-1-1-4-2\" data-name=\"employer skills text\">\n                            Engenharia de software · AWS · sistemas distribuídos\n                        </span>\n                    </div>\n                    <p class=\"proofline\" data-kid=\"1-2-2-1-1-5\" data-name=\"proofline text\">\n                        <b data-kid=\"1-2-2-1-1-5-1\" data-name=\"years of experience count\">\n                            11+ anos\n                        </b>\n                        construindo sistemas distribuídos e event-driven na AWS.\n                        <b data-kid=\"1-2-2-1-1-5-2\" data-name=\"node.js years count\">\n                            10 anos\n                        </b>\n                        de Node.js,\n                        <b data-kid=\"1-2-2-1-1-5-3\" data-name=\"nestjs years count\">\n                            7 anos\n                        </b>\n                        de NestJS e TypeScript.\n                    </p>\n                    <div class=\"facts\" data-kid=\"1-2-2-1-1-6\" data-name=\"facts grid container\">\n                        <div class=\"fact\" data-kid=\"1-2-2-1-1-6-1\" data-name=\"location fact card\">\n                            <b data-kid=\"1-2-2-1-1-6-1-1\" data-name=\"location label\">\n                                LOCAL\n                            </b>\n                            Recife/PE, Brasil\n                        </div>\n                        <div class=\"fact\" data-kid=\"1-2-2-1-1-6-2\" data-name=\"language fact card\">\n                            <b data-kid=\"1-2-2-1-1-6-2-1\" data-name=\"language label\">\n                                INGLÊS\n                            </b>\n                            B2 · estudando C1\n                        </div>\n                        <div class=\"fact\" data-kid=\"1-2-2-1-1-6-3\" data-name=\"focus fact card\">\n                            <b data-kid=\"1-2-2-1-1-6-3-1\" data-name=\"focus label\">\n                                FOCO\n                            </b>\n                            Back-end · Cloud\n                        </div>\n                    </div>\n                </div>\n                <div aria-label=\"Mapa com atalhos para currículo, blog e Brag\" class=\"route-map\" data-kid=\"1-2-2-1-2\" data-name=\"interactive route map\" role=\"group\">\n                    <div aria-hidden=\"true\" class=\"map-grid\" data-kid=\"1-2-2-1-2-1\" data-name=\"map grid background\">\n                    </div>\n                    <div class=\"map-stamp\" data-kid=\"1-2-2-1-2-2\" data-name=\"map stamp status\">\n                        NAVEGAÇÃO\n                        <span data-kid=\"1-2-2-1-2-2-1\" data-name=\"map status indicator text\">\n                            3 DESTINOS\n                        </span>\n                    </div>\n                    <svg aria-hidden=\"true\" class=\"routes-svg\" data-kid=\"1-2-2-1-2-3\" data-name=\"routes SVG illustration\" preserveaspectratio=\"none\" viewbox=\"0 0 680 390\">\n                        <path class=\"route-cv\" d=\"M342 193 H261 V111 H223\">\n                        </path>\n                        <path class=\"route-blog\" d=\"M352 193 H427 V116 H466\">\n                        </path>\n                        <path class=\"route-brag\" d=\"M353 203 H429 V316 H445\">\n                        </path>\n                        <rect fill=\"#ffd166\" height=\"10\" width=\"10\" x=\"251\" y=\"101\">\n                        </rect>\n                        <rect fill=\"#76a1ff\" height=\"10\" width=\"10\" x=\"420\" y=\"106\">\n                        </rect>\n                        <rect fill=\"#ff725e\" height=\"10\" width=\"10\" x=\"422\" y=\"306\">\n                        </rect>\n                    </svg>\n                    <span aria-hidden=\"true\" class=\"pixel-star star-a\" data-kid=\"1-2-2-1-2-4\" data-name=\"decorative star\">\n                    </span>\n                    <span aria-hidden=\"true\" class=\"pixel-star star-b\" data-kid=\"1-2-2-1-2-5\" data-name=\"decorative star\">\n                    </span>\n                    <a class=\"route-node route-node--cv\" data-kid=\"1-2-2-1-2-6\" data-name=\"cv route node\" href=\"https://sergingroisman.github.io/cv/\">\n                        <span aria-hidden=\"true\" class=\"route-portrait\" data-kid=\"1-2-2-1-2-6-4\" data-name=\"currículo character pose\">\n                            <img alt=\"Sérgio com óculos e cavanhaque, consultando um fólio dourado nas montanhas violetas\" data-kid=\"1-2-2-1-2-6-4-1\" data-name=\"currículo character pose image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/47f52d6f-9fa8-4279-9b10-47ca078387b4/7525c1bade9549569a0decd96117fd8b.jpg\"/>\n                        </span>\n                        <span aria-hidden=\"true\" class=\"route-arrow\" data-kid=\"1-2-2-1-2-6-1\" data-name=\"route arrow icon\">\n                            ↗\n                        </span>\n                        <span class=\"route-title\" data-kid=\"1-2-2-1-2-6-2\" data-name=\"route title text\">\n                            Currículo\n                        </span>\n                        <span class=\"route-desc\" data-kid=\"1-2-2-1-2-6-3\" data-name=\"route description text\">\n                            Experiência, stack, certificações e resultados.\n                        </span>\n                    </a>\n                    <a class=\"route-node route-node--blog\" data-kid=\"1-2-2-1-2-7\" data-name=\"blog route node\" href=\"https://sergingroisman.github.io/blog/\">\n                        <span aria-hidden=\"true\" class=\"route-portrait\" data-kid=\"1-2-2-1-2-7-4\" data-name=\"blog character pose\">\n                            <img alt=\"Sérgio escrevendo um diário sob um arco gótico violeta, com óculos e cavanhaque\" data-kid=\"1-2-2-1-2-7-4-1\" data-name=\"blog character pose image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/47f52d6f-9fa8-4279-9b10-47ca078387b4/6f2cdd85bbc743ecb08ff0e275f314d1.jpg\"/>\n                        </span>\n                        <span aria-hidden=\"true\" class=\"route-arrow\" data-kid=\"1-2-2-1-2-7-1\" data-name=\"route arrow icon\">\n                            ↗\n                        </span>\n                        <span class=\"route-title\" data-kid=\"1-2-2-1-2-7-2\" data-name=\"route title text\">\n                            Blog\n                        </span>\n                        <span class=\"route-desc\" data-kid=\"1-2-2-1-2-7-3\" data-name=\"route description text\">\n                            Textos técnicos sobre engenharia e IA aplicada.\n                        </span>\n                    </a>\n                    <a class=\"route-node route-node--brag\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-8\" data-name=\"brag route node\" data-reason=\"style attribute added or modified\" href=\"https://sergingroisman.github.io/brag/\" style=\"right:12px;bottom:0\">\n                        <span aria-hidden=\"true\" class=\"route-portrait\" data-kid=\"1-2-2-1-2-8-4\" data-name=\"brag character pose\">\n                            <img alt=\"Sérgio apresentando um esquema dourado em ruínas violetas, com óculos e cavanhaque\" data-kid=\"1-2-2-1-2-8-4-1\" data-name=\"brag character pose image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/47f52d6f-9fa8-4279-9b10-47ca078387b4/151ce17827954aeb8f4843b8cac305d3.jpg\"/>\n                        </span>\n                        <span aria-hidden=\"true\" class=\"route-arrow\" data-kid=\"1-2-2-1-2-8-1\" data-name=\"route arrow icon\">\n                            ↗\n                        </span>\n                        <span class=\"route-title\" data-kid=\"1-2-2-1-2-8-2\" data-name=\"route title text\">\n                            Brag\n                        </span>\n                        <span class=\"route-desc\" data-kid=\"1-2-2-1-2-8-3\" data-name=\"route description text\">\n                            Entregas, decisões e impacto técnico documentado.\n                        </span>\n                    </a>\n                    <div class=\"avatar-wrap\" data-kid=\"1-2-2-1-2-9\" data-name=\"avatar profile container\">\n                        <img alt=\"Retrato 16-bit de Sérgio com óculos transparentes, bigode e cavanhaque curto, bochechas sem barba, diante de ruínas violetas\" data-kid=\"1-2-2-1-2-9-1\" data-name=\"avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/47f52d6f-9fa8-4279-9b10-47ca078387b4/964f021b32a44269afe370e2c6843ab9.jpg\"/>\n                        <span class=\"avatar-caption\" data-kid=\"1-2-2-1-2-9-2\" data-name=\"avatar caption\">\n                            SÉRGIO · PERFIL\n                        </span>\n                    </div>\n                    <span class=\"map-legend\" data-kid=\"1-2-2-1-2-10\" data-name=\"map legend label\">\n                        MAPA DE NAVEGAÇÃO · 3 DESTINOS\n                    </span>\n                </div>\n            </section>\n            <section aria-label=\"Sobre e publicações\" class=\"content\" data-kid=\"1-2-2-2\" data-name=\"about and publications section\">\n                <div class=\"below-grid\" data-kid=\"1-2-2-2-1\" data-name=\"bio and blog grid\">\n                    <section data-kid=\"1-2-2-2-1-1\" data-name=\"about section\">\n                        <h2 class=\"section-title\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"about section title\">\n                            Sobre\n                            <span aria-hidden=\"true\" class=\"line\" data-kid=\"1-2-2-2-1-1-1-1\" data-name=\"section title decorative line\">\n                            </span>\n                        </h2>\n                        <div class=\"bio\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"bio text container\">\n                            <p data-kid=\"1-2-2-2-1-1-2-1\" data-name=\"bio paragraph\">\n                                Sou\n                                <strong data-kid=\"1-2-2-2-1-1-2-1-1\" data-name=\"job role emphasis\">\n                                    Senior Analyst de Back-End Development na Avanade\n                                </strong>\n                                , em Recife/PE. Há mais de 11 anos construo sistemas distribuídos e event-driven na AWS.\n                            </p>\n                            <p data-kid=\"1-2-2-2-1-1-2-2\" data-name=\"bio paragraph\">\n                                Trabalho com\n                                <strong data-kid=\"1-2-2-2-1-1-2-2-1\" data-name=\"years of experience emphasis\">\n                                    Node.js há 10 anos\n                                </strong>\n                                e com NestJS e TypeScript há 7. No inglês, estou no nível B2 e estudando para o C1.\n                            </p>\n                        </div>\n                        <h3 class=\"stack-title\" data-kid=\"1-2-2-2-1-1-3\" data-name=\"stack list title\">\n                            Stack principal\n                        </h3>\n                        <div aria-label=\"Tecnologias da stack principal\" class=\"stack-list\" data-kid=\"1-2-2-2-1-1-4\" data-name=\"stack technologies list\">\n                            <span data-kid=\"1-2-2-2-1-1-4-1\" data-name=\"node.js tag\">\n                                Node.js\n                            </span>\n                            <span data-kid=\"1-2-2-2-1-1-4-2\" data-name=\"nestjs tag\">\n                                NestJS\n                            </span>\n                            <span data-kid=\"1-2-2-2-1-1-4-3\" data-name=\"typescript tag\">\n                                TypeScript\n                            </span>\n                            <span data-kid=\"1-2-2-2-1-1-4-4\" data-name=\"aws tag\">\n                                AWS\n                            </span>\n                            <span data-kid=\"1-2-2-2-1-1-4-5\" data-name=\"postgresql tag\">\n                                PostgreSQL\n                            </span>\n                            <span data-kid=\"1-2-2-2-1-1-4-6\" data-name=\"mongodb tag\">\n                                MongoDB\n                            </span>\n                            <span data-kid=\"1-2-2-2-1-1-4-7\" data-name=\"redis tag\">\n                                Redis\n                            </span>\n                            <span data-kid=\"1-2-2-2-1-1-4-8\" data-name=\"rabbitmq tag\">\n                                RabbitMQ\n                            </span>\n                            <span data-kid=\"1-2-2-2-1-1-4-9\" data-name=\"kubernetes tag\">\n                                Kubernetes\n                            </span>\n                            <span data-kid=\"1-2-2-2-1-1-4-10\" data-name=\"docker tag\">\n                                Docker\n                            </span>\n                            <span data-kid=\"1-2-2-2-1-1-4-11\" data-name=\"terraform tag\">\n                                Terraform\n                            </span>\n                            <span data-kid=\"1-2-2-2-1-1-4-12\" data-name=\"langchain tag\">\n                                LangChain\n                            </span>\n                            <span data-kid=\"1-2-2-2-1-1-4-13\" data-name=\"rag tag\">\n                                RAG\n                            </span>\n                            <span data-kid=\"1-2-2-2-1-1-4-14\" data-name=\"next.js tag\">\n                                Next.js 15\n                            </span>\n                        </div>\n                        <div class=\"contact-list\" data-kid=\"1-2-2-2-1-1-5\" data-name=\"social contact list\">\n                            <a data-kid=\"1-2-2-2-1-1-5-1\" data-name=\"github link\" href=\"https://github.com/sergingroisman\">\n                                GitHub\n                            </a>\n                            <a data-kid=\"1-2-2-2-1-1-5-2\" data-name=\"linkedin link\" href=\"https://linkedin.com/in/sergingroisman\">\n                                LinkedIn\n                            </a>\n                        </div>\n                    </section>\n                    <aside aria-labelledby=\"latest-title\" class=\"read-panel\" data-kid=\"1-2-2-2-1-2\" data-name=\"latest blog post panel\">\n                        <h2 class=\"section-title\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"blog section title\" id=\"latest-title\">\n                            No blog\n                            <span aria-hidden=\"true\" class=\"line\" data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"section title decorative line\">\n                            </span>\n                        </h2>\n                        <span class=\"read-kicker\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"post kicker label\">\n                            ARTIGO · CARREIRA\n                        </span>\n                        <a class=\"post-link\" data-kid=\"1-2-2-2-1-2-3\" data-name=\"blog post link\" href=\"https://sergingroisman.github.io/blog/\">\n                            Por que todo dev sênior deveria ter um blog técnico\n                        </a>\n                        <div class=\"post-meta\" data-kid=\"1-2-2-2-1-2-4\" data-name=\"post meta container\">\n                            <span aria-hidden=\"true\" class=\"diamond\" data-kid=\"1-2-2-2-1-2-4-1\" data-name=\"post metadata icon\">\n                            </span>\n                            <time data-kid=\"1-2-2-2-1-2-4-2\" data-name=\"post date\" datetime=\"2026-03-28\">\n                                28/03/2026\n                            </time>\n                            <span data-kid=\"1-2-2-2-1-2-4-3\" data-name=\"post category\">\n                                · Carreira\n                            </span>\n                        </div>\n                        <p class=\"post-excerpt\" data-kid=\"1-2-2-2-1-2-5\" data-name=\"post excerpt text\">\n                            Depois de quase 7 anos na Avanade construindo sistemas distribuídos, cheguei a uma conclusão: escrever sobre o que você faz é tão importante quanto fazer bem feito.\n                        </p>\n                        <div class=\"tag-row\" data-kid=\"1-2-2-2-1-2-6\" data-name=\"post tag row\">\n                            <span class=\"tag\" data-kid=\"1-2-2-2-1-2-6-1\" data-name=\"tag item\">\n                                carreira\n                            </span>\n                            <span class=\"tag\" data-kid=\"1-2-2-2-1-2-6-2\" data-name=\"tag item\">\n                                engenharia de software\n                            </span>\n                            <span class=\"tag\" data-kid=\"1-2-2-2-1-2-6-3\" data-name=\"tag item\">\n                                dev life\n                            </span>\n                        </div>\n                        <a class=\"more-link\" data-kid=\"1-2-2-2-1-2-7\" data-name=\"more blog posts link\" href=\"https://sergingroisman.github.io/blog/\">\n                            Ler posts do blog  ↗\n                        </a>\n                    </aside>\n                </div>\n                <div class=\"contact-band\" data-kid=\"1-2-2-2-2\" data-name=\"contact information band\">\n                    <p data-kid=\"1-2-2-2-2-1\" data-name=\"contact prompt text\">\n                        <strong data-kid=\"1-2-2-2-2-1-1\" data-name=\"contact prompt emphasis\">\n                            Contato\n                        </strong>\n                        <br data-kid=\"1-2-2-2-2-1-2\" data-name=\"line break\"/>\n                        Para conversar sobre engenharia, projetos ou oportunidades.\n                    </p>\n                    <a class=\"contact-email\" data-kid=\"1-2-2-2-2-2\" data-name=\"email link\" href=\"mailto:serjota@proton.me\">\n                        serjota@proton.me  ↗\n                    </a>\n                </div>\n            </section>\n        </main>\n        <footer class=\"footer\" data-kid=\"1-2-3\" data-name=\"footer section\">\n            <span data-kid=\"1-2-3-1\" data-name=\"copyright text\">\n                © Sérgio Santos · Recife/PE, Brasil\n            </span>\n            <div data-kid=\"1-2-3-2\" data-name=\"footer navigation links\">\n                <a data-kid=\"1-2-3-2-1\" data-name=\"footer cv link\" href=\"https://sergingroisman.github.io/cv/\">\n                    Currículo\n                </a>\n                ·\n                <a data-kid=\"1-2-3-2-2\" data-name=\"footer blog link\" href=\"https://sergingroisman.github.io/blog/\">\n                    Blog\n                </a>\n                ·\n                <a data-kid=\"1-2-3-2-3\" data-name=\"footer brag link\" href=\"https://sergingroisman.github.io/brag/\">\n                    Brag\n                </a>\n            </div>\n        </footer>\n    </div>\n</div>\n",
