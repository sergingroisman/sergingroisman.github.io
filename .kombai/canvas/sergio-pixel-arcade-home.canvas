      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');\n.blog-page{--void:#000000;--ink:#0d2030;--ink-2:#211640;--surface:#151515;--line:#415d66;--paper:#ffe9c5;--muted:#71a6a1;--blue:#024aca;--blue-hi:#1880f8;--coral:#cf3c71;--gold:#e2d7b5;--mint:#25e2cd;--pixel:'Pixelify Sans',monospace;--sans:Inter,Arial,sans-serif;--mono:'IBM Plex Mono',monospace;position:relative;min-height:100vh;overflow:clip;background:radial-gradient(ellipse at 76% 8%,rgba(2,74,202,.12),transparent 36%),var(--void);color:var(--paper);font-family:var(--sans);font-size:16px;line-height:1.65;padding:0 0 24px}.blog-page *{box-sizing:border-box}.site-frame{position:absolute;inset:12px;pointer-events:none;z-index:5;border:1px solid rgba(65,93,102,.6);clip-path:polygon(0 6px,6px 6px,6px 0,calc(100% - 6px) 0,calc(100% - 6px) 6px,100% 6px,100% calc(100% - 6px),calc(100% - 6px) calc(100% - 6px),calc(100% - 6px) 100%,6px 100%,6px calc(100% - 6px),0 calc(100% - 6px))}.site-shell{width:min(1240px,calc(100% - 72px));margin:0 auto;position:relative;z-index:1}.topbar{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(65,93,102,.55)}.brand{display:flex;align-items:center;gap:13px;text-decoration:none;color:var(--paper)}.brand-mark{width:20px;height:20px;background:var(--coral);clip-path:polygon(0 0,70% 0,70% 30%,100% 30%,100% 100%,30% 100%,30% 70%,0 70%)}.brand-name{font:600 20px/1.1 var(--pixel);letter-spacing:.015em}.primary-nav{display:flex;gap:8px;align-items:center}.primary-nav a{padding:10px 15px;color:var(--muted);text-decoration:none;font:600 16px/1.1 var(--pixel);border:1px solid transparent}.primary-nav a:hover,.primary-nav a:focus-visible{color:var(--paper);border-color:var(--line);background:rgba(2,74,202,.14);outline:2px solid var(--gold);outline-offset:2px}.primary-nav a[aria-current=\"page\"]{color:var(--gold)}.page-heading{display:grid;grid-template-columns:.8fr 1.2fr;gap:48px;align-items:end;padding:52px 0 38px;border-bottom:1px solid rgba(65,93,102,.45)}.page-heading h1{margin:0;font:700 clamp(58px,8vw,88px)/.88 var(--pixel);letter-spacing:-.04em;color:var(--paper)}.page-heading p{max-width:610px;margin:0 0 5px;color:#e2d7b5;font-size:20px;line-height:1.55}.page-heading strong{color:var(--paper);font-weight:700}.featured{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(290px,.55fr);gap:60px;align-items:center;padding:52px 0 56px;border-bottom:1px solid rgba(65,93,102,.45)}.article-copy{max-width:760px}.article-date{display:flex;align-items:center;gap:10px;margin:0 0 17px;color:var(--muted);font:500 14px/1.3 var(--mono);letter-spacing:.035em}.article-date:before{content:\"\";width:8px;height:8px;background:var(--coral);transform:rotate(45deg)}.article-title{max-width:760px;margin:0;color:var(--paper);font:700 clamp(36px,5.3vw,60px)/1.02 var(--pixel);letter-spacing:-.025em}.article-excerpt{max-width:700px;margin:22px 0 0;color:#d6dddf;font-size:18px;line-height:1.76}.article-excerpt code{padding:2px 5px;background:#0d2030;border:1px solid #415d66;color:#e2d7b5;font:500 .84em var(--mono)}.tag-list{display:flex;flex-wrap:wrap;gap:9px;margin-top:22px}.tag{padding:6px 10px;border:1px solid rgba(113,166,161,.55);background:#0d2030;color:#bdffca;font:500 13px/1.2 var(--mono)}.article-actions{display:flex;align-items:center;gap:18px;margin-top:27px}.read-link{display:inline-flex;align-items:center;gap:12px;padding:12px 15px;background:var(--gold);color:#0d2030;text-decoration:none;font:600 15px/1.3 var(--mono);clip-path:polygon(0 0,calc(100% - 6px) 0,100% 6px,100% 100%,6px 100%,0 calc(100% - 6px))}.read-link:hover,.read-link:focus-visible{background:var(--paper);outline:2px solid var(--mint);outline-offset:3px}.read-arrow{font-size:19px;line-height:1}.article-visual{justify-self:end;width:min(100%,314px)}.portrait-frame{position:relative;aspect-ratio:3/4;padding:8px;background:#000;border:2px solid var(--line);box-shadow:8px 8px 0 rgba(0,0,0,.45),0 0 0 5px rgba(13,32,48,.55);clip-path:polygon(0 8px,8px 8px,8px 0,calc(100% - 8px) 0,calc(100% - 8px) 8px,100% 8px,100% calc(100% - 8px),calc(100% - 8px) calc(100% - 8px),calc(100% - 8px) 100%,8px 100%,8px calc(100% - 8px),0 calc(100% - 8px))}.portrait-frame img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 24%;image-rendering:pixelated}.portrait-frame:after{content:\"\";position:absolute;inset:8px;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,.28) 0 1px,transparent 1px 4px)}.portrait-caption{display:flex;justify-content:space-between;gap:10px;margin-top:15px;color:var(--muted);font:500 12px/1.4 var(--mono)}.portrait-caption span:last-child{color:var(--gold)}.article-notes{display:grid;grid-template-columns:repeat(4,1fr);gap:0;padding:23px 0 27px;border-bottom:1px solid rgba(65,93,102,.45)}.note{min-height:70px;padding:0 18px;border-left:1px solid rgba(65,93,102,.55)}.note:first-child{padding-left:0;border-left:0}.note-label{display:block;margin-bottom:6px;color:var(--muted);font:500 12px/1.3 var(--mono)}.note strong{color:var(--paper);font:600 15px/1.35 var(--sans)}.note span{display:block;color:#bdffca;font:500 12px/1.4 var(--mono)}.about-blog{display:grid;grid-template-columns:.65fr 1.35fr;gap:42px;align-items:start;padding:42px 0 48px}.about-blog h2{margin:0;color:var(--paper);font:600 28px/1.15 var(--pixel)}.about-blog p{max-width:770px;margin:0;color:#d6dddf;font-size:16px;line-height:1.8}.about-blog em{color:var(--paper)}.bottom-nav{display:flex;justify-content:space-between;gap:20px;padding:22px 0 28px;border-top:1px solid rgba(65,93,102,.45);color:var(--muted);font:400 12px/1.5 var(--mono)}.bottom-nav a{color:var(--gold);text-decoration:none}.bottom-nav a:hover{color:var(--paper)}.bottom-links{display:flex;gap:14px}.bottom-links a[aria-current=\"page\"]{color:var(--mint)}.blog-page :focus-visible{outline:2px solid var(--gold);outline-offset:3px}@media(max-width:900px){.featured{grid-template-columns:minmax(0,1.2fr) minmax(230px,.8fr);gap:32px}.article-title{font-size:clamp(34px,5vw,50px)}.article-excerpt{font-size:16px}.article-notes{grid-template-columns:repeat(2,1fr);row-gap:20px}.note:nth-child(3){padding-left:0;border-left:0}}@media(max-width:640px){.site-shell{width:calc(100% - 36px)}.topbar{height:auto;min-height:68px;gap:10px}.brand{gap:9px}.brand-name{font-size:18px}.primary-nav{gap:0}.primary-nav a{padding:9px 7px;font-size:14px}.page-heading{grid-template-columns:1fr;gap:14px;padding:34px 0 25px}.page-heading h1{font-size:60px}.page-heading p{font-size:16px;max-width:44ch}.featured{grid-template-columns:1fr;gap:24px;padding:30px 0 32px}.article-copy{display:flex;flex-direction:column;align-items:flex-start}.article-date{order:0;margin-bottom:12px;font-size:13px}.article-title{order:1;font-size:37px;line-height:1.04}.article-excerpt{order:2;margin-top:15px;font-size:15px;line-height:1.7}.tag-list{order:3;margin-top:17px}.article-actions{order:4;margin-top:19px}.article-visual{order:5;justify-self:center;width:184px;margin-top:8px}.portrait-caption{font-size:11px}.article-notes{grid-template-columns:1fr 1fr;gap:16px 0;padding:19px 0}.note{padding:0 12px}.note:nth-child(3){padding-left:0;border-left:0}.note-label{font-size:11px}.note strong{font-size:14px}.about-blog{grid-template-columns:1fr;gap:12px;padding:30px 0 34px}.about-blog h2{font-size:24px}.about-blog p{font-size:15px}.bottom-nav{flex-direction:column;gap:11px}.bottom-links{gap:12px}.site-frame{inset:5px}}@media(max-width:370px){.brand-name{font-size:16px}.primary-nav a{padding-inline:5px;font-size:13px}.article-title{font-size:33px}.article-visual{width:160px}}\n</style>\n<style>\n    .blog-page{--void:#090312;--ink:#120920;--ink-2:#241040;--surface:#1b1030;--line:#654394;--paper:#fff0cf;--muted:#d0bedb;--blue:#8152df;--blue-hi:#b38aff;--coral:#f33474;--gold:#ffd15b;--mint:#ffd15b;background:radial-gradient(ellipse at 75% 7%,rgba(125,59,218,.34),transparent 35%),radial-gradient(ellipse at 14% 40%,rgba(231,27,104,.13),transparent 36%),linear-gradient(150deg,#090312 0%,#140a29 58%,#08040f 100%)}\n.blog-page:before{content:\"\";position:absolute;inset:0 0 auto;height:760px;pointer-events:none;background:radial-gradient(ellipse at 55% 32%,rgba(116,51,200,.15),transparent 48%)}.site-frame{border-color:rgba(255,209,91,.3)}.topbar,.page-heading,.featured,.article-notes,.bottom-nav{border-color:rgba(168,121,220,.35)}.brand-mark{background:#f33474}.portrait-frame{border-color:#ffd15b;background:#170c29;box-shadow:8px 8px 0 rgba(148,24,91,.58),0 0 0 5px rgba(81,39,127,.43)}.portrait-frame:after{background:repeating-linear-gradient(0deg,rgba(9,3,18,.36) 0 1px,transparent 1px 4px)}\n.article-excerpt code,.tag{background:#1b1030;border-color:#654394}.tag{color:#f2d7ff}.note span{color:#ffd15b}.note{border-color:rgba(168,121,220,.4)}.read-link{background:#ffd15b;color:#1a0d2c}.read-link:hover,.read-link:focus-visible{background:#fff0cf}.primary-nav a:hover,.primary-nav a:focus-visible{background:rgba(129,82,223,.19);border-color:#654394}.primary-nav a[aria-current=page]{color:#ffd15b}\n</style>\n<div class=\"blog-page\" data-kid=\"1\" data-name=\"blog page container\">\n    <div aria-hidden=\"true\" class=\"site-frame\" data-kid=\"1-1\" data-name=\"decorative layout frame\">\n    </div>\n    <div class=\"site-shell\" data-kid=\"1-2\" data-name=\"page content shell\">\n        <header class=\"topbar\" data-kid=\"1-2-1\" data-name=\"top navigation bar\">\n            <a aria-label=\"Sérgio Santos — início\" class=\"brand\" data-kid=\"1-2-1-1\" data-name=\"brand logo link\" href=\"https://sergingroisman.github.io/\">\n                <span aria-hidden=\"true\" class=\"brand-mark\" data-kid=\"1-2-1-1-1\" data-name=\"brand mark icon\">\n                </span>\n                <span class=\"brand-name\" data-kid=\"1-2-1-1-2\" data-name=\"brand name text\">\n                    Sérgio Santos\n                </span>\n            </a>\n            <nav aria-label=\"Navegação principal\" class=\"primary-nav\" data-kid=\"1-2-1-2\" data-name=\"main navigation links\">\n                <a data-kid=\"1-2-1-2-1\" data-name=\"currículo page link\" href=\"https://sergingroisman.github.io/cv/\">\n                    Currículo\n                </a>\n                <a aria-current=\"page\" data-kid=\"1-2-1-2-2\" data-name=\"blog page link\" href=\"https://sergingroisman.github.io/blog/\">\n                    Blog\n                </a>\n                <a data-kid=\"1-2-1-2-3\" data-name=\"brag page link\" href=\"https://sergingroisman.github.io/brag/\">\n                    Brag\n                </a>\n            </nav>\n        </header>\n        <main data-kid=\"1-2-2\" data-name=\"main content area\">\n            <section aria-labelledby=\"blog-title\" class=\"page-heading\" data-kid=\"1-2-2-1\" data-name=\"page heading section\">\n                <h1 data-kid=\"1-2-2-1-1\" data-name=\"blog title heading\" id=\"blog-title\">\n                    Blog\n                </h1>\n                <p data-kid=\"1-2-2-1-2\" data-name=\"page introduction text\">\n                    Engenharia de software, arquitetura back-end e\n                    <strong data-kid=\"1-2-2-1-2-1\" data-name=\"ai applied focus keyword\">\n                        IA aplicada\n                    </strong>\n                    — escrito por quem ainda abre o terminal todo dia.\n                </p>\n            </section>\n            <article aria-labelledby=\"featured-title\" class=\"featured\" data-kid=\"1-2-2-2\" data-name=\"featured article section\">\n                <div class=\"article-copy\" data-kid=\"1-2-2-2-1\" data-name=\"article details container\">\n                    <p class=\"article-date\" data-kid=\"1-2-2-2-1-1\" data-name=\"article date container\">\n                        <time data-kid=\"1-2-2-2-1-1-1\" data-name=\"article publication date\" datetime=\"2026-10-02\">\n                            02 Out 2026\n                        </time>\n                    </p>\n                    <h2 class=\"article-title\" data-kid=\"1-2-2-2-1-2\" data-name=\"article title heading\" id=\"featured-title\">\n                        Eu construí um AI Lair: monitorando cota de LLM, fila de PRs e watchdogs\n                    </h2>\n                    <p class=\"article-excerpt\" data-kid=\"1-2-2-2-1-3\" data-name=\"article excerpt text\">\n                        Como montei um pequeno ecossistema de ferramentas em torno do meu agente — o\n                        <code data-kid=\"1-2-2-2-1-3-1\" data-name=\"ai-usagebar code reference\">\n                            ai-usagebar\n                        </code>\n                        (Rust) monitorando cota de DeepSeek/Kimi, um hook\n                        <code data-kid=\"1-2-2-2-1-3-2\" data-name=\"on_session_start code reference\">\n                            on_session_start\n                        </code>\n                        , um cron watchdog de saldo e o\n                        <code data-kid=\"1-2-2-2-1-3-3\" data-name=\"ghpending code reference\">\n                            ghpending\n                        </code>\n                        para a fila de PRs/issues.\n                    </p>\n                    <div aria-label=\"Temas do artigo\" class=\"tag-list\" data-kid=\"1-2-2-2-1-4\" data-name=\"article tag list\">\n                        <span class=\"tag\" data-kid=\"1-2-2-2-1-4-1\" data-name=\"ai applied tag\">\n                            IA aplicada\n                        </span>\n                        <span class=\"tag\" data-kid=\"1-2-2-2-1-4-2\" data-name=\"hermes tag\">\n                            Hermes\n                        </span>\n                        <span class=\"tag\" data-kid=\"1-2-2-2-1-4-3\" data-name=\"produtividade tag\">\n                            Produtividade\n                        </span>\n                    </div>\n                    <div class=\"article-actions\" data-kid=\"1-2-2-2-1-5\" data-name=\"article actions container\">\n                        <a class=\"read-link\" data-kid=\"1-2-2-2-1-5-1\" data-name=\"read article link\" href=\"https://sergingroisman.github.io/blog/ai-lair/\">\n                            Ler o artigo\n                            <span aria-hidden=\"true\" class=\"read-arrow\" data-kid=\"1-2-2-2-1-5-1-1\" data-name=\"read article arrow icon\">\n                                ↗\n                            </span>\n                        </a>\n                    </div>\n                </div>\n                <figure class=\"article-visual\" data-kid=\"1-2-2-2-2\" data-name=\"article visual figure\">\n                    <div class=\"portrait-frame\" data-kid=\"1-2-2-2-2-1\" data-name=\"portrait image frame\">\n                        <img alt=\"Sérgio com óculos e cavanhaque curto escrevendo em um diário sob um arco gótico violeta\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"portrait image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/47f52d6f-9fa8-4279-9b10-47ca078387b4/6f2cdd85bbc743ecb08ff0e275f314d1.jpg\"/>\n                    </div>\n                    <figcaption class=\"portrait-caption\" data-kid=\"1-2-2-2-2-2\" data-name=\"portrait caption container\">\n                        <span data-kid=\"1-2-2-2-2-2-1\" data-name=\"author name text\">\n                            Sérgio Santos\n                        </span>\n                        <span data-kid=\"1-2-2-2-2-2-2\" data-name=\"author role text\">\n                            Autor\n                        </span>\n                    </figcaption>\n                </figure>\n            </article>\n            <section aria-label=\"Ferramentas citadas no artigo\" class=\"article-notes\" data-kid=\"1-2-2-3\" data-name=\"article notes section\">\n                <div class=\"note\" data-kid=\"1-2-2-3-1\" data-name=\"monitoring note\">\n                    <span class=\"note-label\" data-kid=\"1-2-2-3-1-1\" data-name=\"note category label\">\n                        Monitoramento\n                    </span>\n                    <strong data-kid=\"1-2-2-3-1-2\" data-name=\"note title\">\n                        ai-usagebar\n                    </strong>\n                    <span data-kid=\"1-2-2-3-1-3\" data-name=\"note details text\">\n                        Rust · DeepSeek · Kimi\n                    </span>\n                </div>\n                <div class=\"note\" data-kid=\"1-2-2-3-2\" data-name=\"agent hook note\">\n                    <span class=\"note-label\" data-kid=\"1-2-2-3-2-1\" data-name=\"note category label\">\n                        Ao iniciar\n                    </span>\n                    <strong data-kid=\"1-2-2-3-2-2\" data-name=\"note title\">\n                        on_session_start\n                    </strong>\n                    <span data-kid=\"1-2-2-3-2-3\" data-name=\"note details text\">\n                        Hook do agente\n                    </span>\n                </div>\n                <div class=\"note\" data-kid=\"1-2-2-3-3\" data-name=\"watchdog note\">\n                    <span class=\"note-label\" data-kid=\"1-2-2-3-3-1\" data-name=\"note category label\">\n                        Saldo\n                    </span>\n                    <strong data-kid=\"1-2-2-3-3-2\" data-name=\"note title\">\n                        Watchdog\n                    </strong>\n                    <span data-kid=\"1-2-2-3-3-3\" data-name=\"note details text\">\n                        Verificação recorrente\n                    </span>\n                </div>\n                <div class=\"note\" data-kid=\"1-2-2-3-4\" data-name=\"fila note\">\n                    <span class=\"note-label\" data-kid=\"1-2-2-3-4-1\" data-name=\"note category label\">\n                        Fila\n                    </span>\n                    <strong data-kid=\"1-2-2-3-4-2\" data-name=\"note title\">\n                        ghpending\n                    </strong>\n                    <span data-kid=\"1-2-2-3-4-3\" data-name=\"note details text\">\n                        PRs e issues\n                    </span>\n                </div>\n            </section>\n            <section aria-labelledby=\"about-title\" class=\"about-blog\" data-kid=\"1-2-2-4\" data-name=\"about blog section\">\n                <h2 data-kid=\"1-2-2-4-1\" data-name=\"about section heading\" id=\"about-title\">\n                    Sobre este blog\n                </h2>\n                <p data-kid=\"1-2-2-4-2\" data-name=\"about section description text\">\n                    Escrevo aqui para documentar o que aprendo construindo sistemas — e para ter um registro público do meu próprio progresso. Nada de tutoriais genéricos: os textos saem de problemas reais que eu enfrentei, com as decisões e os\n                    <em data-kid=\"1-2-2-4-2-1\" data-name=\"trade-offs emphasis text\">\n                        trade-offs\n                    </em>\n                    que tomei.\n                </p>\n            </section>\n        </main>\n        <footer class=\"bottom-nav\" data-kid=\"1-2-3\" data-name=\"footer bar\">\n            <span data-kid=\"1-2-3-1\" data-name=\"copyright notice text\">\n                © Sérgio Santos · Recife/PE, Brasil\n            </span>\n            <nav aria-label=\"Navegação do rodapé\" class=\"bottom-links\" data-kid=\"1-2-3-2\" data-name=\"footer navigation links\">\n                <a data-kid=\"1-2-3-2-1\" data-name=\"currículo page link\" href=\"https://sergingroisman.github.io/cv/\">\n                    Currículo\n                </a>\n                <a aria-current=\"page\" data-kid=\"1-2-3-2-2\" data-name=\"blog page link\" href=\"https://sergingroisman.github.io/blog/\">\n                    Blog\n                </a>\n                <a data-kid=\"1-2-3-2-3\" data-name=\"brag page link\" href=\"https://sergingroisman.github.io/brag/\">\n                    Brag\n                </a>\n            </nav>\n        </footer>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-10-03T22:07:30.813281+00:00",
