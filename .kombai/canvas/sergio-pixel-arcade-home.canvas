      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Pixelify+Sans:wght@500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css\");\n:root{--ink:#090d16;--panel:#111827;--panel-hi:#182439;--line:#31415a;--paper:#f6f2e8;--muted:#b1bbca;--blue:#78a7ff;--coral:#ff8465;--gold:#ffd46d;--green:#b9e47d;--violet:#b6a0ff;--pixel:'Pixelify Sans',monospace;--body:'IBM Plex Sans',Arial,sans-serif;--mono:'IBM Plex Sans',Arial,sans-serif}\n*{box-sizing:border-box}body{margin:0;background:var(--ink);color:var(--paper);font-family:var(--body);font-size:16px;line-height:1.55;overflow-x:hidden;-webkit-font-smoothing:antialiased}\na{color:inherit;text-decoration:none}button,a{-webkit-tap-highlight-color:transparent}a:focus-visible{outline:3px solid var(--gold);outline-offset:4px}\n.site{position:relative;min-height:100vh;padding:0 42px 32px;isolation:isolate}.site::before{content:\"\";position:fixed;inset:10px;pointer-events:none;z-index:20;border:1px solid rgba(120,167,255,.2);clip-path:polygon(0 0,calc(100% - 18px) 0,100% 18px,100% 100%,0 100%)}\n.shell{width:min(1240px,100%);margin:0 auto}.topbar{height:76px;border-bottom:1px solid rgba(177,187,202,.18);display:flex;align-items:center;justify-content:space-between;gap:30px}.wordmark{display:flex;align-items:center;gap:12px;font:600 22px/1 var(--pixel);letter-spacing:.01em}.mark{width:16px;height:16px;background:var(--coral);box-shadow:8px 0 0 var(--gold),0 8px 0 var(--blue),8px 8px 0 var(--violet);transform:scale(.6);margin-right:7px}.nav{display:flex;gap:12px;align-items:center}.nav a{display:inline-flex;align-items:center;min-height:44px;padding:8px 14px;color:var(--muted);font:600 17px/1.1 var(--pixel);border:1px solid transparent;transition:color .16s steps(2,end),background .16s steps(2,end),border-color .16s steps(2,end)}.nav a:hover,.nav a.active{color:var(--paper);background:var(--panel);border-color:var(--line);box-shadow:3px 3px 0 var(--blue)}.nav a.active{color:var(--gold)}\n.intro{padding:54px 0 30px;display:grid;grid-template-columns:minmax(0,1.12fr) minmax(300px,.88fr);grid-template-areas:\"copy art\" \"proof art\";gap:26px 66px;align-items:center}.copy{grid-area:copy;max-width:660px}.eyeline{display:flex;align-items:center;gap:10px;margin:0 0 16px;color:var(--coral);font:600 16px/1.4 var(--pixel);letter-spacing:.05em}.eyeline i{font-size:18px}.eyeline span{color:var(--muted);font:500 14px/1.4 var(--body)}h1{margin:0;color:var(--paper);font:700 clamp(52px,6vw,82px)/.92 var(--pixel);letter-spacing:-.03em;text-wrap:balance}.role{margin:20px 0 0;color:var(--muted);font-size:20px;line-height:1.45;max-width:35ch}.role strong{color:var(--paper);font-weight:600}.portrait-wrap{grid-area:art;justify-self:end;position:relative;width:min(100%,386px);aspect-ratio:.91;border:1px solid #597ba9;background:#13284a;box-shadow:9px 9px 0 var(--coral),18px 18px 0 rgba(120,167,255,.16);padding:10px;clip-path:polygon(0 0,calc(100% - 18px) 0,100% 18px,100% 100%,0 100%)}.landscape{position:absolute;inset:10px;overflow:hidden;background:#102b57;isolation:isolate}.landscape svg{position:absolute;width:100%;height:100%;inset:0}.portrait-wrap::after{content:\"\";position:absolute;z-index:3;inset:10px;pointer-events:none;opacity:.34;background:repeating-linear-gradient(to bottom,rgba(5,10,22,.34) 0 1px,transparent 1px 4px);mix-blend-mode:multiply}.portrait{position:absolute;z-index:2;right:2%;bottom:0;width:69%;height:91%;object-fit:cover;object-position:50% 28%;image-rendering:pixelated;filter:saturate(.88) contrast(1.05);mix-blend-mode:normal}.art-caption{position:absolute;z-index:4;left:22px;bottom:20px;color:#fff0d8;font:600 14px/1.3 var(--pixel);text-shadow:2px 2px #071023}.proof{grid-area:proof;max-width:670px;display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:16px 0}.proof-item{padding:0 16px;border-right:1px solid var(--line);display:flex;align-items:center;gap:12px}.proof-item:first-child{padding-left:0}.proof-item:last-child{border-right:0}.proof strong{font:700 30px/1 var(--pixel);color:var(--gold);white-space:nowrap}.proof span{font-size:14px;line-height:1.3;color:var(--muted)}\n.routes{display:grid;grid-template-columns:1fr 1.14fr .9fr;border-top:1px solid rgba(177,187,202,.2);border-bottom:1px solid rgba(177,187,202,.2);margin:7px 0 0}.route{min-height:104px;padding:20px 24px;display:grid;grid-template-columns:auto 1fr auto;gap:16px;align-items:center;position:relative;transition:background .16s steps(2,end)}.route+.route{border-left:1px solid rgba(177,187,202,.18)}.route:hover{background:var(--panel)}.route-num{font:600 14px/1 var(--pixel);color:var(--coral)}.route-main strong{display:block;font:600 22px/1.1 var(--pixel);color:var(--paper)}.route-main span{display:block;margin-top:6px;color:var(--muted);font-size:14px;line-height:1.35}.route-arrow{font-size:20px;color:var(--blue)}.route:hover .route-arrow{color:var(--gold);transform:translateX(2px)}\n.content{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(270px,.8fr);gap:80px;padding:70px 0 50px}.section-title{margin:0 0 18px;font:600 28px/1.15 var(--pixel);color:var(--paper)}.bio-copy{max-width:65ch;color:var(--muted);font-size:17px;line-height:1.7}.bio-copy strong{color:var(--paper);font-weight:600}.stack{margin-top:34px}.stack-list{display:flex;flex-wrap:wrap;gap:8px 18px;padding:0;margin:0;list-style:none}.stack-list li{padding:3px 0;color:var(--muted);font-size:15px}.stack-list li:not(:last-child)::after{content:' /';color:var(--blue)}.article{padding:25px 0 23px;border-top:2px solid var(--coral);border-bottom:1px solid var(--line)}.article-meta{display:flex;flex-wrap:wrap;gap:8px 14px;color:var(--muted);font-size:13px}.article-meta span+span::before{content:'•';margin-right:14px;color:var(--coral)}.article h3{margin:14px 0 8px;font:600 26px/1.25 var(--body);color:var(--paper)}.article p{margin:0;color:var(--muted);font-size:15px;line-height:1.55}.article-tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:15px}.article-tags span{font:500 14px/1.2 var(--pixel);color:var(--blue);border-bottom:1px solid rgba(120,167,255,.38);padding:2px 2px 4px}.read-link{display:inline-block;margin-top:16px;color:var(--gold);font:600 16px/1.2 var(--pixel)}.read-link:hover{text-decoration:underline;text-underline-offset:4px}.editorial-note{margin-top:18px;color:#94a2b8;font-size:14px;line-height:1.5}.bio-facts{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:32px;padding-top:21px;border-top:1px solid var(--line)}.fact-label{display:block;color:var(--coral);font:500 14px/1.2 var(--pixel);margin-bottom:7px}.fact-value{color:var(--muted);font-size:15px}.contact{padding:28px 0 8px;display:flex;align-items:center;justify-content:space-between;gap:20px;border-top:1px solid rgba(177,187,202,.2)}.contact h2{margin:0;font:600 22px/1 var(--pixel)}.contact-links{display:flex;gap:20px;flex-wrap:wrap}.contact-links a{min-height:44px;display:inline-flex;align-items:center;gap:7px;color:var(--muted);font:600 15px/1 var(--pixel)}.contact-links a:hover{color:var(--gold)}.contact-links i{font-size:18px;color:var(--blue)}footer{display:flex;justify-content:space-between;gap:20px;padding:24px 0 0;color:#7e899b;border-top:1px solid rgba(177,187,202,.13);font-size:13px}.footer-tag{font:500 14px/1.2 var(--pixel);color:#9aabc6}\n@media(max-width:900px){.site{padding-inline:28px}.intro{gap:24px 34px;grid-template-columns:minmax(0,1.1fr) minmax(240px,.9fr)}.content{gap:48px}.route{padding:18px 14px;gap:11px}.route-main span{font-size:13px}.portrait-wrap{width:100%}}\n@media(max-width:700px){.site{padding:0 19px 24px}.topbar{height:62px;gap:10px}.wordmark{font-size:19px}.nav{gap:3px}.nav a{font-size:15px;padding:7px 8px;min-height:40px}.intro{padding:34px 0 22px;grid-template-columns:1fr;grid-template-areas:\"copy\" \"proof\" \"routes\" \"art\";gap:20px}.copy{max-width:none}h1{font-size:clamp(46px,13vw,66px);line-height:.94}.eyeline{font-size:15px;margin-bottom:11px}.role{font-size:17px;margin-top:13px;max-width:38ch}.proof{padding:12px 0;margin-top:1px}.proof-item{padding:0 8px;gap:6px;display:block}.proof-item:first-child{padding-left:0}.proof strong{font-size:24px;display:block;margin-bottom:5px}.proof span{font-size:12px;display:block}.routes{grid-template-columns:1fr;margin-top:0}.route{min-height:70px;padding:13px 10px;grid-template-columns:32px 1fr auto;gap:9px}.route+.route{border-left:0;border-top:1px solid rgba(177,187,202,.18)}.route-num{font-size:13px}.route-main strong{font-size:18px}.route-main span{font-size:13px;margin-top:2px}.portrait-wrap{justify-self:center;width:min(70%,260px);aspect-ratio:.95;box-shadow:6px 6px 0 var(--coral),12px 12px 0 rgba(120,167,255,.13)}.content{grid-template-columns:1fr;gap:42px;padding:44px 0 36px}.section-title{font-size:25px}.bio-copy{font-size:16px}.article h3{font-size:22px}.contact{align-items:flex-start;flex-direction:column}.contact-links{gap:12px 22px}footer{flex-direction:column;gap:8px}}\n@media(max-width:380px){.site{padding-inline:14px}.nav a{font-size:14px;padding-inline:6px}.wordmark{font-size:17px}.proof-item span{font-size:11px}.route-main span{max-width:24ch}}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}\n</style>\n<style>\n    .routes{grid-column:1/-1}\n</style>\n<style>\n    :root{--ink:#090312;--panel:#170d2d;--panel-hi:#261044;--line:#654394;--paper:#fff0cf;--muted:#d2bfdc;--blue:#8152df;--coral:#f33474;--gold:#ffd15b;--green:#ffd15b;--violet:#a444f1}\n.site{background:radial-gradient(ellipse at 72% 11%,rgba(126,60,220,.32),transparent 36%),radial-gradient(ellipse at 15% 42%,rgba(232,27,106,.12),transparent 36%),linear-gradient(150deg,#090312 0%,#130925 58%,#08040f 100%)}.site:before{border-color:rgba(255,209,91,.25)}\n.topbar,.routes,.route+.route,.proof,.content,footer{border-color:rgba(168,121,220,.34)}.portrait-wrap{border-color:#ffd15b;background:#170c2a;box-shadow:9px 9px 0 #a51a5b,18px 18px 0 rgba(125,70,199,.3)}.landscape svg{filter:hue-rotate(34deg) saturate(1.3) contrast(1.08)}.portrait-wrap:after{background:repeating-linear-gradient(to bottom,rgba(9,3,18,.36) 0 1px,transparent 1px 4px)}\n.mark{background:#f33474;box-shadow:8px 0 0 #ffd15b,0 8px 0 #8152df,8px 8px 0 #a444f1}.nav a:hover,.nav a.active{background:#1b0e31;border-color:#654394;box-shadow:3px 3px 0 #a444f1}.proof,.proof-item{border-color:rgba(168,121,220,.37)}.route:hover{background:#1b0e31}.article{border-color:#f33474}.article-tags span,.contact-links i,.route-arrow{color:#b38aff}.article-tags span{border-color:rgba(179,138,255,.46)}\n</style>\n<div class=\"site\" data-kid=\"1\" data-name=\"site wrapper\">\n    <header class=\"topbar shell\" data-kid=\"1-1\" data-name=\"top header bar\">\n        <a class=\"wordmark\" data-kid=\"1-1-1\" data-name=\"site wordmark link\" href=\"#inicio\">\n            <span aria-hidden=\"true\" class=\"mark\" data-kid=\"1-1-1-1\" data-name=\"decorative pixel mark\">\n            </span>\n            Sérgio Santos\n        </a>\n        <nav aria-label=\"Navegação principal\" class=\"nav\" data-kid=\"1-1-2\" data-name=\"main navigation list\">\n            <a data-kid=\"1-1-2-1\" data-name=\"cv navigation link\" href=\"/cv/\">\n                Currículo\n            </a>\n            <a class=\"active\" data-kid=\"1-1-2-2\" data-name=\"blog navigation link\" href=\"/blog/\">\n                Blog\n            </a>\n            <a data-kid=\"1-1-2-3\" data-name=\"brag navigation link\" href=\"/brag/\">\n                Brag\n            </a>\n        </nav>\n    </header>\n    <main class=\"shell\" data-kid=\"1-2\" data-name=\"main content area\" id=\"inicio\">\n        <section aria-label=\"Apresentação\" class=\"intro\" data-kid=\"1-2-1\" data-name=\"intro presentation section\">\n            <div class=\"copy\" data-kid=\"1-2-1-1\" data-name=\"intro copy container\">\n                <p class=\"eyeline\" data-kid=\"1-2-1-1-1\" data-name=\"eyeline container\">\n                    <i aria-hidden=\"true\" class=\"ph ph-terminal-window\" data-kid=\"1-2-1-1-1-1\" data-name=\"terminal icon\">\n                    </i>\n                    BACK-END · RECIFE/PE\n                    <span data-kid=\"1-2-1-1-1-2\" data-name=\"location metadata\">\n                        · Avanade\n                    </span>\n                </p>\n                <h1 data-kid=\"1-2-1-1-2\" data-name=\"hero main headline\">\n                    Sérgio\n                    <br data-kid=\"1-2-1-1-2-1\" data-name=\"headline line break\"/>\n                    Santos\n                </h1>\n                <p class=\"role\" data-kid=\"1-2-1-1-3\" data-name=\"hero role description\">\n                    <strong data-kid=\"1-2-1-1-3-1\" data-name=\"role emphasis\">\n                        Senior Analyst · Back-End Development\n                    </strong>\n                    <br data-kid=\"1-2-1-1-3-2\" data-name=\"role line break\"/>\n                    Construindo sistemas distribuídos e event-driven na AWS.\n                </p>\n            </div>\n            <figure class=\"portrait-wrap\" data-kid=\"1-2-1-2\" data-name=\"portrait container\">\n                <div aria-hidden=\"true\" class=\"landscape\" data-kid=\"1-2-1-2-1\" data-name=\"landscape illustration container\">\n                    <svg data-kid=\"1-2-1-2-1-1\" data-name=\"landscape illustration svg\" preserveaspectratio=\"xMidYMid slice\" viewbox=\"0 0 360 390\">\n                        <rect fill=\"#143368\" height=\"390\" width=\"360\">\n                        </rect>\n                        <rect fill=\"#f6f2e8\" height=\"7\" width=\"7\" x=\"34\" y=\"34\">\n                        </rect>\n                        <rect fill=\"#ffd46d\" height=\"7\" width=\"7\" x=\"294\" y=\"54\">\n                        </rect>\n                        <rect fill=\"#78a7ff\" height=\"7\" width=\"7\" x=\"250\" y=\"34\">\n                        </rect>\n                        <rect fill=\"#b6a0ff\" height=\"6\" width=\"6\" x=\"75\" y=\"62\">\n                        </rect>\n                        <rect fill=\"#f6f2e8\" height=\"6\" width=\"6\" x=\"224\" y=\"70\">\n                        </rect>\n                        <rect fill=\"#ff8465\" height=\"58\" width=\"58\" x=\"244\" y=\"111\">\n                        </rect>\n                        <rect fill=\"#ff8465\" height=\"34\" width=\"82\" x=\"232\" y=\"123\">\n                        </rect>\n                        <path d=\"M0 212h38v-22h30v-22h46v25h30v-32h52v26h24v-14h52v19h38v198H0z\" fill=\"#102548\">\n                        </path>\n                        <path d=\"M0 269h50v-18h27v-25h44v18h34v-32h27v33h33v-16h48v17h40v23h57v121H0z\" fill=\"#0c1b32\">\n                        </path>\n                        <rect fill=\"#31548a\" height=\"8\" width=\"22\" x=\"16\" y=\"306\">\n                        </rect>\n                        <rect fill=\"#31548a\" height=\"8\" width=\"14\" x=\"84\" y=\"288\">\n                        </rect>\n                        <rect fill=\"#31548a\" height=\"8\" width=\"24\" x=\"229\" y=\"278\">\n                        </rect>\n                        <rect fill=\"#31548a\" height=\"8\" width=\"30\" x=\"292\" y=\"330\">\n                        </rect>\n                        <rect fill=\"#091426\" height=\"24\" width=\"360\" y=\"366\">\n                        </rect>\n                        <rect fill=\"#ff8465\" height=\"5\" width=\"40\" x=\"22\" y=\"371\">\n                        </rect>\n                        <rect fill=\"#78a7ff\" height=\"5\" width=\"62\" x=\"278\" y=\"371\">\n                        </rect>\n                    </svg>\n                </div>\n                <img alt=\"Retrato 16-bit de Sérgio com óculos transparentes, bigode e cavanhaque curto, bochechas sem barba, diante de ruínas violetas\" class=\"portrait\" data-kid=\"1-2-1-2-2\" data-name=\"pixel art portrait image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/47f52d6f-9fa8-4279-9b10-47ca078387b4/964f021b32a44269afe370e2c6843ab9.jpg\"/>\n                <figcaption class=\"art-caption\" data-kid=\"1-2-1-2-3\" data-name=\"art caption label\">\n                    01 · SÉRGIO\n                </figcaption>\n            </figure>\n            <div aria-label=\"Experiência profissional\" class=\"proof\" data-kid=\"1-2-1-3\" data-name=\"experience professional metrics section\">\n                <div class=\"proof-item\" data-kid=\"1-2-1-3-1\" data-name=\"distributed systems experience item\">\n                    <strong data-kid=\"1-2-1-3-1-1\" data-name=\"distributed systems count\">\n                        11+\n                    </strong>\n                    <span data-kid=\"1-2-1-3-1-2\" data-name=\"distributed systems description\">\n                        anos com sistemas distribuídos\n                        <br data-kid=\"1-2-1-3-1-2-1\" data-name=\"distributed systems description line break\"/>\n                        e event-driven na AWS\n                    </span>\n                </div>\n                <div class=\"proof-item\" data-kid=\"1-2-1-3-2\" data-name=\"nodejs experience item\">\n                    <strong data-kid=\"1-2-1-3-2-1\" data-name=\"nodejs count\">\n                        10\n                    </strong>\n                    <span data-kid=\"1-2-1-3-2-2\" data-name=\"nodejs description\">\n                        anos trabalhando\n                        <br data-kid=\"1-2-1-3-2-2-1\" data-name=\"nodejs description line break\"/>\n                        com Node.js\n                    </span>\n                </div>\n                <div class=\"proof-item\" data-kid=\"1-2-1-3-3\" data-name=\"nestjs typescript experience item\">\n                    <strong data-kid=\"1-2-1-3-3-1\" data-name=\"nestjs count\">\n                        07\n                    </strong>\n                    <span data-kid=\"1-2-1-3-3-2\" data-name=\"nestjs description\">\n                        anos com NestJS\n                        <br data-kid=\"1-2-1-3-3-2-1\" data-name=\"nestjs description line break\"/>\n                        e TypeScript\n                    </span>\n                </div>\n            </div>\n            <nav aria-label=\"Explore o site\" class=\"routes\" data-kid=\"1-2-1-4\" data-name=\"site navigation links container\">\n                <a class=\"route\" data-kid=\"1-2-1-4-1\" data-name=\"cv route link\" href=\"/cv/\">\n                    <span class=\"route-num\" data-kid=\"1-2-1-4-1-1\" data-name=\"cv route number\">\n                        01\n                    </span>\n                    <span class=\"route-main\" data-kid=\"1-2-1-4-1-2\" data-name=\"cv route main text\">\n                        <strong data-kid=\"1-2-1-4-1-2-1\" data-name=\"cv route title\">\n                            Currículo\n                        </strong>\n                        <span data-kid=\"1-2-1-4-1-2-2\" data-name=\"cv route description\">\n                            Experiência, stack e trajetória\n                        </span>\n                    </span>\n                    <span aria-hidden=\"true\" class=\"route-arrow\" data-kid=\"1-2-1-4-1-3\" data-name=\"cv route arrow icon\">\n                        ↗\n                    </span>\n                </a>\n                <a class=\"route\" data-kid=\"1-2-1-4-2\" data-name=\"blog route link\" href=\"/blog/\">\n                    <span class=\"route-num\" data-kid=\"1-2-1-4-2-1\" data-name=\"blog route number\">\n                        02\n                    </span>\n                    <span class=\"route-main\" data-kid=\"1-2-1-4-2-2\" data-name=\"blog route main text\">\n                        <strong data-kid=\"1-2-1-4-2-2-1\" data-name=\"blog route title\">\n                            Blog\n                        </strong>\n                        <span data-kid=\"1-2-1-4-2-2-2\" data-name=\"blog route description\">\n                            Engenharia de software e prática\n                        </span>\n                    </span>\n                    <span aria-hidden=\"true\" class=\"route-arrow\" data-kid=\"1-2-1-4-2-3\" data-name=\"blog route arrow icon\">\n                        ↗\n                    </span>\n                </a>\n                <a class=\"route\" data-kid=\"1-2-1-4-3\" data-name=\"brag route link\" href=\"/brag/\">\n                    <span class=\"route-num\" data-kid=\"1-2-1-4-3-1\" data-name=\"brag route number\">\n                        03\n                    </span>\n                    <span class=\"route-main\" data-kid=\"1-2-1-4-3-2\" data-name=\"brag route main text\">\n                        <strong data-kid=\"1-2-1-4-3-2-1\" data-name=\"brag route title\">\n                            Brag\n                        </strong>\n                        <span data-kid=\"1-2-1-4-3-2-2\" data-name=\"brag route description\">\n                            Projetos, decisões e impacto\n                        </span>\n                    </span>\n                    <span aria-hidden=\"true\" class=\"route-arrow\" data-kid=\"1-2-1-4-3-3\" data-name=\"brag route arrow icon\">\n                        ↗\n                    </span>\n                </a>\n            </nav>\n        </section>\n        <section aria-label=\"Sobre e publicação\" class=\"content\" data-kid=\"1-2-2\" data-name=\"about and blog post section\">\n            <div data-kid=\"1-2-2-1\" data-name=\"about section content\">\n                <h2 class=\"section-title\" data-kid=\"1-2-2-1-1\" data-name=\"about section title\">\n                    Sobre\n                </h2>\n                <div class=\"bio-copy\" data-kid=\"1-2-2-1-2\" data-name=\"biography description text\">\n                    <p data-kid=\"1-2-2-1-2-1\" data-name=\"biography paragraph one\">\n                        Sou\n                        <strong data-kid=\"1-2-2-1-2-1-1\" data-name=\"senior analyst emphasis\">\n                            Senior Analyst\n                        </strong>\n                        em Back-End Development na\n                        <strong data-kid=\"1-2-2-1-2-1-2\" data-name=\"avanade emphasis\">\n                            Avanade\n                        </strong>\n                        , em Recife/PE. Trabalho com sistemas distribuídos e event-driven na AWS; tenho 10 anos de experiência com Node.js e 7 anos com NestJS e TypeScript.\n                    </p>\n                    <p data-kid=\"1-2-2-1-2-2\" data-name=\"biography paragraph two\">\n                        Fora do trabalho, acompanho anime, jogos e café. Aqui reúno meus textos técnicos, experiência profissional e projetos.\n                    </p>\n                </div>\n                <div class=\"stack\" data-kid=\"1-2-2-1-3\" data-name=\"stack main list container\">\n                    <h2 class=\"section-title\" data-kid=\"1-2-2-1-3-1\" data-name=\"stack main section title\">\n                        Stack principal\n                    </h2>\n                    <ul class=\"stack-list\" data-kid=\"1-2-2-1-3-2\" data-name=\"stack items list\">\n                        <li data-kid=\"1-2-2-1-3-2-1\" data-name=\"nodejs list item\">\n                            Node.js\n                        </li>\n                        <li data-kid=\"1-2-2-1-3-2-2\" data-name=\"nestjs list item\">\n                            NestJS\n                        </li>\n                        <li data-kid=\"1-2-2-1-3-2-3\" data-name=\"typescript list item\">\n                            TypeScript\n                        </li>\n                        <li data-kid=\"1-2-2-1-3-2-4\" data-name=\"aws list item\">\n                            AWS\n                        </li>\n                        <li data-kid=\"1-2-2-1-3-2-5\" data-name=\"systems list item\">\n                            Sistemas distribuídos\n                        </li>\n                        <li data-kid=\"1-2-2-1-3-2-6\" data-name=\"event-driven list item\">\n                            Event-driven\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <aside aria-labelledby=\"article-heading\" data-kid=\"1-2-2-2\" data-name=\"blog post sidebar\">\n                <h2 class=\"section-title\" data-kid=\"1-2-2-2-1\" data-name=\"blog post section title\">\n                    No blog\n                </h2>\n                <article class=\"article\" data-kid=\"1-2-2-2-2\" data-name=\"blog post article container\">\n                    <div class=\"article-meta\" data-kid=\"1-2-2-2-2-1\" data-name=\"article meta container\">\n                        <span data-kid=\"1-2-2-2-2-1-1\" data-name=\"article date\">\n                            28 mar. 2026\n                        </span>\n                        <span data-kid=\"1-2-2-2-2-1-2\" data-name=\"article category\">\n                            Carreira\n                        </span>\n                    </div>\n                    <h3 data-kid=\"1-2-2-2-2-2\" data-name=\"article title\" id=\"article-heading\">\n                        Por que todo dev sênior deveria ter um blog técnico\n                    </h3>\n                    <p data-kid=\"1-2-2-2-2-3\" data-name=\"article summary text\">\n                        Depois de quase 7 anos na Avanade construindo sistemas distribuídos, cheguei em uma conclusão: escrever sobre o que você faz é tão importante quanto fazer bem feito.\n                    </p>\n                    <div class=\"article-tags\" data-kid=\"1-2-2-2-2-4\" data-name=\"article tags container\">\n                        <span data-kid=\"1-2-2-2-2-4-1\" data-name=\"tag one\">\n                            # carreira\n                        </span>\n                        <span data-kid=\"1-2-2-2-2-4-2\" data-name=\"tag two\">\n                            # engenharia de software\n                        </span>\n                        <span data-kid=\"1-2-2-2-2-4-3\" data-name=\"tag three\">\n                            # dev life\n                        </span>\n                    </div>\n                    <a class=\"read-link\" data-kid=\"1-2-2-2-2-5\" data-name=\"read full post link\" href=\"/2026/03/28/bem-vindo/\">\n                        Ler artigo →\n                    </a>\n                </article>\n                <p class=\"editorial-note\" data-kid=\"1-2-2-2-3\" data-name=\"editorial note text\">\n                    No blog: posts organizados por data e assunto, com busca para encontrar temas técnicos.\n                </p>\n                <div class=\"bio-facts\" data-kid=\"1-2-2-2-4\" data-name=\"bio facts grid container\">\n                    <div data-kid=\"1-2-2-2-4-1\" data-name=\"language fact item\">\n                        <span class=\"fact-label\" data-kid=\"1-2-2-2-4-1-1\" data-name=\"language label\">\n                            Inglês\n                        </span>\n                        <span class=\"fact-value\" data-kid=\"1-2-2-2-4-1-2\" data-name=\"language value\">\n                            B2 · estudando C1\n                        </span>\n                    </div>\n                    <div data-kid=\"1-2-2-2-4-2\" data-name=\"location fact item\">\n                        <span class=\"fact-label\" data-kid=\"1-2-2-2-4-2-1\" data-name=\"location label\">\n                            Local\n                        </span>\n                        <span class=\"fact-value\" data-kid=\"1-2-2-2-4-2-2\" data-name=\"location value\">\n                            Recife/PE, Brasil\n                        </span>\n                    </div>\n                </div>\n            </aside>\n        </section>\n        <section class=\"contact\" data-kid=\"1-2-3\" data-name=\"contact section\">\n            <h2 data-kid=\"1-2-3-1\" data-name=\"contact section title\">\n                Fale comigo\n            </h2>\n            <div class=\"contact-links\" data-kid=\"1-2-3-2\" data-name=\"contact links container\">\n                <a data-kid=\"1-2-3-2-1\" data-name=\"email link\" href=\"mailto:serjota@proton.me\">\n                    <i aria-hidden=\"true\" class=\"ph ph-envelope-simple\" data-kid=\"1-2-3-2-1-1\" data-name=\"email icon\">\n                    </i>\n                    serjota@proton.me\n                </a>\n                <a data-kid=\"1-2-3-2-2\" data-name=\"linkedin link\" href=\"https://linkedin.com/in/sergingroisman\">\n                    <i aria-hidden=\"true\" class=\"ph ph-linkedin-logo\" data-kid=\"1-2-3-2-2-1\" data-name=\"linkedin icon\">\n                    </i>\n                    LinkedIn\n                </a>\n                <a data-kid=\"1-2-3-2-3\" data-name=\"github link\" href=\"https://github.com/sergingroisman\">\n                    <i aria-hidden=\"true\" class=\"ph ph-github-logo\" data-kid=\"1-2-3-2-3-1\" data-name=\"github icon\">\n                    </i>\n                    GitHub\n                </a>\n            </div>\n        </section>\n    </main>\n    <footer class=\"shell\" data-kid=\"1-3\" data-name=\"footer container\">\n        <span data-kid=\"1-3-1\" data-name=\"copyright notice text\">\n            © 2026 Sérgio Santos\n        </span>\n        <span class=\"footer-tag\" data-kid=\"1-3-2\" data-name=\"footer location tag\">\n            Recife, Pernambuco · Brasil\n        </span>\n    </footer>\n</div>\n",
      "comments": [],
