    },
    "var_977171610512": {
      "type": "variant",
      "label": "Brag — evidências e impacto",
      "parentId": "var_9cd53271da78",
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n.brag{--void:#000000;--ink:#0d2030;--ink2:#211640;--surface:#151515;--line:#415d66;--paper:#ffe9c5;--muted:#71a6a1;--blue:#024aca;--bluehi:#1880f8;--pink:#cf3c71;--cream:#e2d7b5;--teal:#25e2cd;--pixel:'Pixelify Sans',monospace;--sans:Inter,Arial,sans-serif;--mono:'IBM Plex Mono',monospace;background:var(--void);color:var(--paper);font:16px/1.65 var(--sans);min-height:100vh;padding:0 0 36px;position:relative;overflow:clip}.brag *{box-sizing:border-box}.brag a{color:inherit}.brag-shell{width:min(1240px,calc(100% - 64px));margin:0 auto;position:relative;z-index:1}.brag:before{position:absolute;content:\"\";inset:0 0 auto;height:650px;pointer-events:none;background:radial-gradient(ellipse at 84% 9%,rgba(2,74,202,.1),transparent 42%)}.pixel-frame{position:fixed;inset:10px;pointer-events:none;z-index:5;border:1px solid rgba(65,93,102,.32);clip-path:polygon(0 6px,6px 6px,6px 0,calc(100% - 6px) 0,calc(100% - 6px) 6px,100% 6px,100% calc(100% - 6px),calc(100% - 6px) calc(100% - 6px),calc(100% - 6px) 100%,6px 100%,6px calc(100% - 6px),0 calc(100% - 6px))}.site-header{height:76px;border-bottom:1px solid rgba(65,93,102,.46);display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:flex;align-items:center;gap:12px;text-decoration:none;font:600 20px/1 var(--pixel);white-space:nowrap}.brand-mark{width:18px;height:18px;background:var(--pink);clip-path:polygon(0 0,70% 0,70% 30%,100% 30%,100% 100%,30% 100%,30% 70%,0 70%)}.nav{display:flex;gap:8px;align-items:center}.nav a{padding:10px 14px;text-decoration:none;color:var(--muted);font:600 16px/1 var(--pixel);border:1px solid transparent}.nav a:hover,.nav a:focus-visible{border-color:var(--line);background:var(--ink);color:var(--paper);outline:2px solid var(--cream);outline-offset:2px}.nav a[aria-current=page]{color:var(--cream);border-color:rgba(226,215,181,.26);background:rgba(226,215,181,.05)}.hero{padding:72px 0 34px;border-bottom:1px solid rgba(65,93,102,.42);display:grid;grid-template-columns:minmax(0,1fr) 112px;gap:28px;align-items:end}.hero-kicker{margin:0 0 11px;color:var(--pink);font:500 13px/1.4 var(--mono);letter-spacing:.035em}h1{margin:0;color:var(--paper);font:700 clamp(52px,7vw,82px)/.92 var(--pixel);letter-spacing:-.025em}h1 span{color:var(--cream)}.hero-copy{max-width:760px}.hero-lede{margin:20px 0 0;color:#d8cdb3;font-size:18px;line-height:1.65;max-width:730px}.hero-lede strong{color:var(--paper);font-weight:600}.portrait{width:104px;height:116px;justify-self:end;position:relative;padding:4px;background:#000;border:2px solid var(--line);box-shadow:5px 5px 0 #211640;clip-path:polygon(0 7px,7px 7px,7px 0,calc(100% - 7px) 0,calc(100% - 7px) 7px,100% 7px,100% calc(100% - 7px),calc(100% - 7px) calc(100% - 7px),calc(100% - 7px) 100%,7px 100%,7px calc(100% - 7px),0 calc(100% - 7px))}.portrait img{width:100%;height:100%;object-fit:cover;object-position:center 13%;image-rendering:pixelated}.portrait:after{content:\"\";position:absolute;inset:4px;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,.32) 0 1px,transparent 1px 4px)}.portrait-caption{position:absolute;left:50%;bottom:7px;transform:translateX(-50%);white-space:nowrap;background:#000;padding:3px 6px;border:1px solid rgba(113,166,161,.6);color:var(--teal);font:500 9px/1.2 var(--mono);z-index:1}.meta-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;margin-top:31px;padding:17px 0;border-top:1px solid rgba(65,93,102,.4)}.meta-item{display:flex;flex-direction:column;gap:4px}.meta-label{color:var(--muted);font:500 12px/1.3 var(--mono);letter-spacing:.07em;text-transform:uppercase}.meta-value{color:var(--paper);font:500 15px/1.4 var(--mono)}.section{padding:45px 0 48px;border-bottom:1px solid rgba(65,93,102,.38)}.section-heading{margin:0 0 22px;display:flex;align-items:baseline;gap:15px;color:var(--paper);font:600 29px/1.1 var(--pixel)}.section-heading:after{content:\"\";height:1px;flex:1;background:linear-gradient(90deg,var(--line),transparent)}.section-intro{margin:-9px 0 20px;color:var(--muted);max-width:760px;font-size:15px}.metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:linear-gradient(90deg,rgba(13,32,48,.6),rgba(0,0,0,.1))}.metric{padding:22px 26px 20px;min-height:124px;position:relative}.metric+.metric{border-left:1px solid rgba(65,93,102,.48)}.metric-value{display:block;color:var(--paper);font:700 clamp(38px,5vw,58px)/1 var(--pixel);letter-spacing:-.02em}.metric:nth-child(2) .metric-value{color:var(--cream)}.metric:nth-child(3) .metric-value{color:#71a6a1}.metric-label{display:block;margin-top:7px;color:#d1c5a7;font:500 14px/1.35 var(--mono)}.metric-source{margin:14px 0 0;color:var(--muted);font-size:13px;line-height:1.65}.metric-source strong{color:var(--cream);font-weight:600}.epic-table-wrap{border:1px solid rgba(65,93,102,.55);background:rgba(13,32,48,.38);position:relative}.epic-table-wrap:before{position:absolute;content:\"\";inset:2px;pointer-events:none;z-index:0;opacity:.28;background:repeating-linear-gradient(0deg,rgba(226,215,181,.18) 0 1px,transparent 1px 5px)}.epic-table{position:relative;z-index:1;border-collapse:collapse;width:100%;text-align:left}.epic-table thead{background:rgba(0,0,0,.72)}.epic-table th{color:var(--muted);font:500 12px/1.4 var(--mono);letter-spacing:.06em;text-transform:uppercase;padding:13px 17px;border-bottom:1px solid var(--line)}.epic-table td{padding:15px 17px;border-bottom:1px solid rgba(65,93,102,.35);color:#d8cdb3;font-size:14px;line-height:1.45;vertical-align:top}.epic-table tbody tr:last-child td{border-bottom:0}.epic-table tbody tr:hover{background:rgba(33,22,64,.38)}.epic-id{color:var(--cream)!important;font:600 14px/1.4 var(--mono)!important;white-space:nowrap}.epic-num{font:500 14px/1.4 var(--mono)!important;color:var(--paper)!important;white-space:nowrap}.table-note{margin:12px 0 0;color:var(--muted);font-size:13px;line-height:1.55}.impact-list{display:grid;grid-template-columns:1fr;gap:0}.impact-row{display:grid;grid-template-columns:136px minmax(190px,.72fr) minmax(0,1.5fr);gap:20px;padding:20px 0;border-top:1px solid rgba(65,93,102,.4)}.impact-period{color:var(--muted);font:500 13px/1.5 var(--mono)}.impact-title{color:var(--paper);font:600 21px/1.16 var(--pixel)}.impact-stack{display:block;margin-top:7px;color:#71a6a1;font:400 12px/1.5 var(--mono)}.impact-copy{margin:0;color:#d8cdb3;font-size:14px;line-height:1.7}.impact-copy strong{color:var(--cream);font-weight:600}.architecture{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:42px;row-gap:0;list-style:none;margin:0;padding:0}.architecture li{padding:14px 0 15px;border-top:1px solid rgba(65,93,102,.37);color:#d8cdb3;font-size:14px;line-height:1.65}.architecture strong{color:var(--paper);font-weight:600}.architecture li:before{content:\"▸\";color:var(--pink);font:600 14px/1 var(--mono);margin-right:10px}.mentor-list{border-top:1px solid rgba(65,93,102,.4)}.mentor-row{display:grid;grid-template-columns:190px minmax(0,1fr) minmax(0,1fr);gap:24px;padding:17px 0;border-bottom:1px solid rgba(65,93,102,.3)}.mentor-name{color:var(--cream);font:600 17px/1.25 var(--pixel)}.mentor-cell{color:#d8cdb3;font-size:14px;line-height:1.6}.mentor-label{display:block;margin-bottom:5px;color:var(--muted);font:500 12px/1.3 var(--mono);letter-spacing:.05em;text-transform:uppercase}.skills{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}.skill-group{border-top:2px solid var(--skill);padding-top:12px}.skill-group h3{margin:0 0 13px;color:var(--paper);font:600 18px/1.2 var(--pixel)}.skill-group p{margin:0 0 13px;color:var(--muted);font-size:13px;line-height:1.55}.skill-tags{display:flex;flex-wrap:wrap;gap:7px}.skill-tags span{padding:4px 7px;border:1px solid rgba(65,93,102,.56);background:rgba(13,32,48,.55);color:#d8cdb3;font:500 12px/1.35 var(--mono)}.goals{display:grid;grid-template-columns:1.2fr .8fr;gap:30px;align-items:start}.goal-list{list-style:none;margin:0;padding:0;border-top:1px solid rgba(65,93,102,.4)}.goal-list li{padding:13px 0;border-bottom:1px solid rgba(65,93,102,.3);color:#d8cdb3;font-size:14px;line-height:1.55}.goal-list li strong{color:var(--paper);font-weight:600}.goal-status{color:var(--teal);font:500 12px/1.45 var(--mono)}.goal-aside{padding:18px 20px;background:rgba(13,32,48,.45);border:1px solid rgba(65,93,102,.45);color:var(--muted);font-size:14px;line-height:1.65}.goal-aside strong{color:var(--cream)}.footer{padding:25px 0 10px;display:flex;align-items:center;justify-content:space-between;gap:20px;color:var(--muted);font:400 12px/1.5 var(--mono)}.footer-links{display:flex;gap:9px;align-items:center}.footer a{color:#71a6a1;text-decoration:none}.footer a:hover{color:var(--paper)}.footer .dot{color:var(--pink)}:focus-visible{outline:2px solid var(--cream);outline-offset:3px}\n@media(max-width:900px){.brag-shell{width:min(100% - 42px,760px)}.hero{padding-top:48px}.impact-row{grid-template-columns:110px minmax(160px,.8fr) minmax(0,1.4fr);gap:16px}.architecture{column-gap:26px}.mentor-row{grid-template-columns:150px 1fr 1fr;gap:16px}}\n@media(max-width:640px){.brag-shell{width:calc(100% - 36px)}.site-header{height:auto;min-height:68px;gap:8px}.brand{font-size:18px;gap:8px}.brand-mark{width:15px;height:15px}.nav{gap:0}.nav a{font-size:14px;padding:9px 7px}.hero{grid-template-columns:minmax(0,1fr) 72px;gap:12px;padding:37px 0 25px;align-items:center}.hero-kicker{font-size:11px}h1{font-size:clamp(44px,13vw,60px)}.hero-lede{font-size:15px;line-height:1.55;margin-top:14px}.portrait{width:68px;height:82px;box-shadow:3px 3px 0 #211640}.portrait-caption{font-size:8px;bottom:5px;padding:2px 4px}.meta-strip{grid-template-columns:repeat(2,minmax(0,1fr));gap:13px 17px;margin-top:23px;padding:15px 0}.meta-label{font-size:11px}.meta-value{font-size:13px}.section{padding:31px 0 34px}.section-heading{font-size:24px;gap:10px;margin-bottom:17px}.section-intro{font-size:14px}.metrics{grid-template-columns:1fr}.metric{min-height:auto;padding:13px 16px;display:grid;grid-template-columns:112px 1fr;align-items:center;gap:0 12px}.metric+.metric{border-left:0;border-top:1px solid rgba(65,93,102,.45)}.metric-value{grid-row:span 2;font-size:39px}.metric-label{margin-top:0;font-size:12px}.metric-source{font-size:12px}.epic-table-wrap{border:0;background:transparent}.epic-table-wrap:before{display:none}.epic-table,.epic-table tbody{display:block}.epic-table thead{display:none}.epic-table tbody tr{display:grid;grid-template-columns:1fr 1fr;gap:0 12px;padding:10px 12px 8px;margin-bottom:9px;background:rgba(13,32,48,.72);border:1px solid rgba(65,93,102,.58);position:relative}.epic-table tbody td{display:block;padding:5px 0;border:0;font-size:13px}.epic-table tbody td:nth-child(2){grid-column:1/-1;grid-row:1;padding-bottom:9px;color:var(--paper);font-weight:500}.epic-table tbody td:nth-child(1){grid-column:1/-1;grid-row:2}.epic-table tbody td:nth-child(3){grid-column:1;grid-row:3}.epic-table tbody td:nth-child(4){grid-column:2;grid-row:3}.epic-table tbody td:before{display:block;margin-bottom:2px;color:var(--muted);font:500 10px/1.3 var(--mono);letter-spacing:.05em;text-transform:uppercase}.epic-table tbody td:nth-child(1):before{content:\"Épico\"}.epic-table tbody td:nth-child(2):before{content:\"Descrição\"}.epic-table tbody td:nth-child(3):before{content:\"Cards concluídos\"}.epic-table tbody td:nth-child(4):before{content:\"Horas registradas\"}.epic-id{font-size:13px!important}.table-note{font-size:12px}.impact-row{grid-template-columns:1fr;gap:5px;padding:15px 0}.impact-period{font-size:12px}.impact-title{font-size:20px}.impact-copy{font-size:14px}.architecture{grid-template-columns:1fr}.architecture li{padding:12px 0;font-size:14px}.mentor-row{grid-template-columns:1fr;gap:7px;padding:13px 0}.mentor-name{font-size:17px}.mentor-cell{font-size:13px}.mentor-label{margin-bottom:2px}.skills{grid-template-columns:1fr;gap:20px}.skill-group{padding-top:10px}.skill-group p{margin-bottom:9px}.goals{grid-template-columns:1fr;gap:18px}.goal-list li{font-size:13px}.goal-aside{font-size:13px;padding:15px}.footer{flex-direction:column;align-items:flex-start;gap:10px}.pixel-frame{inset:5px}}\n</style>\n<style>\n    .brag{--void:#090312;--ink:#120920;--ink2:#241040;--surface:#1b1030;--line:#654394;--paper:#fff0cf;--muted:#d0bedb;--blue:#8152df;--bluehi:#b38aff;--pink:#f33474;--cream:#ffd15b;--teal:#ffd15b;background:radial-gradient(ellipse at 77% 7%,rgba(125,59,218,.34),transparent 35%),radial-gradient(ellipse at 14% 40%,rgba(231,27,104,.12),transparent 36%),linear-gradient(150deg,#090312 0%,#140a29 58%,#08040f 100%)}\n.brag:before{background:radial-gradient(ellipse at 74% 8%,rgba(125,59,218,.28),transparent 42%)}.pixel-frame{border-color:rgba(255,209,91,.3)}.site-header,.hero,.section{border-color:rgba(168,121,220,.35)}.brand-mark{background:#f33474}.portrait{border-color:#ffd15b;background:#170c29;box-shadow:5px 5px 0 #4a2177}.portrait:after{background:repeating-linear-gradient(0deg,rgba(9,3,18,.37) 0 1px,transparent 1px 4px)}\n.metrics{border-color:#654394;background:linear-gradient(90deg,rgba(35,16,64,.8),rgba(12,5,23,.65))}.metric+.metric{border-color:rgba(168,121,220,.38)}.metric:nth-child(3) .metric-value,.meta-value,.impact-stack,.mentor-label,.goal-status{color:#ffd15b}.epic-table-wrap,.goal-aside{border-color:#654394;background-color:rgba(27,16,48,.72)}.epic-table th,.epic-table td,.impact-row,.mentor-row{border-color:rgba(168,121,220,.32)}.epic-table tbody tr:hover{background:rgba(95,40,153,.23)}.architecture li:before{color:#f33474}.skill-group{border-color:var(--skill)}.skill-tags span{border-color:#654394;background:#1b1030;color:#eadcf2}\n</style>\n<div class=\"brag\" data-kid=\"1\" data-name=\"brag document wrapper\">\n    <div aria-hidden=\"true\" class=\"pixel-frame\" data-kid=\"1-1\" data-name=\"pixel frame decorative overlay\">\n    </div>\n    <div class=\"brag-shell\" data-kid=\"1-2\" data-name=\"brag main content shell\">\n        <header class=\"site-header\" data-kid=\"1-2-1\" data-name=\"site header navigation\">\n            <a aria-label=\"Sérgio Santos — início\" class=\"brand\" data-kid=\"1-2-1-1\" data-name=\"brand logo and name link\" href=\"https://sergingroisman.github.io/\">\n                <span aria-hidden=\"true\" class=\"brand-mark\" data-kid=\"1-2-1-1-1\" data-name=\"brand mark icon\">\n                </span>\n                <span data-kid=\"1-2-1-1-2\" data-name=\"brand name text\">\n                    Sérgio Santos\n                </span>\n            </a>\n            <nav aria-label=\"Navegação principal\" class=\"nav\" data-kid=\"1-2-1-2\" data-name=\"site navigation links\">\n                <a data-kid=\"1-2-1-2-1\" data-name=\"currículo page link\" href=\"https://sergingroisman.github.io/cv/\">\n                    Currículo\n                </a>\n                <a data-kid=\"1-2-1-2-2\" data-name=\"blog page link\" href=\"https://sergingroisman.github.io/blog/\">\n                    Blog\n                </a>\n                <a aria-current=\"page\" data-kid=\"1-2-1-2-3\" data-name=\"brag page link\" href=\"https://sergingroisman.github.io/brag/\">\n                    Brag\n                </a>\n            </nav>\n        </header>\n        <main data-kid=\"1-2-2\" data-name=\"main content section\">\n            <section aria-labelledby=\"brag-title\" class=\"hero\" data-kid=\"1-2-2-1\" data-name=\"hero section\">\n                <div class=\"hero-copy\" data-kid=\"1-2-2-1-1\" data-name=\"hero copy content\">\n                    <p class=\"hero-kicker\" data-kid=\"1-2-2-1-1-1\" data-name=\"hero kicker date label\">\n                        REGISTRO DE IMPACTO · 2026\n                    </p>\n                    <h1 data-kid=\"1-2-2-1-1-2\" data-name=\"main hero heading\" id=\"brag-title\">\n                        Brag\n                        <span data-kid=\"1-2-2-1-1-2-1\" data-name=\"hero heading sub-text\">\n                            Document\n                        </span>\n                    </h1>\n                    <p class=\"hero-lede\" data-kid=\"1-2-2-1-1-3\" data-name=\"hero lede description\">\n                        <strong data-kid=\"1-2-2-1-1-3-1\" data-name=\"hero owner name\">\n                            Sérgio Santos\n                        </strong>\n                        · Senior Software Engineer · Avanade\n                        <br data-kid=\"1-2-2-1-1-3-2\"/>\n                        Impacto mensurável, decisões técnicas e colaboração em projetos Afya e YDUQS.\n                    </p>\n                </div>\n                <figure class=\"portrait\" data-kid=\"1-2-2-1-2\" data-name=\"portrait figure container\">\n                    <img alt=\"Sérgio com óculos e cavanhaque apresentando um esquema dourado diante de torres violetas\" data-kid=\"1-2-2-1-2-1\" data-name=\"portrait image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/47f52d6f-9fa8-4279-9b10-47ca078387b4/151ce17827954aeb8f4843b8cac305d3.jpg\"/>\n                    <figcaption class=\"portrait-caption\" data-kid=\"1-2-2-1-2-2\" data-name=\"portrait caption\">\n                        SÉRGIO · AUTOR\n                    </figcaption>\n                </figure>\n            </section>\n            <div aria-label=\"Contexto e atualização\" class=\"meta-strip\" data-kid=\"1-2-2-2\" data-name=\"metadata context strip\">\n                <div class=\"meta-item\" data-kid=\"1-2-2-2-1\" data-name=\"company meta item\">\n                    <span class=\"meta-label\" data-kid=\"1-2-2-2-1-1\">\n                        Empresa\n                    </span>\n                    <span class=\"meta-value\" data-kid=\"1-2-2-2-1-2\">\n                        Avanade\n                    </span>\n                </div>\n                <div class=\"meta-item\" data-kid=\"1-2-2-2-2\" data-name=\"accounts meta item\">\n                    <span class=\"meta-label\" data-kid=\"1-2-2-2-2-1\">\n                        Contas\n                    </span>\n                    <span class=\"meta-value\" data-kid=\"1-2-2-2-2-2\">\n                        Afya · YDUQS\n                    </span>\n                </div>\n                <div class=\"meta-item\" data-kid=\"1-2-2-2-3\" data-name=\"project meta item\">\n                    <span class=\"meta-label\" data-kid=\"1-2-2-2-3-1\">\n                        Projeto\n                    </span>\n                    <span class=\"meta-value\" data-kid=\"1-2-2-2-3-2\">\n                        Campaign (PB)\n                    </span>\n                </div>\n                <div class=\"meta-item\" data-kid=\"1-2-2-2-4\" data-name=\"last updated meta item\">\n                    <span class=\"meta-label\" data-kid=\"1-2-2-2-4-1\">\n                        Atualizado\n                    </span>\n                    <span class=\"meta-value\" data-kid=\"1-2-2-2-4-2\">\n                        02 / Out / 2026\n                    </span>\n                </div>\n            </div>\n            <section aria-labelledby=\"metrics-heading\" class=\"section\" data-kid=\"1-2-2-3\" data-name=\"metrics section\">\n                <h2 class=\"section-heading\" data-kid=\"1-2-2-3-1\" data-name=\"metrics section heading\" id=\"metrics-heading\">\n                    Métricas do Projeto Campaign\n                </h2>\n                <p class=\"section-intro\" data-kid=\"1-2-2-3-2\">\n                    Registros concluídos no Jira para o projeto Campaign (pref. PB).\n                </p>\n                <div class=\"metrics\" data-kid=\"1-2-2-3-3\" data-name=\"metrics grid container\">\n                    <div class=\"metric\" data-kid=\"1-2-2-3-3-1\" data-name=\"cards done metric\">\n                        <span class=\"metric-value\" data-kid=\"1-2-2-3-3-1-1\">\n                            95\n                        </span>\n                        <span class=\"metric-label\" data-kid=\"1-2-2-3-3-1-2\">\n                            cards marcados como Done\n                        </span>\n                    </div>\n                    <div class=\"metric\" data-kid=\"1-2-2-3-3-2\" data-name=\"hours registered metric\">\n                        <span class=\"metric-value\" data-kid=\"1-2-2-3-3-2-1\">\n                            180,3h\n                        </span>\n                        <span class=\"metric-label\" data-kid=\"1-2-2-3-3-2-2\">\n                            horas registradas no projeto\n                        </span>\n                    </div>\n                    <div class=\"metric\" data-kid=\"1-2-2-3-3-3\" data-name=\"epics concluded metric\">\n                        <span class=\"metric-value\" data-kid=\"1-2-2-3-3-3-1\">\n                            5\n                        </span>\n                        <span class=\"metric-label\" data-kid=\"1-2-2-3-3-3-2\">\n                            épicos com entregas concluídas\n                        </span>\n                    </div>\n                </div>\n                <p class=\"metric-source\" data-kid=\"1-2-2-3-4\" data-name=\"metrics source note\">\n                    <strong data-kid=\"1-2-2-3-4-1\">\n                        Fonte:\n                    </strong>\n                    Jira, projeto Campaign (pref. PB), apurado em 02/Out/2026. Os números acima refletem apenas os cards atribuídos a Sérgio e marcados como Done.\n                </p>\n            </section>\n            <section aria-labelledby=\"epics-heading\" class=\"section\" data-kid=\"1-2-2-4\" data-name=\"epics distribution section\">\n                <h2 class=\"section-heading\" data-kid=\"1-2-2-4-1\" data-name=\"epics distribution heading\" id=\"epics-heading\">\n                    Distribuição por Épico\n                </h2>\n                <p class=\"section-intro\" data-kid=\"1-2-2-4-2\">\n                    Valores publicados para os épicos listados abaixo; este recorte não deve ser somado para inferir os totais gerais apresentados acima.\n                </p>\n                <div class=\"epic-table-wrap\" data-kid=\"1-2-2-4-3\" data-name=\"epics table wrapper\">\n                    <table class=\"epic-table\" data-kid=\"1-2-2-4-3-1\" data-name=\"epics data table\">\n                        <thead data-kid=\"1-2-2-4-3-1-1\" data-name=\"table header\">\n                            <tr data-kid=\"1-2-2-4-3-1-1-1\">\n                                <th data-kid=\"1-2-2-4-3-1-1-1-1\" scope=\"col\">\n                                    Épico\n                                </th>\n                                <th data-kid=\"1-2-2-4-3-1-1-1-2\" scope=\"col\">\n                                    Descrição\n                                </th>\n                                <th data-kid=\"1-2-2-4-3-1-1-1-3\" scope=\"col\">\n                                    Cards Done\n                                </th>\n                                <th data-kid=\"1-2-2-4-3-1-1-1-4\" scope=\"col\">\n                                    Horas\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody data-kid=\"1-2-2-4-3-1-2\">\n                            <tr data-kid=\"1-2-2-4-3-1-2-1\">\n                                <td class=\"epic-id\" data-kid=\"1-2-2-4-3-1-2-1-1\">\n                                    PB-8836\n                                </td>\n                                <td data-kid=\"1-2-2-4-3-1-2-1-2\">\n                                    <strong data-kid=\"1-2-2-4-3-1-2-1-2-1\">\n                                        Sync GAM\n                                    </strong>\n                                    — integração e sincronização com Google Ad Manager\n                                </td>\n                                <td class=\"epic-num\" data-kid=\"1-2-2-4-3-1-2-1-3\">\n                                    12\n                                </td>\n                                <td class=\"epic-num\" data-kid=\"1-2-2-4-3-1-2-1-4\">\n                                    45,4h\n                                </td>\n                            </tr>\n                            <tr data-kid=\"1-2-2-4-3-1-2-2\">\n                                <td class=\"epic-id\" data-kid=\"1-2-2-4-3-1-2-2-1\">\n                                    PB-8925\n                                </td>\n                                <td data-kid=\"1-2-2-4-3-1-2-2-2\">\n                                    Entregas do épico PB-8925\n                                </td>\n                                <td class=\"epic-num\" data-kid=\"1-2-2-4-3-1-2-2-3\">\n                                    29\n                                </td>\n                                <td class=\"epic-num\" data-kid=\"1-2-2-4-3-1-2-2-4\">\n                                    38,7h\n                                </td>\n                            </tr>\n                            <tr data-kid=\"1-2-2-4-3-1-2-3\">\n                                <td class=\"epic-id\" data-kid=\"1-2-2-4-3-1-2-3-1\">\n                                    PB-9819\n                                </td>\n                                <td data-kid=\"1-2-2-4-3-1-2-3-2\">\n                                    Entregas do épico PB-9819\n                                </td>\n                                <td class=\"epic-num\" data-kid=\"1-2-2-4-3-1-2-3-3\">\n                                    9\n                                </td>\n                                <td class=\"epic-num\" data-kid=\"1-2-2-4-3-1-2-3-4\">\n                                    20,0h\n                                </td>\n                            </tr>\n                            <tr data-kid=\"1-2-2-4-3-1-2-4\">\n                                <td class=\"epic-id\" data-kid=\"1-2-2-4-3-1-2-4-1\">\n                                    PB-8926\n                                </td>\n                                <td data-kid=\"1-2-2-4-3-1-2-4-2\">\n                                    Entregas do épico PB-8926\n                                </td>\n                                <td class=\"epic-num\" data-kid=\"1-2-2-4-3-1-2-4-3\">\n                                    11\n                                </td>\n                                <td class=\"epic-num\" data-kid=\"1-2-2-4-3-1-2-4-4\">\n                                    19,5h\n                                </td>\n                            </tr>\n                            <tr data-kid=\"1-2-2-4-3-1-2-5\">\n                                <td class=\"epic-id\" data-kid=\"1-2-2-4-3-1-2-5-1\">\n                                    PB-10660\n                                </td>\n                                <td data-kid=\"1-2-2-4-3-1-2-5-2\">\n                                    Entregas do épico PB-10660\n                                </td>\n                                <td class=\"epic-num\" data-kid=\"1-2-2-4-3-1-2-5-3\">\n                                    2\n                                </td>\n                                <td class=\"epic-num\" data-kid=\"1-2-2-4-3-1-2-5-4\">\n                                    12,2h\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n            </section>\n            <section aria-labelledby=\"impact-heading\" class=\"section\" data-kid=\"1-2-2-5\" data-name=\"impact projects section\">\n                <h2 class=\"section-heading\" data-kid=\"1-2-2-5-1\" data-name=\"impact projects section heading\" id=\"impact-heading\">\n                    Projetos com Impacto Mensurável\n                </h2>\n                <div class=\"impact-list\" data-kid=\"1-2-2-5-2\" data-name=\"impact projects list\">\n                    <article class=\"impact-row\" data-kid=\"1-2-2-5-2-1\" data-name=\"afya campaign project row\">\n                        <div class=\"impact-period\" data-kid=\"1-2-2-5-2-1-1\">\n                            Mar 2021 — hoje\n                        </div>\n                        <div data-kid=\"1-2-2-5-2-1-2\">\n                            <h3 class=\"impact-title\" data-kid=\"1-2-2-5-2-1-2-1\">\n                                Afya · Campaign\n                            </h3>\n                            <span class=\"impact-stack\" data-kid=\"1-2-2-5-2-1-2-2\">\n                                NestJS · Keycloak · Kubernetes\n                            </span>\n                        </div>\n                        <p class=\"impact-copy\" data-kid=\"1-2-2-5-2-1-3\">\n                            Liderei dois projetos simultâneos como tech lead interino; implementei Keycloak ponta a ponta, CI/CD e infraestrutura Kubernetes.\n                            <strong data-kid=\"1-2-2-5-2-1-3-1\">\n                                95 cards Done e 180,3h\n                            </strong>\n                            registrados no Jira; migração de escalabilidade sem downtime.\n                        </p>\n                    </article>\n                    <article class=\"impact-row\" data-kid=\"1-2-2-5-2-2\">\n                        <div class=\"impact-period\" data-kid=\"1-2-2-5-2-2-1\">\n                            2021 — 2022\n                        </div>\n                        <div data-kid=\"1-2-2-5-2-2-2\">\n                            <h3 class=\"impact-title\" data-kid=\"1-2-2-5-2-2-2-1\">\n                                Afya · OneSignal\n                            </h3>\n                            <span class=\"impact-stack\" data-kid=\"1-2-2-5-2-2-2-2\">\n                                Next.js · Go · RabbitMQ\n                            </span>\n                        </div>\n                        <p class=\"impact-copy\" data-kid=\"1-2-2-5-2-2-3\">\n                            Desbloqueei uma integração OneSignal que o time anterior não conseguiu entregar e implementei RabbitMQ + Go. Notificações entregues no prazo.\n                        </p>\n                    </article>\n                    <article class=\"impact-row\" data-kid=\"1-2-2-5-2-3\">\n                        <div class=\"impact-period\" data-kid=\"1-2-2-5-2-3-1\">\n                            2019 — 2021\n                        </div>\n                        <div data-kid=\"1-2-2-5-2-3-2\">\n                            <h3 class=\"impact-title\" data-kid=\"1-2-2-5-2-3-2-1\">\n                                YDUQS / Estácio\n                            </h3>\n                            <span class=\"impact-stack\" data-kid=\"1-2-2-5-2-3-2-2\">\n                                React Native · Node.js\n                            </span>\n                        </div>\n                        <p class=\"impact-copy\" data-kid=\"1-2-2-5-2-3-3\">\n                            Refatorei e publiquei uma versão do aplicativo em tempo reduzido e mentorei o backend em JavaScript avançado. A base foi utilizada por mais de dois anos no maior grupo de educação do Brasil.\n                        </p>\n                    </article>\n                    <article class=\"impact-row\" data-kid=\"1-2-2-5-2-4\">\n                        <div class=\"impact-period\" data-kid=\"1-2-2-5-2-4-1\">\n                            2025\n                        </div>\n                        <div data-kid=\"1-2-2-5-2-4-2\">\n                            <h3 class=\"impact-title\" data-kid=\"1-2-2-5-2-4-2-1\">\n                                Afya · POC de chatbot IA\n                            </h3>\n                            <span class=\"impact-stack\" data-kid=\"1-2-2-5-2-4-2-2\">\n                                GPT · LangChain · RAG\n                            </span>\n                        </div>\n                        <p class=\"impact-copy\" data-kid=\"1-2-2-5-2-4-3\">\n                            Projetei e desenvolvi do zero uma POC de chatbot para o domínio farmacêutico, entregue\n                            <strong data-kid=\"1-2-2-5-2-4-3-1\">\n                                uma semana antes do prazo\n                            </strong>\n                            .\n                        </p>\n                    </article>\n                </div>\n            </section>\n            <section aria-labelledby=\"architecture-heading\" class=\"section\" data-kid=\"1-2-2-6\" data-name=\"architecture section\">\n                <h2 class=\"section-heading\" data-kid=\"1-2-2-6-1\" data-name=\"architecture section heading\" id=\"architecture-heading\">\n                    Liderança Técnica e Arquitetura\n                </h2>\n                <ul class=\"architecture\" data-kid=\"1-2-2-6-2\" data-name=\"architecture list\">\n                    <li data-kid=\"1-2-2-6-2-1\">\n                        <strong data-kid=\"1-2-2-6-2-1-1\">\n                            Serverless → NestJS:\n                        </strong>\n                        migração com arquitetura Hexagonal + DDD, sem interrupção, com mentoria ao time.\n                    </li>\n                    <li data-kid=\"1-2-2-6-2-2\">\n                        <strong data-kid=\"1-2-2-6-2-2-1\">\n                            ElasticBeanstalk → Kubernetes:\n                        </strong>\n                        coordenação com SRE usando ArgoCD e Grafana para ampliar observabilidade e resiliência.\n                    </li>\n                    <li data-kid=\"1-2-2-6-2-3\">\n                        <strong data-kid=\"1-2-2-6-2-3-1\">\n                            Keycloak:\n                        </strong>\n                        autenticação JWT/OAuth2/OIDC ponta a ponta com permissões granulares.\n                    </li>\n                    <li data-kid=\"1-2-2-6-2-4\">\n                        <strong data-kid=\"1-2-2-6-2-4-1\">\n                            Mensageria event-driven:\n                        </strong>\n                        SNS/SQS + RabbitMQ, DLQ, retries com backoff e idempotência.\n                    </li>\n                    <li data-kid=\"1-2-2-6-2-5\">\n                        <strong data-kid=\"1-2-2-6-2-5-1\">\n                            Pacote NPM GLIC:\n                        </strong>\n                        cliente Google Ad Manager e schemas CloudEvents 1.0 reutilizáveis entre serviços.\n                    </li>\n                    <li data-kid=\"1-2-2-6-2-6\">\n                        <strong data-kid=\"1-2-2-6-2-6-1\">\n                            CI/CD:\n                        </strong>\n                        pipelines GitHub Actions do zero, com mais de 1.000 testes Jest executados em CI.\n                    </li>\n                    <li data-kid=\"1-2-2-6-2-7\">\n                        <strong data-kid=\"1-2-2-6-2-7-1\">\n                            POC de chatbot + RAG:\n                        </strong>\n                        GPT e LangChain para o lançamento de medicamento; entregue uma semana antes do prazo.\n                    </li>\n                </ul>\n            </section>\n            <section aria-labelledby=\"mentor-heading\" class=\"section\" data-kid=\"1-2-2-7\" data-name=\"mentoring section\">\n                <h2 class=\"section-heading\" data-kid=\"1-2-2-7-1\" data-name=\"mentoring section heading\" id=\"mentor-heading\">\n                    Colaboração e Mentoria\n                </h2>\n                <div class=\"mentor-list\" data-kid=\"1-2-2-7-2\" data-name=\"mentoring list\">\n                    <div class=\"mentor-row\" data-kid=\"1-2-2-7-2-1\">\n                        <div class=\"mentor-name\" data-kid=\"1-2-2-7-2-1-1\">\n                            Time Afya Backend\n                        </div>\n                        <div class=\"mentor-cell\" data-kid=\"1-2-2-7-2-1-2\">\n                            <span class=\"mentor-label\" data-kid=\"1-2-2-7-2-1-2-1\">\n                                Como ajudei\n                            </span>\n                            Mentoria na migração Serverless → NestJS.\n                        </div>\n                        <div class=\"mentor-cell\" data-kid=\"1-2-2-7-2-1-3\">\n                            <span class=\"mentor-label\" data-kid=\"1-2-2-7-2-1-3-1\">\n                                Resultado\n                            </span>\n                            Escalabilidade desbloqueada; time autônomo na nova arquitetura.\n                        </div>\n                    </div>\n                    <div class=\"mentor-row\" data-kid=\"1-2-2-7-2-2\">\n                        <div class=\"mentor-name\" data-kid=\"1-2-2-7-2-2-1\">\n                            Time Afya Infra\n                        </div>\n                        <div class=\"mentor-cell\" data-kid=\"1-2-2-7-2-2-2\">\n                            <span class=\"mentor-label\" data-kid=\"1-2-2-7-2-2-2-1\">\n                                Como ajudei\n                            </span>\n                            Coordenação da migração ElasticBeanstalk → Kubernetes com SRE.\n                        </div>\n                        <div class=\"mentor-cell\" data-kid=\"1-2-2-7-2-2-3\">\n                            <span class=\"mentor-label\" data-kid=\"1-2-2-7-2-2-3-1\">\n                                Resultado\n                            </span>\n                            Mais observabilidade e resiliência na infraestrutura.\n                        </div>\n                    </div>\n                    <div class=\"mentor-row\" data-kid=\"1-2-2-7-2-3\">\n                        <div class=\"mentor-name\" data-kid=\"1-2-2-7-2-3-1\">\n                            Inglide\n                        </div>\n                        <div class=\"mentor-cell\" data-kid=\"1-2-2-7-2-3-2\">\n                            <span class=\"mentor-label\" data-kid=\"1-2-2-7-2-3-2-1\">\n                                Como ajudei\n                            </span>\n                            Decisões de arquitetura de backend.\n                        </div>\n                        <div class=\"mentor-cell\" data-kid=\"1-2-2-7-2-3-3\">\n                            <span class=\"mentor-label\" data-kid=\"1-2-2-7-2-3-3-1\">\n                                Resultado\n                            </span>\n                            Módulo enterprise de Config/Envs com NestJS.\n                        </div>\n                    </div>\n                    <div class=\"mentor-row\" data-kid=\"1-2-2-7-2-4\">\n                        <div class=\"mentor-name\" data-kid=\"1-2-2-7-2-4-1\">\n                            Felipe Gasparotto\n                        </div>\n                        <div class=\"mentor-cell\" data-kid=\"1-2-2-7-2-4-2\">\n                            <span class=\"mentor-label\" data-kid=\"1-2-2-7-2-4-2-1\">\n                                Como ajudei\n                            </span>\n                            Docker, docker-compose e LocalStack para simular AWS S3 localmente.\n                        </div>\n                        <div class=\"mentor-cell\" data-kid=\"1-2-2-7-2-4-3\">\n                            <span class=\"mentor-label\" data-kid=\"1-2-2-7-2-4-3-1\">\n                                Resultado\n                            </span>\n                            Upload S3 implementado sem aguardar ambiente AWS de QA provisionado.\n                        </div>\n                    </div>\n                    <div class=\"mentor-row\" data-kid=\"1-2-2-7-2-5\">\n                        <div class=\"mentor-name\" data-kid=\"1-2-2-7-2-5-1\">\n                            Time YDUQS\n                        </div>\n                        <div class=\"mentor-cell\" data-kid=\"1-2-2-7-2-5-2\">\n                            <span class=\"mentor-label\" data-kid=\"1-2-2-7-2-5-2-1\">\n                                Como ajudei\n                            </span>\n                            Mentoria de JavaScript avançado em missão presencial no Rio.\n                        </div>\n                        <div class=\"mentor-cell\" data-kid=\"1-2-2-7-2-5-3\">\n                            <span class=\"mentor-label\" data-kid=\"1-2-2-7-2-5-3-1\">\n                                Resultado\n                            </span>\n                            Qualidade e velocidade de entrega mantidas com time reduzido.\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <section aria-labelledby=\"skills-heading\" class=\"section\" data-kid=\"1-2-2-8\" data-name=\"skills section\">\n                <h2 class=\"section-heading\" data-kid=\"1-2-2-8-1\" data-name=\"skills section heading\" id=\"skills-heading\">\n                    Stack por Nível de Proficiência\n                </h2>\n                <div class=\"skills\" data-kid=\"1-2-2-8-2\" data-name=\"skills grid\">\n                    <div class=\"skill-group\" data-kid=\"1-2-2-8-2-1\" style=\"--skill:#71a6a1\">\n                        <h3 data-kid=\"1-2-2-8-2-1-1\">\n                            Especialidade\n                        </h3>\n                        <p data-kid=\"1-2-2-8-2-1-2\">\n                            Uso em produção e mentoria.\n                        </p>\n                        <div class=\"skill-tags\" data-kid=\"1-2-2-8-2-1-3\">\n                            <span data-kid=\"1-2-2-8-2-1-3-1\">\n                                NestJS\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-1-3-2\">\n                                Node.js\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-1-3-3\">\n                                TypeScript\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-1-3-4\">\n                                Arquitetura Hexagonal\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-1-3-5\">\n                                DDD\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-1-3-6\">\n                                AWS\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-1-3-7\">\n                                Docker\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-1-3-8\">\n                                GitHub Actions\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"skill-group\" data-kid=\"1-2-2-8-2-2\" style=\"--skill:#e2d7b5\">\n                        <h3 data-kid=\"1-2-2-8-2-2-1\">\n                            Proficiente\n                        </h3>\n                        <p data-kid=\"1-2-2-8-2-2-2\">\n                            Experiência em projetos reais.\n                        </p>\n                        <div class=\"skill-tags\" data-kid=\"1-2-2-8-2-2-3\">\n                            <span data-kid=\"1-2-2-8-2-2-3-1\">\n                                Go\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-2-3-2\">\n                                RabbitMQ\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-2-3-3\">\n                                SNS/SQS\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-2-3-4\">\n                                Keycloak\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-2-3-5\">\n                                Kubernetes\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-2-3-6\">\n                                Terraform\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-2-3-7\">\n                                ArgoCD\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-2-3-8\">\n                                Grafana\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-2-3-9\">\n                                Next.js 15\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-2-3-10\">\n                                PostgreSQL\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-2-3-11\">\n                                MongoDB\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-2-3-12\">\n                                Redis\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-2-3-13\">\n                                TDD\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"skill-group\" data-kid=\"1-2-2-8-2-3\" style=\"--skill:#cf3c71\">\n                        <h3 data-kid=\"1-2-2-8-2-3-1\">\n                            Conhecimento\n                        </h3>\n                        <p data-kid=\"1-2-2-8-2-3-2\">\n                            Uso pontual.\n                        </p>\n                        <div class=\"skill-tags\" data-kid=\"1-2-2-8-2-3-3\">\n                            <span data-kid=\"1-2-2-8-2-3-3-1\">\n                                LangChain\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-3-3-2\">\n                                OpenAI API\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-3-3-3\">\n                                RAG\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-3-3-4\">\n                                Qdrant\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-3-3-5\">\n                                MCP\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-3-3-6\">\n                                Serverless Framework\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-3-3-7\">\n                                ElasticBeanstalk\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-3-3-8\">\n                                React\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-3-3-9\">\n                                React Native\n                            </span>\n                            <span data-kid=\"1-2-2-8-2-3-3-10\">\n                                Ruby on Rails\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <section aria-labelledby=\"goals-heading\" class=\"section\" data-kid=\"1-2-2-9\" data-name=\"goals section\">\n                <h2 class=\"section-heading\" data-kid=\"1-2-2-9-1\" data-name=\"goals section heading\" id=\"goals-heading\">\n                    Objetivos\n                </h2>\n                <div class=\"goals\" data-kid=\"1-2-2-9-2\" data-name=\"goals content container\">\n                    <ul class=\"goal-list\" data-kid=\"1-2-2-9-2-1\">\n                        <li data-kid=\"1-2-2-9-2-1-1\">\n                            Certificação Microsoft\n                            <strong data-kid=\"1-2-2-9-2-1-1-1\">\n                                AZ-900\n                            </strong>\n                            —\n                            <span class=\"goal-status\" data-kid=\"1-2-2-9-2-1-1-2\">\n                                em andamento · voucher 100% Avanade\n                            </span>\n                        </li>\n                        <li data-kid=\"1-2-2-9-2-1-2\">\n                            Evoluir para a certificação\n                            <strong data-kid=\"1-2-2-9-2-1-2-1\">\n                                Microsoft AZ-204\n                            </strong>\n                            .\n                        </li>\n                        <li data-kid=\"1-2-2-9-2-1-3\">\n                            Lançar o blog técnico e construir presença pública —\n                            <strong data-kid=\"1-2-2-9-2-1-3-1\">\n                                primeira versão no ar\n                            </strong>\n                            .\n                        </li>\n                        <li data-kid=\"1-2-2-9-2-1-4\">\n                            <strong data-kid=\"1-2-2-9-2-1-4-1\">\n                                Contribuir com open source.\n                            </strong>\n                        </li>\n                        <li data-kid=\"1-2-2-9-2-1-5\">\n                            Evoluir para\n                            <strong data-kid=\"1-2-2-9-2-1-5-1\">\n                                dev sênior/arquiteto\n                            </strong>\n                            na Avanade.\n                        </li>\n                    </ul>\n                    <aside class=\"goal-aside\" data-kid=\"1-2-2-9-2-2\" data-name=\"goals aside note\">\n                        Registro profissional baseado em entregas documentadas. Números do projeto Campaign vinculados ao\n                        <strong data-kid=\"1-2-2-9-2-2-1\">\n                            Jira\n                        </strong>\n                        , conforme o recorte e a data indicados.\n                    </aside>\n                </div>\n            </section>\n        </main>\n        <footer class=\"footer\" data-kid=\"1-2-3\" data-name=\"footer section\">\n            <span data-kid=\"1-2-3-1\" data-name=\"footer copyright text\">\n                © Sérgio Santos · Recife/PE, Brasil\n            </span>\n            <nav aria-label=\"Navegação do rodapé\" class=\"footer-links\" data-kid=\"1-2-3-2\" data-name=\"footer navigation links\">\n                <a data-kid=\"1-2-3-2-1\" href=\"https://sergingroisman.github.io/\">\n                    ← hub\n                </a>\n                <span class=\"dot\" data-kid=\"1-2-3-2-2\">\n                    ·\n                </span>\n                <a data-kid=\"1-2-3-2-3\" href=\"https://sergingroisman.github.io/cv/\">\n                    Currículo\n                </a>\n                <span class=\"dot\" data-kid=\"1-2-3-2-4\">\n                    ·\n                </span>\n                <a data-kid=\"1-2-3-2-5\" href=\"https://sergingroisman.github.io/blog/\">\n                    Blog\n                </a>\n                <span class=\"dot\" data-kid=\"1-2-3-2-6\">\n                    ·\n                </span>\n                <a data-kid=\"1-2-3-2-7\" href=\"https://sergingroisman.github.io/brag/\">\n                    Brag\n                </a>\n            </nav>\n        </footer>\n    </div>\n</div>\n",
